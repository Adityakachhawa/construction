---
import { categories } from '../../data/categories';
import { getCollection } from 'astro:content';

// Only link /guides/ once at least one non-draft guide exists, so we never
// surface an empty "coming soon" section to crawlers or users.
const publishedGuides = await getCollection('guides', ({ data }) => !data.draft);
const hasGuides = publishedGuides.length > 0;
---

<footer class="site-footer">
  <!-- Top accent line -->
  <div class="footer-accent"></div>

  <div class="footer-inner">
    <!-- Brand column -->
    <div class="footer-brand">
      <a href="/" class="footer-logo" aria-label="ConstructCalc Home">
        <svg width="26" height="26" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="2" y="14" width="7" height="12" rx="1.5" fill="var(--color-primary)"/>
          <rect x="10.5" y="8" width="7" height="18" rx="1.5" fill="var(--color-primary)" opacity="0.75"/>
          <rect x="19" y="2" width="7" height="24" rx="1.5" fill="var(--color-primary)" opacity="0.5"/>
        </svg>
        <span>ConstructCalc</span>
      </a>
      <p class="footer-tagline">
        Accurate material estimates for construction professionals and serious DIYers.
      </p>
    </div>

    <!-- Calculators column -->
    <div class="footer-col">
      <h3 class="footer-col-heading">Calculators</h3>
      <ul class="footer-links">
        {categories.map(cat => (
          <li>
            <a href={`/category/${cat.slug}/`} class="footer-link">{cat.name}</a>
          </li>
        ))}
        <li>
          <a href="/calculators/" class="footer-link">All Calculators</a>
        </li>
      </ul>
    </div>

    <!-- Resources column -->
    <div class="footer-col">
      <h3 class="footer-col-heading">Resources</h3>
      <ul class="footer-links">
        <li><a href="/blog/" class="footer-link">Blog</a></li>
        {hasGuides && <li><a href="/guides/" class="footer-link">Guides</a></li>}
        <li><a href="/methodology/" class="footer-link">Methodology</a></li>
      </ul>
    </div>

    <!-- Company column -->
    <div class="footer-col">
      <h3 class="footer-col-heading">Company</h3>
      <ul class="footer-links">
        <li><a href="/about/" class="footer-link">About</a></li>
        <li><a href="/privacy/" class="footer-link">Privacy</a></li>
        <li><a href="/contact/" class="footer-link">Contact</a></li>
      </ul>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <p class="footer-copy">&copy; {new Date().getFullYear()} ConstructCalc. All rights reserved.</p>
    <p class="footer-disclaimer">Results are estimates. Always verify with a licensed professional.</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--ink-dim);
    margin-top: 6rem;
  }

  .footer-accent {
    height: 3px;
    background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-primary-400) 100%);
  }

  .footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 4rem 1.5rem 3rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }

  @media (min-width: 640px) {
    .footer-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .footer-inner {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 4rem;
    }
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.02em;
    margin-bottom: 0.875rem;
    transition: opacity 150ms;
  }
  .footer-logo:hover { opacity: 0.8; }

  .footer-tagline {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-dim);
    max-width: 24rem;
  }

  .footer-col-heading {
    font-size: 0.8125rem;
    font-weight: 600;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 1rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: #a1a1aa;
    transition: color 150ms;
  }
  .footer-link:hover { color: #fff; }

  .footer-bottom {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 2rem;
    border-top: 1px solid var(--ink-border);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .footer-bottom {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .footer-copy {
    font-size: 0.75rem;
    color: #8b8b93;
  }

  .footer-disclaimer {
    font-size: 0.75rem;
    color: #8b8b93;
    font-style: italic;
  }
</style>
