---
import { categories } from '../../data/categories';

interface Props {
  currentPath?: string;
}

const { currentPath = '' } = Astro.props;

const navLinks = [
  { href: '/calculators/', label: 'All Calculators' },
  { href: '/blog/', label: 'Blog' },
  { href: '/guides/', label: 'Guides' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-[var(--color-border)]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-14">

      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 font-bold text-[var(--color-text-primary)] hover:text-[var(--color-primary)] transition-colors" aria-label="ConstructCalc Home">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="2" y="14" width="6" height="8" rx="1" fill="var(--color-primary)" />
          <rect x="9" y="8" width="6" height="14" rx="1" fill="var(--color-primary)" opacity="0.75" />
          <rect x="16" y="2" width="6" height="20" rx="1" fill="var(--color-primary)" opacity="0.5" />
        </svg>
        <span class="text-base">ConstructCalc</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={[
              'px-3 py-1.5 text-sm font-medium rounded-lg transition-colors',
              currentPath.startsWith(link.href)
                ? 'text-[var(--color-primary)] bg-[var(--color-primary-50)]'
                : 'text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-100)]',
            ].join(' ')}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile menu button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="md:hidden p-2 rounded-lg text-[var(--color-text-secondary)] hover:bg-[var(--color-neutral-100)] transition-colors"
      >
        <svg id="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M3 5h14a1 1 0 010 2H3a1 1 0 010-2zm0 4h14a1 1 0 010 2H3a1 1 0 010-2zm0 4h14a1 1 0 010 2H3a1 1 0 010-2z" clip-rule="evenodd"/>
        </svg>
        <svg id="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="hidden">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>

    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--color-border)] bg-white">
    <div class="max-w-6xl mx-auto px-4 py-3 flex flex-col gap-1">
      {navLinks.map(link => (
        <a
          href={link.href}
          class="px-3 py-2 text-sm font-medium rounded-lg text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-100)] transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="mt-2 pt-2 border-t border-[var(--color-border)]">
        <p class="px-3 py-1 text-xs font-semibold text-[var(--color-text-muted)] uppercase tracking-wide">Categories</p>
        {categories.slice(0, 6).map(cat => (
          <a
            href={`/category/${cat.slug}/`}
            class="px-3 py-2 text-sm text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] hover:bg-[var(--color-neutral-100)] rounded-lg block transition-colors"
          >
            {cat.name}
          </a>
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen?.classList.toggle('hidden', isOpen);
    iconClose?.classList.toggle('hidden', !isOpen);
  });
</script>
