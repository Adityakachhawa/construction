---
import { categories } from '../../data/categories';
import { calculatorRegistry, getFeaturedCalculators } from '../../data/registry';

interface Props {
  currentPath?: string;
  heroPage?: boolean;
}

const { currentPath = '', heroPage = false } = Astro.props;

const featuredCalcs = getFeaturedCalculators(6);
const totalCalcs = calculatorRegistry.length;

const isOnCalculators = currentPath.startsWith('/calculators/');
const isOnCategories  = currentPath.startsWith('/category/');
const isOnBlog        = currentPath.startsWith('/blog/');

const searchIndex = calculatorRegistry.map(c => ({
  slug: c.slug,
  name: c.name,
  description: c.description,
}));
---

<!-- Scroll progress bar (fixed, above everything) -->
<div id="scroll-progress" aria-hidden="true"></div>

<header class="site-header" role="banner" data-hero={heroPage ? '' : undefined}>
  <div class="header-inner">

    <!-- Logo -->
    <a href="/" class="logo" aria-label="BuildByMath Home">
      <img
        class="logo-img"
        src="/logo-horizontal-dark.png"
        alt="BuildByMath"
        width="200"
        height="50"
        loading="eager"
        decoding="async"
      />
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav" aria-label="Main navigation">

      <!-- Calculators dropdown -->
      <div class="nav-dropdown-wrap" data-dropdown="calculators">
        <button
          class={['nav-link nav-link--toggle', isOnCalculators ? 'nav-link--active' : ''].join(' ')}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="dd-calculators"
          type="button"
        >
          Calculators
          <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="nav-dropdown" id="dd-calculators" role="menu">
          <div class="dropdown-grid">
            {featuredCalcs.map(calc => (
              <a href={`/calculators/${calc.slug}/`} class="dropdown-item" role="menuitem">
                <strong class="dropdown-item-name">{calc.name}</strong>
                <span class="dropdown-item-desc">{calc.description}</span>
              </a>
            ))}
          </div>
          <div class="dropdown-footer">
            <a href="/calculators/" class="dropdown-footer-link">
              View all {totalCalcs} calculators
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2.5 6h7M6.5 3l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Categories dropdown -->
      <div class="nav-dropdown-wrap" data-dropdown="categories">
        <button
          class={['nav-link nav-link--toggle', isOnCategories ? 'nav-link--active' : ''].join(' ')}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="dd-categories"
          type="button"
        >
          Categories
          <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="nav-dropdown nav-dropdown--cats" id="dd-categories" role="menu">
          <div class="dropdown-cats">
            {categories.map(cat => (
              <a
                href={`/category/${cat.slug}/`}
                class="dropdown-cat"
                role="menuitem"
                style={`--accent: ${cat.color}`}
              >
                {cat.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Blog link -->
      <a
        href="/blog/"
        class={['nav-link', isOnBlog ? 'nav-link--active' : ''].join(' ')}
      >Blog</a>

    </nav>

    <!-- Desktop search -->
    <div class="header-search" data-search-root>
      <div class="header-search-box">
        <svg class="header-search-icon" width="15" height="15" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.6"/>
          <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          placeholder="Search calculators…"
          class="header-search-input"
          autocomplete="off"
          aria-label="Search calculators"
          role="combobox"
          aria-expanded="false"
          aria-controls="header-search-results"
          aria-autocomplete="list"
        />
        <kbd class="search-kbd" aria-hidden="true">⌘K</kbd>
      </div>
      <div id="header-search-results" class="header-search-results" role="listbox" aria-label="Search results"></div>
    </div>

    <!-- Desktop CTA -->
    <a href="/calculators/" class="header-cta" aria-label="Browse all calculators">
      Browse Calculators
      <svg width="13" height="13" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-overlay"
      class="mobile-toggle"
    >
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
      <span class="burger-bar"></span>
    </button>
  </div>
</header>

<!-- Mobile backdrop -->
<div id="mobile-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

<!-- Mobile bottom sheet -->
<div id="mobile-overlay" class="mobile-overlay" aria-hidden="true">
  <div class="mobile-handle" aria-hidden="true"></div>

  <div class="mobile-overlay-inner">
    <div class="mobile-overlay-header">
      <a href="/" class="logo" aria-label="BuildByMath Home">
        <img
          class="logo-img"
          src="/logo-horizontal-dark.png"
          alt="BuildByMath"
          width="160"
          height="40"
          loading="eager"
          decoding="async"
        />
      </a>
      <button id="mobile-close" type="button" aria-label="Close navigation" class="mobile-close">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/>
        </svg>
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="/calculators/" class={['mobile-nav-link', isOnCalculators ? 'mobile-nav-link--active' : ''].join(' ')}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
          <rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
          <rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
          <rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
        </svg>
        Calculators
      </a>
      <a href="/blog/" class={['mobile-nav-link', isOnBlog ? 'mobile-nav-link--active' : ''].join(' ')}>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <rect x="2" y="2" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.5"/>
          <path d="M5 6h6M5 9h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Blog
      </a>
      <a href="/methodology/" class="mobile-nav-link">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/>
          <path d="M8 5v3.5l2 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        Methodology
      </a>
    </nav>

    <!-- Mobile search -->
    <div class="mobile-search" data-search-root>
      <div class="mobile-search-box">
        <svg class="header-search-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.6"/>
          <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          placeholder="Search calculators…"
          class="header-search-input"
          autocomplete="off"
          aria-label="Search calculators"
          role="combobox"
          aria-expanded="false"
          aria-controls="mobile-search-results"
          aria-autocomplete="list"
        />
      </div>
      <div id="mobile-search-results" class="mobile-search-results" role="listbox" aria-label="Search results"></div>
    </div>

    <div class="mobile-categories">
      <p class="mobile-categories-label">Categories</p>
      <div class="mobile-category-grid">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}/`} class="mobile-category-chip" style={`--accent: ${cat.color}`}>
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <a href="/calculators/" class="mobile-cta">Browse All {totalCalcs} Calculators →</a>
  </div>
</div>

<style>
  /* ── Scroll progress bar ─────────────────────────────── */
  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, #c2410c 0%, #f97316 60%, #fdba74 100%);
    z-index: 200;
    pointer-events: none;
    opacity: 0;
    transition: opacity 300ms ease;
  }
  #scroll-progress[data-visible] {
    opacity: 1;
  }

  /* ── Header base ──────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 1px 0 rgba(0, 0, 0, 0.04);
    transition:
      background     250ms cubic-bezier(0.4, 0, 0.2, 1),
      border-color   250ms cubic-bezier(0.4, 0, 0.2, 1),
      box-shadow     250ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Hero pages: gradient scrim when at top */
  .site-header[data-hero]:not([data-scrolled]) {
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0.15) 70%,
      transparent 100%
    );
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    box-shadow: none;
  }

  /* When scrolled: elevated frosted glass */
  .site-header[data-scrolled] {
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(24px) saturate(200%);
    -webkit-backdrop-filter: blur(24px) saturate(200%);
    border-bottom-color: rgba(0, 0, 0, 0.07);
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.06),
      0 4px 16px rgba(0, 0, 0, 0.06),
      0 1px 4px rgba(0, 0, 0, 0.04);
  }

  /* Hero child colours on transparent header */
  .site-header[data-hero]:not([data-scrolled]) .nav-link { color: rgba(255,255,255,0.88); }
  .site-header[data-hero]:not([data-scrolled]) .nav-link:hover { color: #fff; background: rgba(255,255,255,0.12); }
  .site-header[data-hero]:not([data-scrolled]) .header-search-box {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.25);
  }
  .site-header[data-hero]:not([data-scrolled]) .header-search-input { color: #fff; }
  .site-header[data-hero]:not([data-scrolled]) .header-search-input::placeholder { color: rgba(255,255,255,0.55); }
  .site-header[data-hero]:not([data-scrolled]) .header-search-icon { color: rgba(255,255,255,0.65); }
  .site-header[data-hero]:not([data-scrolled]) .search-kbd { display: none; }
  .site-header[data-hero]:not([data-scrolled]) .mobile-toggle { color: #fff; }
  .site-header[data-hero]:not([data-scrolled]) .burger-bar { background: #fff; }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* ── Logo ─────────────────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    transition: opacity 180ms ease;
  }
  .logo:hover { opacity: 0.8; }

  .logo-img {
    display: block;
    height: 36px;
    width: auto;
    max-width: 200px;
    object-fit: contain;
    object-position: left center;
  }

  /* ── Desktop nav ──────────────────────────────────────── */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.125rem;
    margin-left: 0.5rem;
  }
  @media (min-width: 768px) { .desktop-nav { display: flex; } }

  .nav-link {
    padding: 0.375rem 0.6875rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: 8px;
    transition: color 150ms, background 150ms;
    white-space: nowrap;
    letter-spacing: -0.01em;
  }
  .nav-link:hover {
    color: var(--color-text-primary);
    background: rgba(0, 0, 0, 0.05);
  }
  .nav-link--active {
    color: var(--color-primary);
    background: var(--color-primary-50);
    font-weight: 600;
  }
  .nav-link--active:hover {
    background: #ffe8d8;
    color: var(--color-primary-hover);
  }

  /* Dropdown trigger */
  .nav-link--toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border: none;
    cursor: pointer;
    background: none;
    font-family: inherit;
  }
  .nav-chevron {
    transition: transform 200ms cubic-bezier(0.4, 0, 0.2, 1);
    opacity: 0.5;
    flex-shrink: 0;
  }
  .nav-dropdown-wrap[data-open] .nav-chevron { transform: rotate(180deg); opacity: 0.8; }
  .nav-dropdown-wrap[data-open] .nav-link--toggle {
    color: var(--color-text-primary);
    background: rgba(0,0,0,0.05);
  }

  /* ── Dropdown panel ───────────────────────────────────── */
  .nav-dropdown-wrap { position: relative; }

  /* Invisible bridge fills the gap so mouse can travel to panel */
  .nav-dropdown-wrap::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -12px;
    right: -12px;
    height: 10px;
    display: none;
  }
  .nav-dropdown-wrap[data-open]::after { display: block; }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 480px;
    background: var(--surface-card);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 16px;
    box-shadow:
      0 4px 6px rgba(0,0,0,0.04),
      0 12px 36px rgba(0,0,0,0.10),
      0 0 0 1px rgba(0,0,0,0.03);
    opacity: 0;
    transform: translateY(-6px) scale(0.97);
    transform-origin: top left;
    pointer-events: none;
    transition: opacity 160ms cubic-bezier(0.16, 1, 0.3, 1), transform 160ms cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 60;
    overflow: hidden;
  }
  .nav-dropdown-wrap[data-open] .nav-dropdown {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2px;
    padding: 0.625rem;
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    transition: background 120ms;
    position: relative;
  }
  .dropdown-item:hover {
    background: var(--color-primary-50);
  }
  .dropdown-item:hover .dropdown-item-name {
    color: var(--color-primary);
  }

  .dropdown-item-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    transition: color 120ms;
    letter-spacing: -0.01em;
  }
  .dropdown-item-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dropdown-footer {
    padding: 0.625rem 0.875rem 0.75rem;
    border-top: 1px solid var(--border-subtle);
    background: var(--surface-page);
  }
  .dropdown-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap 150ms ease;
  }
  .dropdown-footer-link:hover { gap: 0.625rem; }

  /* Categories dropdown */
  .nav-dropdown--cats { min-width: 300px; }
  .dropdown-cats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.375rem;
    padding: 0.75rem;
  }
  .dropdown-cat {
    padding: 0.5rem 0.875rem;
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 8%, var(--surface-card));
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 18%, var(--border-default));
    transition: background 120ms, border-color 120ms, transform 120ms;
  }
  .dropdown-cat:hover {
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 16%, var(--surface-card));
    border-color: color-mix(in srgb, var(--accent, var(--color-primary)) 40%, transparent);
    transform: translateY(-1px);
  }

  /* ── Desktop search ───────────────────────────────────── */
  .header-search {
    display: none;
    position: relative;
    margin-left: auto;
    width: 13rem;
    flex-shrink: 1;
    min-width: 8rem;
  }
  @media (min-width: 768px) { .header-search { display: block; } }
  @media (min-width: 1024px) { .header-search { width: 15rem; } }

  .header-search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.625rem;
    height: 36px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: 9999px;
    transition: border-color 150ms, box-shadow 150ms, background 250ms;
  }
  .header-search-box:focus-within {
    border-color: var(--color-primary);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(194, 65, 12, 0.12);
  }
  .header-search-box:focus-within .search-kbd { display: none; }

  .header-search-icon { color: var(--color-text-muted); flex-shrink: 0; transition: color 250ms; }
  .header-search-box:focus-within .header-search-icon { color: var(--color-primary); }

  .header-search-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-size: 0.8125rem;
    color: var(--color-text-primary);
    transition: color 250ms;
  }
  .header-search-input::placeholder { color: var(--color-text-muted); }
  .header-search-input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .search-kbd {
    font-size: 0.625rem;
    font-family: var(--font-sans);
    color: var(--color-text-muted);
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-bottom-width: 2px;
    border-radius: 4px;
    padding: 0.1rem 0.3rem;
    line-height: 1.5;
    white-space: nowrap;
    flex-shrink: 0;
    letter-spacing: 0;
    pointer-events: none;
    user-select: none;
  }

  .header-search-results,
  .mobile-search-results {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    width: 22rem;
    max-width: min(22rem, calc(100vw - 3rem));
    background: var(--surface-card);
    border: 1px solid rgba(0,0,0,0.08);
    border-radius: 12px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.04), 0 12px 32px rgba(0,0,0,0.10);
    overflow: hidden;
    z-index: 60;
  }
  .header-search-results[data-open],
  .mobile-search-results[data-open] { display: block; }

  .header-search-results :global(.hs-item),
  .mobile-search-results :global(.hs-item) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 100ms;
  }
  .header-search-results :global(.hs-item:last-child),
  .mobile-search-results :global(.hs-item:last-child) { border-bottom: none; }
  .header-search-results :global(.hs-item:hover),
  .header-search-results :global(.hs-item[aria-selected="true"]),
  .mobile-search-results :global(.hs-item:hover),
  .mobile-search-results :global(.hs-item[aria-selected="true"]) {
    background: var(--color-primary-50);
  }
  .header-search-results :global(.hs-item strong),
  .mobile-search-results :global(.hs-item strong) {
    font-size: 0.875rem; font-weight: 600; color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }
  .header-search-results :global(.hs-item span),
  .mobile-search-results :global(.hs-item span) {
    font-size: 0.8125rem; color: var(--color-text-muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .header-search-results :global(.hs-empty),
  .mobile-search-results :global(.hs-empty) {
    padding: 1rem; text-align: center; font-size: 0.875rem; color: var(--color-text-muted);
  }

  /* ── CTA button ───────────────────────────────────────── */
  .header-cta {
    display: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 1rem;
    background: linear-gradient(135deg, #c2410c 0%, #ea580c 100%);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgba(194, 65, 12, 0.3), inset 0 1px 0 rgba(255,255,255,0.15);
    transition: box-shadow 150ms, transform 150ms, filter 150ms;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .header-cta:hover {
    filter: brightness(1.08);
