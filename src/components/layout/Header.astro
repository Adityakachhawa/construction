  .mobile-category-chip {
    padding: 0.5625rem 0.75rem;
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 8%, var(--surface-page));
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 20%, var(--border-default));
    border-radius: 8px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
