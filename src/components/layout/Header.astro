  .header-cta:active {
    transform: translateY(0);
    filter: brightness(0.96);
  }
  @media (min-width: 768px) { .header-cta { display: flex; } }

  /* ── Mobile toggle (animated hamburger) ──────────────── */
  .mobile-toggle {
    margin-left: auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 4.5px;
    width: 40px;
    height: 40px;
    padding: 0.5rem;
