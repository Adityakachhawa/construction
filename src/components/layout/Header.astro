  }
  .mobile-toggle:hover { background: rgba(0,0,0,0.05); }
  @media (min-width: 768px) { .mobile-toggle { display: none; } }

  .burger-bar {
    display: block;
    width: 18px;
    height: 1.75px;
    background: currentColor;
    border-radius: 9999px;
    transition: transform 280ms cubic-bezier(0.4, 0, 0.2, 1), opacity 200ms ease, width 200ms ease;
    transform-origin: center;
  }
  .mobile-toggle[aria-expanded="true"] .burger-bar:nth-child(1) {
    transform: translateY(6.25px) rotate(45deg);
  }
  .mobile-toggle[aria-expanded="true"] .burger-bar:nth-child(2) {
    opacity: 0;
    width: 0;
  }
  .mobile-toggle[aria-expanded="true"] .burger-bar:nth-child(3) {
    transform: translateY(-6.25px) rotate(-45deg);
  }

  /* ── Mobile backdrop ──────────────────────────────────── */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
    animation: none;
  }
  .mobile-backdrop.is-open {
    display: block;
    animation: backdrop-in 220ms ease forwards;
  }
  @keyframes backdrop-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* ── Mobile bottom sheet ──────────────────────────────── */
  .mobile-overlay {
    position: fixed;
    bottom: 0; left: 0; right: 0;
    z-index: 100;
    background: #fff;
    border-radius: 20px 20px 0 0;
    max-height: 88vh;
    transform: translateY(100%);
    visibility: hidden;
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1), visibility 0s linear 320ms;
    box-shadow: 0 -2px 0 rgba(0,0,0,0.04), 0 -8px 40px rgba(0,0,0,0.16);
  }
  .mobile-overlay.is-open {
    transform: translateY(0);
    visibility: visible;
    transition: transform 320ms cubic-bezier(0.32, 0.72, 0, 1), visibility 0s linear 0s;
  }

  .mobile-handle {
    width: 32px;
    height: 3px;
    background: var(--border-strong);
    border-radius: 9999px;
