</style>

<script>
  /* ── Scroll progress bar ─────────────────────────────── */
  const progressBar = document.getElementById('scroll-progress');
  function updateProgress() {
    if (!progressBar) return;
    const maxY = document.documentElement.scrollHeight - window.innerHeight;
    if (maxY <= 0) return;
    const pct = Math.min((window.scrollY / maxY) * 100, 100);
    progressBar.style.width = pct.toFixed(1) + '%';
    // Show bar only after user has scrolled a bit
    progressBar.toggleAttribute('data-visible', window.scrollY > 80);
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  updateProgress();

  /* ── Hero scrim → frosted transition ─────────────────── */
  const header = document.querySelector<HTMLElement>('.site-header');
  if (header?.hasAttribute('data-hero')) {
    const hero =
      document.querySelector<HTMLElement>('.hero') ??
      document.querySelector<HTMLElement>('main > section:first-child');

    if (hero) {
      const obs = new IntersectionObserver(
        ([entry]) => header.toggleAttribute('data-scrolled', entry.intersectionRatio < 0.5),
        { threshold: [0.5] }
      );
      obs.observe(hero);
    } else {
      const check = () => header.toggleAttribute('data-scrolled', window.scrollY > 60);
      window.addEventListener('scroll', check, { passive: true });
      check();
    }
  } else if (header) {
    // Non-hero pages: add scrolled depth class for stronger shadow
    const check = () => header.toggleAttribute('data-scrolled', window.scrollY > 8);
    window.addEventListener('scroll', check, { passive: true });
    check();
  }

  /* ── Keyboard shortcut: ⌘K / Ctrl+K opens search ─────── */
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
      e.preventDefault();
      const input = document.querySelector<HTMLInputElement>('.header-search .header-search-input');
      input?.focus();
      input?.select();
    }
  });

  /* ── Dropdown menus ───────────────────────────────────── */
  document.querySelectorAll<HTMLElement>('.nav-dropdown-wrap').forEach((wrap) => {
    const btn   = wrap.querySelector<HTMLButtonElement>('.nav-link--toggle');
    const panel = wrap.querySelector<HTMLElement>('.nav-dropdown');
    if (!btn || !panel) return;

    let closeTimer: ReturnType<typeof setTimeout>;

    function open() {
      document.querySelectorAll<HTMLElement>('.nav-dropdown-wrap[data-open]').forEach(other => {
        if (other !== wrap) {
          other.removeAttribute('data-open');
          other.querySelector<HTMLButtonElement>('.nav-link--toggle')?.setAttribute('aria-expanded', 'false');
        }
      });
      clearTimeout(closeTimer);
      wrap.setAttribute('data-open', '');
      btn?.setAttribute('aria-expanded', 'true');
    }

    function close() {
      closeTimer = setTimeout(() => {
        wrap.removeAttribute('data-open');
        btn?.setAttribute('aria-expanded', 'false');
      }, 100);
    }

    wrap.addEventListener('mouseenter', open);
    wrap.addEventListener('mouseleave', close);
    panel.addEventListener('mouseenter', () => clearTimeout(closeTimer));
    panel.addEventListener('mouseleave', close);

    btn.addEventListener('click', () => {
      wrap.hasAttribute('data-open') ? close() : open();
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav-dropdown-wrap')) {
      document.querySelectorAll<HTMLElement>('.nav-dropdown-wrap[data-open]').forEach(wrap => {
        wrap.removeAttribute('data-open');
        wrap.querySelector<HTMLButtonElement>('.nav-link--toggle')?.setAttribute('aria-expanded', 'false');
      });
    }
  });

  /* ── Mobile bottom sheet ──────────────────────────────── */
  const toggle   = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('mobile-close');
  const overlay  = document.getElementById('mobile-overlay');
  const backdrop = document.getElementById('mobile-backdrop');

  const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled])';

  function getFocusable(): HTMLElement[] {
    if (!overlay) return [];
    return Array.from(overlay.querySelectorAll<HTMLElement>(FOCUSABLE)).filter(el => el.offsetParent !== null);
  }

  function openMenu() {
    overlay?.classList.add('is-open');
    backdrop?.classList.add('is-open');
    overlay?.removeAttribute('aria-hidden');
    toggle?.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
    // Slight delay so animation is visible before focus moves
    setTimeout(() => closeBtn?.focus(), 60);
  }

  function closeMenu() {
    if (!overlay?.classList.contains('is-open')) return;
    overlay.classList.remove('is-open');
    backdrop?.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    toggle?.focus();
  }

  toggle?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') { closeMenu(); return; }
    if (e.key === 'Tab' && overlay?.classList.contains('is-open')) {
      const focusable = getFocusable();
      if (!focusable.length) return;
      const first = focusable[0];
      const last  = focusable[focusable.length - 1];
      const active = document.activeElement as HTMLElement;
      if (e.shiftKey && (active === first || !overlay.contains(active))) {
        e.preventDefault(); last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault(); first.focus();
      }
    }
  });
</script>

<script is:inline define:vars={{ searchIndex }}>
  function escapeHtml(s) {
    return s.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }

  function wireSearch(root) {
    const input   = root.querySelector('input');
    const results = root.querySelector('[role="listbox"]');
    if (!input || !results) return;

    let items = [], active = -1;

    function clear() {
      results.innerHTML = '';
      results.removeAttribute('data-open');
      input.setAttribute('aria-expanded', 'false');
      items = []; active = -1;
    }

    function setActive(i) {
      items.forEach((el, idx) => el.setAttribute('aria-selected', idx === i ? 'true' : 'false'));
      active = i;
      if (items[i]) items[i].scrollIntoView({ block: 'nearest' });
    }

    function render() {
      const q = input.value.trim().toLowerCase();
      if (q.length < 2) { clear(); return; }
      const matches = searchIndex.filter(c =>
        c.name.toLowerCase().includes(q) || c.description.toLowerCase().includes(q)
      ).slice(0, 6);

      if (!matches.length) {
        results.innerHTML = '<p class="hs-empty">No calculators found</p>';
        results.setAttribute('data-open', '');
        input.setAttribute('aria-expanded', 'true');
        items = []; active = -1;
        return;
      }

      results.innerHTML = matches.map(c =>
        `<a href="/calculators/${c.slug}/" class="hs-item" role="option" aria-selected="false"><strong>${escapeHtml(c.name)}</strong><span>${escapeHtml(c.description)}</span></a>`
      ).join('');
      results.setAttribute('data-open', '');
      input.setAttribute('aria-expanded', 'true');
      items = Array.from(results.querySelectorAll('.hs-item'));
      active = -1;
    }

    input.addEventListener('input', render);
    input.addEventListener('keydown', (e) => {
      if (!items.length) return;
      if (e.key === 'ArrowDown')  { e.preventDefault(); setActive((active + 1) % items.length); }
      else if (e.key === 'ArrowUp')   { e.preventDefault(); setActive((active - 1 + items.length) % items.length); }
      else if (e.key === 'Enter') {
        const t = active >= 0 ? items[active] : items[0];
        if (t) { e.preventDefault(); window.location.href = t.getAttribute('href'); }
      } else if (e.key === 'Escape') { clear(); input.blur(); }
    });
    document.addEventListener('click', (e) => { if (!root.contains(e.target)) clear(); });
  }

  document.querySelectorAll('[data-search-root]').forEach(wireSearch);
</script>
