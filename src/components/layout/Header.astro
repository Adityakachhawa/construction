---
import { categories } from '../../data/categories';
import { calculatorRegistry, getFeaturedCalculators } from '../../data/registry';

interface Props {
  currentPath?: string;
  heroPage?: boolean;
}

const { currentPath = '', heroPage = false } = Astro.props;

const featuredCalcs = getFeaturedCalculators(6);
const totalCalcs = calculatorRegistry.length;

const searchIndex = calculatorRegistry.map(c => ({
  slug: c.slug,
  name: c.name,
  description: c.description,
}));
---

<header class="site-header" data-hero={heroPage ? '' : undefined}>
  <div class="header-inner">

    <!-- Logo -->
    <a href="/" class="logo" aria-label="ConstructCalc Home">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <rect x="2" y="14" width="7" height="12" rx="1.5" fill="var(--color-primary)"/>
        <rect x="10.5" y="8" width="7" height="18" rx="1.5" fill="var(--color-primary)" opacity="0.75"/>
        <rect x="19" y="2" width="7" height="24" rx="1.5" fill="var(--color-primary)" opacity="0.5"/>
      </svg>
      <span>ConstructCalc</span>
    </a>

    <!-- Desktop nav -->
    <nav class="desktop-nav" aria-label="Main navigation">

      <!-- Calculators dropdown -->
      <div class="nav-dropdown-wrap" data-dropdown="calculators">
        <button
          class="nav-link nav-link--toggle"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="dd-calculators"
          type="button"
        >
          Calculators
          <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="nav-dropdown" id="dd-calculators" role="menu">
          <div class="dropdown-grid">
            {featuredCalcs.map(calc => (
              <a href={`/calculators/${calc.slug}/`} class="dropdown-item" role="menuitem">
                <strong class="dropdown-item-name">{calc.name}</strong>
                <span class="dropdown-item-desc">{calc.description}</span>
              </a>
            ))}
          </div>
          <div class="dropdown-footer">
            <a href="/calculators/" class="dropdown-footer-link">View all {totalCalcs} calculators →</a>
          </div>
        </div>
      </div>

      <!-- Categories dropdown -->
      <div class="nav-dropdown-wrap" data-dropdown="categories">
        <button
          class="nav-link nav-link--toggle"
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="dd-categories"
          type="button"
        >
          Categories
          <svg class="nav-chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M3 4.5l3 3 3-3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
        <div class="nav-dropdown nav-dropdown--cats" id="dd-categories" role="menu">
          <div class="dropdown-cats">
            {categories.map(cat => (
              <a
                href={`/category/${cat.slug}/`}
                class="dropdown-cat"
                role="menuitem"
                style={`--accent: ${cat.color}`}
              >
                {cat.name}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Blog link -->
      <a
        href="/blog/"
        class={['nav-link', currentPath.startsWith('/blog/') ? 'nav-link--active' : ''].join(' ')}
      >Blog</a>

    </nav>

    <!-- Desktop search -->
    <div class="header-search" data-search-root>
      <div class="header-search-box">
        <svg class="header-search-icon" width="16" height="16" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          placeholder="Search calculators…"
          class="header-search-input"
          autocomplete="off"
          aria-label="Search calculators"
          role="combobox"
          aria-expanded="false"
          aria-controls="header-search-results"
          aria-autocomplete="list"
        />
      </div>
      <div id="header-search-results" class="header-search-results" role="listbox" aria-label="Search results"></div>
    </div>

    <!-- Desktop CTA -->
    <a href="/calculators/" class="header-cta" aria-label="Browse all calculators">
      Browse Calculators
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M3 7h8M7 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>

    <!-- Mobile menu button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      aria-label="Open navigation menu"
      aria-expanded="false"
      aria-controls="mobile-overlay"
      class="mobile-toggle"
    >
      <svg id="icon-open" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path fill-rule="evenodd" d="M3 5h14a1 1 0 010 2H3a1 1 0 010-2zm0 4h14a1 1 0 010 2H3a1 1 0 010-2zm0 4h14a1 1 0 010 2H3a1 1 0 010-2z" clip-rule="evenodd"/>
      </svg>
      <svg id="icon-close" width="20" height="20" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" style="display:none">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    </button>
  </div>
</header>

<!-- Mobile backdrop -->
<div id="mobile-backdrop" class="mobile-backdrop" aria-hidden="true"></div>

<!-- Mobile bottom sheet -->
<div id="mobile-overlay" class="mobile-overlay" aria-hidden="true">
  <!-- Drag handle -->
  <div class="mobile-handle" aria-hidden="true"></div>

  <div class="mobile-overlay-inner">
    <div class="mobile-overlay-header">
      <a href="/" class="logo">
        <svg width="24" height="24" viewBox="0 0 28 28" fill="none" aria-hidden="true">
          <rect x="2" y="14" width="7" height="12" rx="1.5" fill="var(--color-primary)"/>
          <rect x="10.5" y="8" width="7" height="18" rx="1.5" fill="var(--color-primary)" opacity="0.75"/>
          <rect x="19" y="2" width="7" height="24" rx="1.5" fill="var(--color-primary)" opacity="0.5"/>
        </svg>
        <span>ConstructCalc</span>
      </a>
      <button id="mobile-close" type="button" aria-label="Close navigation" class="mobile-close">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
        </svg>
      </button>
    </div>

    <nav class="mobile-nav" aria-label="Mobile navigation">
      <a href="/calculators/" class="mobile-nav-link">Calculators</a>
      <a href="/blog/" class="mobile-nav-link">Blog</a>
      <a href="/methodology/" class="mobile-nav-link">Methodology</a>
    </nav>

    <!-- Mobile search -->
    <div class="mobile-search" data-search-root>
      <div class="mobile-search-box">
        <svg class="header-search-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.5"/>
          <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
        <input
          type="search"
          placeholder="Search calculators…"
          class="header-search-input"
          autocomplete="off"
          aria-label="Search calculators"
          role="combobox"
          aria-expanded="false"
          aria-controls="mobile-search-results"
          aria-autocomplete="list"
        />
      </div>
      <div id="mobile-search-results" class="mobile-search-results" role="listbox" aria-label="Search results"></div>
    </div>

    <div class="mobile-categories">
      <p class="mobile-categories-label">Categories</p>
      <div class="mobile-category-grid">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}/`} class="mobile-category-chip" style={`--accent: ${cat.color}`}>
            {cat.name}
          </a>
        ))}
      </div>
    </div>

    <a href="/calculators/" class="mobile-cta">Browse All Calculators →</a>
  </div>
</div>

<style>
  /* ── Header base ──────────────────────────────────────── */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border-default);
    transition: background 200ms, border-color 200ms, box-shadow 200ms;
  }

  /* Hero pages: start transparent, become frosted on scroll */
  .site-header[data-hero]:not([data-scrolled]) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .site-header[data-scrolled] {
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--border-default);
    box-shadow: 0 1px 8px rgba(0,0,0,0.06);
  }

  /* On hero pages override logo/link colors when transparent */
  .site-header[data-hero]:not([data-scrolled]) .logo { color: #fff; }
  .site-header[data-hero]:not([data-scrolled]) .nav-link { color: rgba(255,255,255,0.8); }
  .site-header[data-hero]:not([data-scrolled]) .nav-link:hover { color: #fff; background: rgba(255,255,255,0.1); }
  .site-header[data-hero]:not([data-scrolled]) .header-search-box {
    background: rgba(255,255,255,0.12);
    border-color: rgba(255,255,255,0.2);
  }
  .site-header[data-hero]:not([data-scrolled]) .header-search-input { color: #fff; }
  .site-header[data-hero]:not([data-scrolled]) .header-search-input::placeholder { color: rgba(255,255,255,0.55); }
  .site-header[data-hero]:not([data-scrolled]) .header-search-icon { color: rgba(255,255,255,0.6); }
  .site-header[data-hero]:not([data-scrolled]) .mobile-toggle { color: rgba(255,255,255,0.85); }
  .site-header[data-hero]:not([data-scrolled]) .mobile-toggle:hover { background: rgba(255,255,255,0.1); }

  .header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 64px;
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* ── Logo ─────────────────────────────────────────────── */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    flex-shrink: 0;
    transition: opacity 150ms ease, color 200ms;
  }
  .logo:hover { opacity: 0.8; }

  /* ── Desktop nav ──────────────────────────────────────── */
  .desktop-nav {
    display: none;
    align-items: center;
    gap: 0.125rem;
    margin-left: 0.25rem;
  }
  @media (min-width: 768px) { .desktop-nav { display: flex; } }

  .nav-link {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    border-radius: 8px;
    transition: color 150ms, background 150ms;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--color-text-primary);
    background: var(--border-subtle);
  }
  .nav-link--active {
    color: var(--color-primary);
    background: var(--color-primary-50);
    font-weight: 600;
  }

  /* Dropdown trigger button */
  .nav-link--toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    border: none;
    cursor: pointer;
    background: none;
    font-family: inherit;
  }
  .nav-chevron {
    transition: transform 200ms;
    color: currentColor;
    opacity: 0.6;
  }
  .nav-dropdown-wrap[data-open] .nav-chevron { transform: rotate(180deg); }
  .nav-dropdown-wrap[data-open] .nav-link--toggle {
    color: var(--color-text-primary);
    background: var(--border-subtle);
  }

  /* ── Dropdown panel ───────────────────────────────────── */
  .nav-dropdown-wrap {
    position: relative;
  }

  .nav-dropdown {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 480px;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    box-shadow: var(--shadow-widget);
    opacity: 0;
    transform: translateY(-6px);
    pointer-events: none;
    transition: opacity 150ms, transform 150ms;
    z-index: 60;
    overflow: hidden;
  }

  .nav-dropdown-wrap[data-open] .nav-dropdown {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .dropdown-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    padding: 0.75rem;
    background: var(--border-subtle);
  }

  .dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.75rem;
    border-radius: 10px;
    background: var(--surface-card);
    transition: background 100ms;
  }
  .dropdown-item:hover { background: var(--color-primary-50); }

  .dropdown-item-name {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .dropdown-item-desc {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .dropdown-footer {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--border-subtle);
  }
  .dropdown-footer-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: opacity 150ms;
  }
  .dropdown-footer-link:hover { opacity: 0.7; }

  /* Categories dropdown */
  .nav-dropdown--cats {
    min-width: 320px;
    left: 0;
  }
  .dropdown-cats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    padding: 0.875rem;
  }
  .dropdown-cat {
    padding: 0.5rem 0.875rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 8%, var(--surface-card));
    border: 1px solid color-mix(in srgb, var(--accent, var(--color-primary)) 20%, var(--border-default));
    transition: background 150ms, border-color 150ms;
  }
  .dropdown-cat:hover {
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 15%, var(--surface-card));
    border-color: color-mix(in srgb, var(--accent, var(--color-primary)) 40%, var(--border-default));
  }

  /* ── Header search ────────────────────────────────────── */
  .header-cta {
    display: none;
    align-items: center;
    gap: 0.375rem;
    margin-left: auto;
    padding: 0.5rem 1.125rem;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    border-radius: 9999px;
    transition: background 150ms, transform 150ms;
    white-space: nowrap;
  }
  .header-cta:hover {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }
  @media (min-width: 768px) { .header-cta { display: flex; } }

  .mobile-toggle {
    margin-left: auto;
    padding: 0.5rem;
    background: none;
    border: none;
    color: var(--color-text-secondary);
    border-radius: 8px;
    transition: background 150ms, color 200ms;
  }
  .mobile-toggle:hover { background: var(--border-subtle); }
  @media (min-width: 768px) { .mobile-toggle { display: none; } }

  /* ── Desktop search ───────────────────────────────────── */
  .header-search {
    display: none;
    position: relative;
    margin-left: auto;
    width: 14rem;
    flex-shrink: 1;
    min-width: 9rem;
  }
  @media (min-width: 768px) { .header-search { display: block; } }

  .header-search-box {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.75rem;
    height: 38px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: 9999px;
    transition: border-color 150ms, background 150ms;
  }
  .header-search-box:focus-within {
    border-color: var(--color-primary);
    background: var(--surface-card);
  }

  .header-search-icon { color: var(--color-text-muted); flex-shrink: 0; transition: color 200ms; }

  .header-search-input {
    flex: 1;
    min-width: 0;
    background: none;
    border: none;
    outline: none;
    font-size: 0.875rem;
    color: var(--color-text-primary);
    transition: color 200ms;
  }
  .header-search-input::placeholder { color: var(--color-text-muted); transition: color 200ms; }
  .header-search-input::-webkit-search-cancel-button { -webkit-appearance: none; }

  .header-search-results,
  .mobile-search-results {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: 22rem;
    max-width: min(22rem, calc(100vw - 3rem));
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    box-shadow: var(--shadow-widget);
    overflow: hidden;
    z-index: 60;
  }
  .header-search-results[data-open],
  .mobile-search-results[data-open] { display: block; }

  .header-search-results :global(.hs-item),
  .mobile-search-results :global(.hs-item) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.625rem 0.875rem;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 100ms;
  }
  .header-search-results :global(.hs-item:last-child),
  .mobile-search-results :global(.hs-item:last-child) { border-bottom: none; }
  .header-search-results :global(.hs-item:hover),
  .header-search-results :global(.hs-item[aria-selected="true"]),
  .mobile-search-results :global(.hs-item:hover),
  .mobile-search-results :global(.hs-item[aria-selected="true"]) {
    background: var(--color-primary-50);
  }
  .header-search-results :global(.hs-item strong),
  .mobile-search-results :global(.hs-item strong) { font-size: 0.875rem; font-weight: 600; color: var(--color-text-primary); }
  .header-search-results :global(.hs-item span),
  .mobile-search-results :global(.hs-item span) {
    font-size: 0.8125rem; color: var(--color-text-muted);
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .header-search-results :global(.hs-empty),
  .mobile-search-results :global(.hs-empty) { padding: 1rem; text-align: center; font-size: 0.875rem; color: var(--color-text-muted); }

  /* ── Mobile backdrop ──────────────────────────────────── */
  .mobile-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .mobile-backdrop.is-open { display: block; }

  /* ── Mobile bottom sheet ──────────────────────────────── */
  .mobile-overlay {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: #fff;
    border-radius: 20px 20px 0 0;
    max-height: 85vh;
    transform: translateY(100%);
    visibility: hidden;
    transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1), visibility 0s linear 280ms;
    box-shadow: 0 -4px 32px rgba(0,0,0,0.14);
  }
  .mobile-overlay.is-open {
    transform: translateY(0);
    visibility: visible;
    transition: transform 280ms cubic-bezier(0.32, 0.72, 0, 1), visibility 0s linear 0s;
  }

  .mobile-handle {
    width: 36px;
    height: 4px;
    background: var(--border-strong);
    border-radius: 9999px;
    margin: 0.75rem auto 0;
  }

  .mobile-overlay-inner {
    display: flex;
    flex-direction: column;
    max-height: calc(85vh - 1.5rem);
    padding: 0.5rem 1.25rem 2rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .mobile-overlay-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0 1.25rem;
    border-bottom: 1px solid var(--border-default);
  }

  .mobile-close {
    padding: 0.5rem;
    background: var(--border-subtle);
    border: none;
    border-radius: 8px;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background 150ms;
  }
  .mobile-close:hover { background: var(--border-default); }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-default);
  }

  .mobile-nav-link {
    padding: 0.75rem 0.5rem;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text-primary);
    border-radius: 8px;
    transition: background 150ms;
  }
  .mobile-nav-link:hover { background: var(--border-subtle); }

  /* Mobile search */
  .mobile-search {
    position: relative;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-default);
  }

  .mobile-search-box {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0 1rem;
    height: 48px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: 12px;
  }
  .mobile-search-box:focus-within { border-color: var(--color-primary); }
  .mobile-search-box .header-search-input { font-size: 1rem; }

  .mobile-search-results {
    position: static;
    width: 100%;
    max-width: none;
    margin-top: 0.5rem;
    box-shadow: none;
  }

  .mobile-categories { padding: 1.25rem 0; }

  .mobile-categories-label {
    font-size: 0.75rem;
    font-weight: 700;
