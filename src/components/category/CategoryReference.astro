---
import type { CategoryContent, CategorySection } from '../../data/categoryContent';

interface Props {
  content: CategoryContent;
  categoryColor?: string;
}

const { content, categoryColor = '#ea580c' } = Astro.props;

const variantConfig = {
  tip: {
    icon: `<path d="M12 2a7 7 0 1 1 0 14A7 7 0 0 1 12 2zm0 10v2m0-8v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none"/>`,
    label: 'Pro tip',
    cls: 'callout--tip',
  },
  info: {
    icon: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M12 8v1m0 3v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    label: 'Good to know',
    cls: 'callout--info',
  },
  warning: {
    icon: `<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/><path d="M12 9v4m0 4h.01" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
    label: 'Important',
    cls: 'callout--warning',
  },
};
---

<div class="cat-reference" style={`--cat-color: ${categoryColor}`}>
  {content.sections.map((section: CategorySection) => {
    if (section.type === 'intro') {
      return (
        <div class="ref-intro">
          <p class="ref-intro-text">{section.text}</p>
        </div>
      );
    }

    if (section.type === 'tools') {
      return (
        <div class="ref-section">
          <h2 class="ref-section-title">{section.title}</h2>
          <div class="tools-grid">
            {section.tools.map(tool => (
              <a href={tool.href} class="tool-card">
                <span class="tool-name">{tool.name}</span>
                <p class="tool-desc">{tool.desc}</p>
                <span class="tool-cta">Open calculator →</span>
              </a>
            ))}
          </div>
        </div>
      );
    }

    if (section.type === 'costs') {
      return (
        <div class="ref-section">
          <h2 class="ref-section-title">{section.title}</h2>
          <div class="cost-grid">
            {section.items.map(item => (
              <div class="cost-card">
                <span class="cost-label">{item.label}</span>
                <span class="cost-range">{item.range}</span>
                {item.note && <span class="cost-note">{item.note}</span>}
              </div>
            ))}
          </div>
          {section.tip && (
            <p class="cost-tip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 2a7 7 0 1 1 0 14A7 7 0 0 1 12 2zm0 10v2m0-8v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
              {section.tip}
            </p>
          )}
        </div>
      );
    }

    if (section.type === 'table') {
      return (
        <div class="ref-section">
          <h2 class="ref-section-title">{section.title}</h2>
          <div class="ref-table-wrap">
            <table class="ref-table">
              <thead>
                <tr>
                  {section.headers.map(h => <th>{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {section.rows.map(row => (
                  <tr>
                    {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {section.note && <p class="ref-table-note">{section.note}</p>}
        </div>
      );
    }

    if (section.type === 'callout') {
      const cfg = variantConfig[section.variant];
      return (
        <div class={`ref-callout ${cfg.cls}`}>
          <div class="callout-header">
            <svg class="callout-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" set:html={cfg.icon}></svg>
            <span class="callout-label">{cfg.label}</span>
            <span class="callout-title">{section.title}</span>
          </div>
          <ul class="callout-list">
            {section.items.map(item => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      );
    }

    return null;
  })}
</div>

<style>
  .cat-reference {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border-default);
    margin-top: 3rem;
  }

  /* Intro */
  .ref-intro {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--cat-color, var(--color-primary));
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
  }

  .ref-intro-text {
    font-size: 1rem;
    color: var(--color-text-secondary);
    line-height: 1.7;
    max-width: 64ch;
  }

  /* Section header */
  .ref-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .ref-section-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--border-default);
  }

  /* Tools grid */
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px)  { .tools-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .tools-grid { grid-template-columns: repeat(3, 1fr); } }

  .tool-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.125rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    transition: box-shadow 150ms, transform 150ms, border-color 150ms;
  }
  .tool-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--cat-color, var(--color-primary)) 40%, var(--border-default));
  }

  .tool-name {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .tool-desc {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tool-cta {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cat-color, var(--color-primary));
    margin-top: 0.25rem;
  }

  /* Cost cards */
  .cost-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 640px) { .cost-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .cost-grid { grid-template-columns: repeat(3, 1fr); } }

  .cost-card {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 1.125rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
  }

  .cost-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .cost-range {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .cost-note {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
    line-height: 1.4;
    margin-top: 0.125rem;
  }

  .cost-tip {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    padding: 0.875rem 1rem;
    background: color-mix(in srgb, var(--cat-color, var(--color-primary)) 6%, var(--surface-card));
    border: 1px solid color-mix(in srgb, var(--cat-color, var(--color-primary)) 20%, var(--border-default));
    border-radius: 8px;
    line-height: 1.55;
  }
  .cost-tip svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--cat-color, var(--color-primary));
  }

  /* Reference table */
  .ref-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--border-default);
    border-radius: 12px;
  }

  .ref-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .ref-table thead tr {
    background: var(--border-subtle);
  }

  .ref-table th {
    padding: 0.625rem 1rem;
    text-align: left;
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .ref-table tbody tr {
    border-top: 1px solid var(--border-default);
  }

  .ref-table tbody tr:hover {
    background: var(--border-subtle);
  }

  .ref-table td {
    padding: 0.625rem 1rem;
    color: var(--color-text-secondary);
  }

  .ref-table tbody th {
    padding: 0.625rem 1rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .ref-table-note {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.55;
    margin-top: -0.25rem;
  }

  /* Callout boxes */
  .ref-callout {
    border-radius: 12px;
    padding: 1rem 1.25rem;
    border: 1px solid;
  }

  .callout--tip {
    background: color-mix(in srgb, #f97316 6%, var(--surface-card));
    border-color: color-mix(in srgb, #f97316 20%, var(--border-default));
  }
  .callout--tip .callout-icon,
  .callout--tip .callout-label { color: #c2410c; }

  .callout--info {
    background: color-mix(in srgb, #2563eb 6%, var(--surface-card));
    border-color: color-mix(in srgb, #2563eb 20%, var(--border-default));
  }
  .callout--info .callout-icon,
  .callout--info .callout-label { color: #1d4ed8; }

  .callout--warning {
    background: color-mix(in srgb, #d97706 6%, var(--surface-card));
    border-color: color-mix(in srgb, #d97706 20%, var(--border-default));
  }
  .callout--warning .callout-icon,
  .callout--warning .callout-label { color: #92400e; }

  .callout-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }

  .callout-icon { flex-shrink: 0; }

  .callout-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .callout-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .callout-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .callout-list li {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    padding-left: 1.125rem;
    position: relative;
  }

  .callout-list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
  }
</style>
