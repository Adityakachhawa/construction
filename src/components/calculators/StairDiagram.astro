---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="stair-diagram-caption" title="Stair Framing Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 242" role="img" aria-label="Stair elevation showing tread going, vertical rise between floors and total horizontal run">
    <path d="M44 171v-30h55v-30h55V81h55V51h55" fill="none" stroke="#244858" stroke-width="1.6" />
    <path d="M30 171h38m196-120h36" fill="none" stroke="#244858" stroke-width="1.6" />
    <path d="M154 69H209m0 -5v10M154 64v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="181.5" y="60" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Going</text>
    <path d="M282 51V171m-5 0h10M277 51h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="292" y="116" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Total rise</text>
    <path d="M44 211H209m0 -5v10M44 206v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="126.5" y="202" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Total run</text>
  </svg>
  <span slot="caption">Measure total rise between finished floor levels. Measure going horizontally between successive nosings. Total run spans the horizontal treads.</span>
</DiagramFrame>
