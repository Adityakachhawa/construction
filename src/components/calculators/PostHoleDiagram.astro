---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="post-hole-diagram-caption" title="Post Hole Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 250" role="img" aria-label="Hole showing embedded post, concrete and gravel">
    <rect x="65" y="73" width="132" height="130" fill="#d0dbe0" stroke="#244858" stroke-width="1.5"/>
    <rect x="65" y="182" width="132" height="21" fill="#d3c2aa" stroke="#244858" stroke-width="1.5"/>
    <rect x="113" y="43" width="36" height="139" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <path d="M20 73h45m132 0h35" fill="none" stroke="#244858" stroke-width="1.6" />
    <path d="M65 34H197m0 -5v10M65 29v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="131" y="25" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Hole diameter</text>
    <path d="M239 73V203m-5 0h10M234 73h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="249" y="143" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Hole depth</text>
    <text x="129" y="197" text-anchor="middle" font-size="13" font-weight="600" fill="#244858">Gravel</text>
    <path d="M115 112H43" fill="none" stroke="#244858" stroke-width="1.6" />
    <text x="40" y="103" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Post</text>
  </svg>
  <span slot="caption">Measure across the hole center and from grade to the bottom. The post and any entered gravel base displace concrete.</span>
</DiagramFrame>
