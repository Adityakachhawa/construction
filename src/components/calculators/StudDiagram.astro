---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="stud-diagram-caption" title="Wall Framing Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 219" role="img" aria-label="Wall elevation with an opening and measured wall edges">
    <rect x="36" y="61" width="225" height="116" fill="#faf8f4" stroke="#244858" stroke-width="1.5"/>
    <path d="M61 62v114" fill="none" stroke="#a27a4c" stroke-width="6" />
    <path d="M107 62v114" fill="none" stroke="#a27a4c" stroke-width="6" />
    <path d="M153 62v114" fill="none" stroke="#a27a4c" stroke-width="6" />
    <path d="M199 62v114" fill="none" stroke="#a27a4c" stroke-width="6" />
    <path d="M245 62v114" fill="none" stroke="#a27a4c" stroke-width="6" />
    <rect x="142" y="104" width="78" height="73" fill="#f9fcfc" stroke="#244858" stroke-width="1.5"/>
    <text x="181" y="149" text-anchor="middle" font-size="14" font-weight="600" fill="#244858">Opening</text>
    <path d="M36 50H261m0 -5v10M36 45v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="148.5" y="41" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Wall length</text>
    <path d="M273 61V177m-5 0h10M268 61h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="283" y="124" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Wall height</text>
    <path d="M61 211H107m0 -5v10M61 206v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="84" y="202" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Stud spacing</text>
  </svg>
  <span slot="caption">Measure wall length and stud spacing center to center. Locate openings from the same wall end. Use the framing plan for the assemblies around openings.</span>
</DiagramFrame>
