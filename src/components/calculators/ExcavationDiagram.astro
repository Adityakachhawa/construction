---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="excavation-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M1 10 L4 4 L10 4 L13 10 Z" stroke="currentColor" stroke-width="1.2" fill="none"/>
        <line x1="4" y1="4" x2="4" y2="10" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
        <line x1="10" y1="4" x2="10" y2="10" stroke="currentColor" stroke-width="0.8" opacity="0.5"/>
      </svg>
    </span>
    <h2 id="excavation-diagram-caption" class="diagram-title">Excavation Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 540 330"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <!-- Ground surface -->
        <linearGradient id="exGround" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#86efac"/>
          <stop offset="100%" stop-color="#4ade80"/>
        </linearGradient>
        <!-- Pit floor -->
        <linearGradient id="exFloor" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#d4a96a"/>
          <stop offset="100%" stop-color="#b8864e"/>
        </linearGradient>
        <!-- Pit left wall -->
        <linearGradient id="exWallL" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%"   stop-color="#c8955a"/>
          <stop offset="100%" stop-color="#a8764a"/>
        </linearGradient>
        <!-- Pit right wall -->
        <linearGradient id="exWallR" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%"   stop-color="#9a6640"/>
          <stop offset="100%" stop-color="#7a4e30"/>
        </linearGradient>
        <!-- Soil pile -->
        <linearGradient id="exSoil" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#d4a96a"/>
          <stop offset="100%" stop-color="#b8864e"/>
        </linearGradient>
        <!-- Truck body -->
        <linearGradient id="exTruck" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#fbbf24"/>
          <stop offset="100%" stop-color="#d97706"/>
        </linearGradient>
        <!-- Soil dirt pattern -->
        <pattern id="exDirt" x="0" y="0" width="16" height="8" patternUnits="userSpaceOnUse">
          <circle cx="4"  cy="3" r="1"   fill="#92400e" opacity="0.15"/>
          <circle cx="12" cy="6" r="0.8" fill="#92400e" opacity="0.12"/>
          <circle cx="8"  cy="1" r="0.6" fill="#92400e" opacity="0.1"/>
        </pattern>
        <!-- Ground grass texture -->
        <pattern id="exGrass" x="0" y="0" width="12" height="6" patternUnits="userSpaceOnUse">
          <line x1="3" y1="6" x2="3" y2="3" stroke="#15803d" stroke-width="0.8" opacity="0.3"/>
          <line x1="7" y1="6" x2="7" y2="2" stroke="#166534" stroke-width="0.7" opacity="0.25"/>
          <line x1="10" y1="6" x2="10" y2="4" stroke="#15803d" stroke-width="0.6" opacity="0.2"/>
        </pattern>
      </defs>

      <!--
        Isometric excavation pit.
        Ground level: y=120
        Pit opening: x=100..380 (280px wide), isometric top edge
        Pit depth visual: 120px
        Pit floor: y=240

        Isometric projection:
          Front-left corner:  (100, 180)
          Front-right corner: (380, 180)
          Back-left corner:   (120, 120)   [offset 20px right, 60px up]
          Back-right corner:  (400, 120)

        Ground panels:
          Left ground:  (0,120) → (100,180) → (100,120) → (0,60) — not visible, omit
          Right ground: (380,180) → (540,120) → (540,180) [simplified right strip]
          Left ground visible slab: (0,80) → (120,80) → (120,120) → (100,180) → (0,180)
          Right ground: (400,120) → (540,80) → (540,180) → (380,180)

        Pit walls:
          Front face: (100,180) → (380,180) → (380,240) → (100,240)
          Left face:  (100,180) → (120,120) → (120,240+20?) → (100,240)
          Right face: (380,180) → (400,120) → (400,240) → (380,240) [actually right wall]
          Floor:      (100,240) → (120,220) → (400,220) → (380,240)  [isometric floor]
      -->

      <!-- ══ GROUND SURFACE ══════════════════════════════════════ -->
      <!-- Left ground panel -->
      <polygon points="0,80 120,80 100,180 0,180"
        fill="url(#exGround)" stroke="#16a34a" stroke-width="1"/>
      <polygon points="0,80 120,80 100,180 0,180"
        fill="url(#exGrass)" opacity="0.5"/>
      <!-- Right ground panel -->
      <polygon points="400,120 540,80 540,180 380,180"
        fill="url(#exGround)" stroke="#16a34a" stroke-width="1"/>
      <polygon points="400,120 540,80 540,180 380,180"
        fill="url(#exGrass)" opacity="0.5"/>
      <!-- Top ground surface (isometric top, behind pit) -->
      <polygon points="120,80 400,80 400,120 120,120"
        fill="url(#exGround)" stroke="#16a34a" stroke-width="1"/>
      <polygon points="120,80 400,80 400,120 120,120"
        fill="url(#exGrass)" opacity="0.45"/>
      <!-- Ground iso-top connecting panels -->
      <polygon points="0,80 120,80 120,120 100,180 0,180"
        fill="url(#exGround)" stroke="#16a34a" stroke-width="0.75"/>
      <polygon points="400,80 540,40 540,80 400,80"
        fill="url(#exGround)" stroke="#16a34a" stroke-width="0.75" opacity="0.7"/>

      <!-- ══ PIT WALLS ════════════════════════════════════════════ -->
      <!-- Right wall (dark) -->
      <polygon points="380,180 400,120 400,240 380,260"
        fill="url(#exWallR)" stroke="#d97706" stroke-width="0"/>
      <polygon points="380,180 400,120 400,240 380,260"
        fill="url(#exDirt)" opacity="0.4"/>
      <!-- Left wall -->
      <polygon points="100,180 120,120 120,240 100,260"
        fill="url(#exWallL)" stroke="#d97706" stroke-width="0"/>
      <polygon points="100,180 120,120 120,240 100,260"
        fill="url(#exDirt)" opacity="0.35"/>
      <!-- Front face (front wall, largest visible) -->
      <rect x="100" y="180" width="280" height="80"
        fill="url(#exWallL)" stroke="#92400e" stroke-width="1"/>
      <rect x="100" y="180" width="280" height="80"
        fill="url(#exDirt)" opacity="0.5"/>
      <!-- Pit floor (isometric parallelogram) -->
      <polygon points="100,260 120,240 400,240 380,260"
        fill="url(#exFloor)" stroke="#92400e" stroke-width="1"/>
      <polygon points="100,260 120,240 400,240 380,260"
        fill="url(#exDirt)" opacity="0.45"/>
      <!-- Pit opening outline on ground -->
      <polygon points="100,180 120,120 400,120 380,180"
        fill="rgba(0,0,0,0.08)" stroke="#166534" stroke-width="1.5" stroke-dasharray="4 3"/>

      <!-- ══ EXCAVATED VOLUME shading inside pit ══════════════════ -->
      <polygon points="100,180 120,120 400,120 380,180 380,260 400,240 400,120 120,120 120,240 100,260"
        fill="none" stroke="#0070f3" stroke-width="0" opacity="0"/>
      <!-- Subtle blue volume fill overlay -->
      <polygon points="100,180 380,180 380,260 100,260"
        fill="#eff6ff" opacity="0.18"/>

      <!-- ══ ANNOTATIONS ══════════════════════════════════════════ -->

      <!-- LENGTH — top edge of pit opening -->
      <line x1="120" y1="107" x2="400" y2="107" stroke="#0070f3" stroke-width="1.75"/>
      <line x1="120" y1="99"  x2="120" y2="115" stroke="#0070f3" stroke-width="1.25"/>
      <line x1="400" y1="99"  x2="400" y2="115" stroke="#0070f3" stroke-width="1.25"/>
      <polygon points="120,107 133,102 133,112" fill="#0070f3"/>
      <polygon points="400,107 387,102 387,112" fill="#0070f3"/>
      <text x="260" y="98" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Length</text>

      <!-- WIDTH — right side of pit opening (isometric) -->
      <line x1="413" y1="123" x2="393" y2="183" stroke="#16a34a" stroke-width="1.75"/>
      <line x1="405" y1="120" x2="421" y2="126" stroke="#16a34a" stroke-width="1.25"/>
      <line x1="385" y1="180" x2="401" y2="186" stroke="#16a34a" stroke-width="1.25"/>
      <polygon points="413,123 406,135 416,134" fill="#16a34a"/>
      <polygon points="393,183 400,171 410,172" fill="#16a34a"/>
      <text x="432" y="152" text-anchor="start" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#16a34a">Width</text>

      <!-- DEPTH — right side of front wall -->
      <line x1="398" y1="183" x2="398" y2="257" stroke="#d97706" stroke-width="1.75"/>
      <line x1="390" y1="183" x2="406" y2="183" stroke="#d97706" stroke-width="1.25"/>
      <line x1="390" y1="257" x2="406" y2="257" stroke="#d97706" stroke-width="1.25"/>
      <polygon points="398,183 393,196 403,196" fill="#d97706"/>
      <polygon points="398,257 393,244 403,244" fill="#d97706"/>
      <text x="416" y="225" text-anchor="start" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#d97706">Depth</text>

      <!-- VOLUME callout box (inside pit) -->
      <rect x="152" y="196" width="216" height="22" rx="5"
        fill="#eff6ff" stroke="#0070f3" stroke-width="1.25"/>
      <text x="260" y="207" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#1d4ed8">Volume = L × W × D</text>
      <text x="260" y="216" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#3b82f6" opacity="0.9">(bank / in-place volume)</text>

      <!-- ══ SOIL PILE (excavated soil) ══════════════════════════ -->
      <!-- Mound shape -->
      <ellipse cx="54" cy="174" rx="44" ry="14" fill="url(#exSoil)" stroke="#92400e" stroke-width="1"/>
      <path d="M 14,174 Q 24,148 54,142 Q 84,148 94,174 Z"
        fill="url(#exSoil)" stroke="#92400e" stroke-width="1"/>
      <ellipse cx="54" cy="174" rx="44" ry="14" fill="url(#exDirt)" opacity="0.6"/>
      <path d="M 14,174 Q 24,148 54,142 Q 84,148 94,174 Z"
        fill="url(#exDirt)" opacity="0.5"/>
      <!-- Soil pile label -->
      <text x="54" y="162" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="700" fill="#78350f">Excavated</text>
      <text x="54" y="172" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="700" fill="#78350f">soil</text>

      <!-- SWELL FACTOR callout -->
      <rect x="4" y="190" width="98" height="32" rx="5"
        fill="#fef3c7" stroke="#d97706" stroke-width="1.25"/>
      <text x="53" y="202" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#92400e">Swell factor: +20%</text>
      <text x="53" y="214" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#b45309">Volume × (1 + swell)</text>

      <!-- ══ DUMP TRUCK ═══════════════════════════════════════════ -->
      <!-- Truck bed -->
      <rect x="448" y="220" width="72" height="32" rx="2"
        fill="url(#exTruck)" stroke="#b45309" stroke-width="1.25"/>
      <!-- Tailgate hint -->
      <line x1="448" y1="220" x2="448" y2="252" stroke="#92400e" stroke-width="2"/>
      <!-- Soil in truck bed -->
      <path d="M 450,220 Q 484,208 518,220 Z"
        fill="url(#exSoil)" stroke="#92400e" stroke-width="1"/>
      <path d="M 450,220 Q 484,208 518,220 Z"
        fill="url(#exDirt)" opacity="0.5"/>
      <!-- Cab -->
      <rect x="518" y="228" width="18" height="24" rx="2"
        fill="#fbbf24" stroke="#d97706" stroke-width="1"/>
      <rect x="521" y="230" width="12" height="8" rx="1"
        fill="#bfdbfe" stroke="#d97706" stroke-width="0.75"/>
      <!-- Wheels -->
      <circle cx="464" cy="255" r="8" fill="#374151" stroke="#1f2937" stroke-width="1"/>
      <circle cx="464" cy="255" r="4" fill="#6b7280"/>
      <circle cx="506" cy="255" r="8" fill="#374151" stroke="#1f2937" stroke-width="1"/>
      <circle cx="506" cy="255" r="4" fill="#6b7280"/>
      <circle cx="528" cy="255" r="8" fill="#374151" stroke="#1f2937" stroke-width="1"/>
      <circle cx="528" cy="255" r="4" fill="#6b7280"/>
      <!-- Truck label -->
      <text x="484" y="275" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#78350f">Dump truck</text>
      <text x="484" y="286" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#92400e" opacity="0.85">10–14 yd³ capacity</text>

      <!-- Arrow from soil pile to truck -->
      <path d="M 100,185 Q 140,200 160,210 Q 300,240 445,238"
        fill="none" stroke="#d97706" stroke-width="1.5" stroke-dasharray="5 3" opacity="0.7"/>
      <polygon points="445,238 432,233 433,243" fill="#d97706" opacity="0.7"/>

      <!-- SOIL REMOVAL annotation -->
      <text x="270" y="240" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="600" fill="#d97706" opacity="0.85">soil removal →</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Excavation volume = Length × Width × Depth (bank volume). Expanded (loose) volume = bank × (1 + swell factor). Truckloads = ⌈expanded volume ÷ truck capacity⌉. Always round truckloads up.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 540px;
    height: auto;
    aspect-ratio: 540 / 330;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
