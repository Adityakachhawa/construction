---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="excavation-diagram-caption" title="Excavation Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 212" role="img" aria-label="Section through undisturbed soil and a pile of loose spoil">
    <path d="M18 58h34v80h136V58h25" fill="none" stroke="#244858" stroke-width="1.6" />
    <rect x="53" y="59" width="134" height="78" fill="#d3c2aa" stroke="#244858" stroke-width="1.5"/>
    <text x="120" y="106" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">In-place soil</text>
    <path d="M207 58V138m-5 0h10M202 58h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="217" y="103" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Depth</text>
    <path d="M52 189l41-40 25 16 14-11 43 35Z" fill="#efd5ae" stroke="#244858" stroke-width="1.6" />
    <text x="194" y="184" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Loose excavated soil</text>
  </svg>
  <span slot="caption">Measure undisturbed excavation length, width, and depth. Apply the swell factor to estimate loose material for hauling.</span>
</DiagramFrame>
