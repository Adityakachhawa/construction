---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="paver-base-diagram-caption" title="Paver Base Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 238" role="img" aria-label="Section through pavers, bedding sand and base">
    <rect x="38" y="44" width="212" height="38" fill="#d0dbe0" stroke="#244858" stroke-width="1.5"/>
    <rect x="38" y="82" width="212" height="27" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <rect x="38" y="109" width="212" height="65" fill="#d3c2aa" stroke="#244858" stroke-width="1.5"/>
    <rect x="38" y="174" width="212" height="28" fill="#dedbd3" stroke="#244858" stroke-width="1.5"/>
    <text x="145" y="69" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Pavers</text>
    <text x="145" y="102" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Bedding sand</text>
    <text x="145" y="148" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Compacted base</text>
    <text x="145" y="194" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Existing soil</text>
    <path d="M263 82V109m-5 0h10M258 82h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="273" y="100.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Sand depth</text>
    <path d="M263 109V174m-5 0h10M258 109h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="273" y="146.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Base depth</text>
  </svg>
  <span slot="caption">Measure paved length and width from above. Enter bedding sand and gravel base depths separately; paver thickness belongs to neither layer.</span>
</DiagramFrame>
