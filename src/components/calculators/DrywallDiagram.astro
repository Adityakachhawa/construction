---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="drywall-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="7.5" y="1" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="1" y="7.5" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="7.5" y="7.5" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    </span>
    <h2 id="drywall-diagram-caption" class="diagram-title">Drywall Sheet Layout</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="drywallGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f8fafc"/>
          <stop offset="100%" stop-color="#e2e8f0"/>
        </linearGradient>
        <linearGradient id="drywallGradAlt" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f1f5f9"/>
          <stop offset="100%" stop-color="#cbd5e1"/>
        </linearGradient>
        <filter id="sheetShadow" x="-5%" y="-5%" width="110%" height="115%">
          <feDropShadow dx="1" dy="2" stdDeviation="2" flood-color="#94a3b8" flood-opacity="0.25"/>
        </filter>
      </defs>

      <!-- â”€â”€ WALL FRAME â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <!-- Wall background / stud cavity -->
      <rect x="48" y="32" width="380" height="240" fill="#e7e5e4" rx="2" opacity="0.5"/>

      <!-- Studs (vertical, every ~4 ft = ~80px at this scale) -->
      <rect x="48"  y="32" width="6"  height="240" fill="#a8a29e" opacity="0.6"/>
      <rect x="126" y="32" width="6"  height="240" fill="#a8a29e" opacity="0.6"/>
      <rect x="206" y="32" width="6"  height="240" fill="#a8a29e" opacity="0.6"/>
      <rect x="286" y="32" width="6"  height="240" fill="#a8a29e" opacity="0.6"/>
      <rect x="366" y="32" width="6"  height="240" fill="#a8a29e" opacity="0.6"/>
      <rect x="422" y="32" width="6"  height="240" fill="#a8a29e" opacity="0.6"/>

      <!-- Top plate -->
      <rect x="42" y="26" width="392" height="8" fill="#a8a29e" opacity="0.7" rx="1"/>
      <!-- Bottom plate -->
      <rect x="42" y="268" width="392" height="8" fill="#a8a29e" opacity="0.7" rx="1"/>

      <!-- â”€â”€ DRYWALL SHEETS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->

      <!-- Row 1: 3 full sheets + 1 partial -->
      <!-- Sheet 1,1 -->
      <rect x="54" y="32" width="72" height="156" fill="url(#drywallGrad)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 1,2 -->
      <rect x="132" y="32" width="72" height="156" fill="url(#drywallGradAlt)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 1,3 -->
      <rect x="212" y="32" width="72" height="156" fill="url(#drywallGrad)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 1,4 -->
      <rect x="292" y="32" width="72" height="156" fill="url(#drywallGradAlt)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 1,5 (partial - cut) -->
      <rect x="372" y="32" width="48" height="156" fill="#fef3c7" stroke="#f59e0b" stroke-width="1.25" stroke-dasharray="4 3" filter="url(#sheetShadow)" opacity="0.85"/>
      <text x="396" y="118" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="600" fill="#d97706">cut</text>

      <!-- Row 2: 3 full sheets + 1 partial -->
      <!-- Sheet 2,1 -->
      <rect x="54" y="188" width="72" height="84" fill="url(#drywallGradAlt)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 2,2 -->
      <rect x="132" y="188" width="72" height="84" fill="url(#drywallGrad)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 2,3 -->
      <rect x="212" y="188" width="72" height="84" fill="url(#drywallGradAlt)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 2,4 -->
      <rect x="292" y="188" width="72" height="84" fill="url(#drywallGrad)" stroke="#94a3b8" stroke-width="1.25" filter="url(#sheetShadow)"/>
      <!-- Sheet 2,5 (partial) -->
      <rect x="372" y="188" width="48" height="84" fill="#fef3c7" stroke="#f59e0b" stroke-width="1.25" stroke-dasharray="4 3" filter="url(#sheetShadow)" opacity="0.85"/>

      <!-- â”€â”€ SEAM TAPE indicator (horizontal seam, row boundary) â”€â”€ -->
      <line x1="54" y1="188" x2="420" y2="188" stroke="#0070f3" stroke-width="2" stroke-dasharray="6 3" opacity="0.55"/>
      <text x="440" y="192" font-family="Inter,system-ui,sans-serif" font-size="9" font-weight="600" fill="#0070f3" opacity="0.8">seam</text>

      <!-- â”€â”€ SHEET NUMBER labels â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <text x="90"  y="114" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">1</text>
      <text x="168" y="114" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">2</text>
      <text x="248" y="114" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">3</text>
      <text x="328" y="114" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">4</text>
      <text x="90"  y="234" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">5</text>
      <text x="168" y="234" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">6</text>
      <text x="248" y="234" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">7</text>
      <text x="328" y="234" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="700" fill="#475569">8</text>

      <!-- â”€â”€ HEIGHT annotation (left, green) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="34" y1="32"  x2="44" y2="32"  stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="34" y1="272" x2="44" y2="272" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="38" y1="32"  x2="38" y2="272" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="38,32  33,43  43,43"  fill="#16a34a"/>
      <polygon points="38,272 33,261 43,261" fill="#16a34a"/>
      <text x="24" y="158" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(-90 24 158)">Wall Height</text>

      <!-- â”€â”€ WIDTH annotation (top, blue) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="54"  y1="16" x2="54"  y2="26" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="420" y1="16" x2="420" y2="26" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="54"  y1="20" x2="420" y2="20" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="54,20  64,15  64,25"  fill="#0070f3"/>
      <polygon points="420,20 410,15 410,25" fill="#0070f3"/>
      <text x="237" y="10" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Wall Width</text>

      <!-- â”€â”€ SHEET WIDTH annotation (between sheets 1 & 2, bottom) â”€â”€ -->
      <line x1="54"  y1="282" x2="54"  y2="274" stroke="#7c3aed" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
      <line x1="126" y1="282" x2="126" y2="274" stroke="#7c3aed" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
      <line x1="54"  y1="286" x2="126" y2="286" stroke="#7c3aed" stroke-width="1.5"/>
      <polygon points="54,286  64,281  64,291"  fill="#7c3aed"/>
      <polygon points="126,286 116,281 116,291" fill="#7c3aed"/>
      <text x="90" y="298" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="700" fill="#7c3aed">4 ft sheet</text>

      <!-- â”€â”€ LEGEND â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="334" y="258" width="14" height="10" fill="url(#drywallGrad)" stroke="#94a3b8" stroke-width="1" rx="1"/>
      <text x="352" y="267" font-family="Inter,system-ui,sans-serif" font-size="10" fill="#4b5563">Full sheet</text>
      <rect x="334" y="274" width="14" height="10" fill="#fef3c7" stroke="#f59e0b" stroke-width="1" stroke-dasharray="3 2" rx="1"/>
      <text x="352" y="283" font-family="Inter,system-ui,sans-serif" font-size="10" fill="#4b5563">Cut piece (waste)</text>
      <!-- ── FORMULA CALLOUT ─────────────────────────── -->
      <rect x="30" y="258" width="200" height="34" rx="6"
        fill="#eff6ff" stroke="#0070f3" stroke-width="1"/>
      <text x="130" y="271" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#1d4ed8" letter-spacing="0.2">SHEET COUNT</text>
      <text x="130" y="284" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="800" fill="#1e3a8a">Sheets = ⌈Area ÷ 32 ft²⌉ × (1 + Waste)</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Drywall sheets laid out horizontally across wall studs. Cut pieces at edges contribute to the 10% waste factor — order sheets accordingly.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
