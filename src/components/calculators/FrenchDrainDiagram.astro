---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="french-drain-diagram-caption" title="French Drain Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 247" role="img" aria-label="Section across a trench showing pipe and surrounding gravel">
    <path d="M24 59h42v147h153V59h35" fill="none" stroke="#244858" stroke-width="1.6" />
    <rect x="67" y="60" width="151" height="145" fill="#d0dbe0" stroke="#244858" stroke-width="1.5"/>
    <circle cx="143" cy="151" r="27" fill="white" stroke="#244858" stroke-width="3"/>
    <path d="M66 48H219m0 -5v10M66 43v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="142.5" y="39" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Trench width</text>
    <path d="M253 59V206m-5 0h10M248 59h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="263" y="137.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Depth</text>
    <text x="142" y="103" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Gravel</text>
    <text x="143" y="156" text-anchor="middle" font-size="14" font-weight="600" fill="#244858">Pipe</text>
  </svg>
  <span slot="caption">Measure length along the trench and width across it. Measure depth vertically and pipe diameter across the outside. The pipe occupies part of the trench volume.</span>
</DiagramFrame>
