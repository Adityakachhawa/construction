---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="grout-diagram-caption" title="Grout Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 324" role="img" aria-label="Tile face above and enlarged section through the grout joint below">
    <text x="16" y="25" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Top view · one tile</text>
    <rect x="54" y="63" width="158" height="83" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <path d="M54 55H212m0 -5v10M54 50v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="133" y="46" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Tile length</text>
    <path d="M231 63V146m-5 0h10M226 63h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="241" y="109.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Tile width</text>
    <text x="16" y="185" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Side view · joint enlarged</text>
    <rect x="28" y="235" width="96" height="48" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <rect x="156" y="235" width="96" height="48" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <rect x="124" y="235" width="32" height="48" fill="#d3c2aa" stroke="#244858" stroke-width="1.5"/>
    <path d="M124 224H156m0 -5v10M124 219v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="140" y="215" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Joint width</text>
    <path d="M263 235V283m-5 0h10M258 235h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="273" y="264" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Tile thickness</text>
    <text x="140" y="310" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Grout between tile edges</text>
  </svg>
  <span slot="caption">Measure one tile face and the clear gap between tiles. The calculator models grout filling the joint to the entered tile thickness. Use the selected grout product’s mixed yield for a bag estimate.</span>
</DiagramFrame>
