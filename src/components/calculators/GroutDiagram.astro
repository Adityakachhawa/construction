---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="grout-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="5" height="5" rx="0.5" fill="currentColor" opacity="0.85"/>
        <rect x="8" y="1" width="5" height="5" rx="0.5" fill="currentColor" opacity="0.85"/>
        <rect x="1" y="8" width="5" height="5" rx="0.5" fill="currentColor" opacity="0.5"/>
        <rect x="8" y="8" width="5" height="5" rx="0.5" fill="currentColor" opacity="0.5"/>
      </svg>
    </span>
    <h2 id="grout-diagram-caption" class="diagram-title">Grout Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 520 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <!-- Tile A gradient (slightly darker) -->
        <linearGradient id="gTileA" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#f3f4f6"/>
          <stop offset="100%" stop-color="#e5e7eb"/>
        </linearGradient>
        <!-- Tile B gradient (slightly lighter) -->
        <linearGradient id="gTileB" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#f9fafb"/>
          <stop offset="100%" stop-color="#f3f4f6"/>
        </linearGradient>
        <!-- Bag gradient -->
        <linearGradient id="gBag" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#f1f5f9"/>
          <stop offset="100%" stop-color="#e2e8f0"/>
        </linearGradient>
      </defs>

      <!-- ══ GROUT BACKGROUND (fills entire grid area, joints are visible as gaps) ══ -->
      <!-- Grid: x=50 to x=390, y=40 to y=230 — grout color fills behind tiles -->
      <rect x="50" y="40" width="340" height="190" rx="3" fill="#9ca3af"/>

      <!-- ══ TILES: 4 columns × 3 rows ══
           Tile size: 80×60 px, joint gap: 5 px
           Column x-offsets: 55, 140, 225, 310
           Row y-offsets:    45, 110, 175
      ══ -->

      <!-- Row 1 -->
      <!-- Tile (0,0) -->
      <rect x="55"  y="45" width="80" height="60" fill="url(#gTileA)" rx="1"/>
      <!-- Tile (1,0) -->
      <rect x="140" y="45" width="80" height="60" fill="url(#gTileB)" rx="1"/>
      <!-- Tile (2,0) -->
      <rect x="225" y="45" width="80" height="60" fill="url(#gTileA)" rx="1"/>
      <!-- Tile (3,0) -->
      <rect x="310" y="45" width="80" height="60" fill="url(#gTileB)" rx="1"/>

      <!-- Row 2 -->
      <!-- Tile (0,1) -->
      <rect x="55"  y="110" width="80" height="60" fill="url(#gTileB)" rx="1"/>
      <!-- Tile (1,1) -->
      <rect x="140" y="110" width="80" height="60" fill="url(#gTileA)" rx="1"/>
      <!-- Tile (2,1) -->
      <rect x="225" y="110" width="80" height="60" fill="url(#gTileB)" rx="1"/>
      <!-- Tile (3,1) -->
      <rect x="310" y="110" width="80" height="60" fill="url(#gTileA)" rx="1"/>

      <!-- Row 3 -->
      <!-- Tile (0,2) -->
      <rect x="55"  y="175" width="80" height="60" fill="url(#gTileA)" rx="1"/>
      <!-- Tile (1,2) -->
      <rect x="140" y="175" width="80" height="60" fill="url(#gTileB)" rx="1"/>
      <!-- Tile (2,2) -->
      <rect x="225" y="175" width="80" height="60" fill="url(#gTileA)" rx="1"/>
      <!-- Tile (3,2) -->
      <rect x="310" y="175" width="80" height="60" fill="url(#gTileB)" rx="1"/>

      <!-- ══ ANNOTATIONS ══════════════════════════════════════════════════ -->

      <!-- Tile L × Tile W label inside first tile -->
      <rect x="57" y="55" width="76" height="22" rx="3"
        fill="#dbeafe" stroke="#3b82f6" stroke-width="1"/>
      <text x="95" y="70" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#1d4ed8">Tile L × Tile W</text>

      <!-- Joint width callout — amber, pointing at horizontal joint between col 0 and col 1, row 1 -->
      <!-- The joint is at x=135 (between tile ending at 135 and starting at 140), y=45..105 -->
      <!-- Arrow points into the vertical joint at x=137.5, y=75 -->
      <line x1="137" y1="75" x2="118" y2="55" stroke="#d97706" stroke-width="1.25"/>
      <circle cx="137" cy="75" r="2.5" fill="#d97706"/>
      <rect x="56" y="27" width="66" height="18" rx="4"
        fill="#fffbeb" stroke="#d97706" stroke-width="1.25"/>
      <text x="89" y="40" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#92400e">Joint width</text>
      <!-- Double arrow inside joint gap (x=135..140, showing the 5px gap) -->
      <line x1="135" y1="75" x2="140" y2="75" stroke="#d97706" stroke-width="1.5"/>
      <polygon points="135,75 138,72 138,78" fill="#d97706"/>
      <polygon points="140,75 137,72 137,78" fill="#d97706"/>

      <!-- Total Area double arrow along bottom (y=242, x=50..390) -->
      <line x1="50" y1="242" x2="390" y2="242" stroke="#16a34a" stroke-width="1.75"/>
      <line x1="50"  y1="236" x2="50"  y2="248" stroke="#16a34a" stroke-width="1.25"/>
      <line x1="390" y1="236" x2="390" y2="248" stroke="#16a34a" stroke-width="1.25"/>
      <polygon points="50,242  62,237  62,247"  fill="#16a34a"/>
      <polygon points="390,242 378,237 378,247" fill="#16a34a"/>
      <text x="220" y="258" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="10" font-weight="700" fill="#16a34a">Total Area (ft²)</text>

      <!-- Formula box below grid -->
      <rect x="50" y="268" width="340" height="26" rx="5"
        fill="#fffbeb" stroke="#d97706" stroke-width="1.5"/>
      <text x="220" y="280" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#92400e">Grout Volume = Area × (Joint W × Tile Depth × Joint Length per ft²)</text>
      <text x="220" y="291" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#b45309" opacity="0.9">e.g. 100 ft² of 12×12, 1/8″ joint, 3/8″ deep → ≈ 0.26 ft³ net</text>

      <!-- ══ RIGHT SIDE LEGEND (x=405..510) ══════════════════════════ -->

      <!-- Legend title -->
      <text x="457" y="52" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#374151">Legend</text>

      <!-- Grout joint swatch -->
      <rect x="408" y="58" width="14" height="14" rx="2" fill="#9ca3af" stroke="#6b7280" stroke-width="0.75"/>
      <text x="428" y="69" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="600" fill="#374151">Grout joint</text>

      <!-- Tile swatch -->
      <rect x="408" y="78" width="14" height="14" rx="2" fill="url(#gTileA)" stroke="#d1d5db" stroke-width="0.75"/>
      <text x="428" y="89" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="600" fill="#374151">Tile</text>

      <!-- Divider -->
      <line x1="405" y1="100" x2="510" y2="100" stroke="#e5e7eb" stroke-width="1"/>

      <!-- Bag stack: 2 bags labeled 25 lb -->
      <text x="457" y="115" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#6b7280">0.45 ft³ each</text>

      <!-- Bag 1 (bottom) -->
      <rect x="407" y="118" width="100" height="28" rx="5"
        fill="url(#gBag)" stroke="#94a3b8" stroke-width="1.25"/>
      <rect x="412" y="121" width="90" height="22" rx="3"
        fill="none" stroke="#cbd5e1" stroke-width="0.75" stroke-dasharray="3,2"/>
      <text x="457" y="132" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="800" fill="#374151">25 lb</text>
      <text x="457" y="142" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7" font-weight="600" fill="#6b7280">GROUT</text>

      <!-- Bag 2 (top) -->
      <rect x="407" y="88" width="100" height="28" rx="5"
        fill="url(#gBag)" stroke="#94a3b8" stroke-width="1.25"/>
      <rect x="412" y="91" width="90" height="22" rx="3"
        fill="none" stroke="#cbd5e1" stroke-width="0.75" stroke-dasharray="3,2"/>
      <text x="457" y="102" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="800" fill="#374151">25 lb</text>
      <text x="457" y="112" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7" font-weight="600" fill="#6b7280">GROUT</text>

      <!-- Divider -->
      <line x1="405" y1="153" x2="510" y2="153" stroke="#e5e7eb" stroke-width="1"/>

      <!-- Bags formula box -->
      <rect x="405" y="158" width="106" height="36" rx="5"
        fill="#f0fdf4" stroke="#16a34a" stroke-width="1.25"/>
      <text x="458" y="172" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#15803d">Bags = ⌈Grout ÷ Yield⌉</text>
      <text x="458" y="183" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#16a34a" opacity="0.9">always round up ⌈ ⌉</text>
      <text x="458" y="191" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7" fill="#15803d" opacity="0.8">incl. waste factor</text>

      <!-- ══ MAGNIFIED JOINT DETAIL (right panel, below bags formula) ══ -->
      <line x1="405" y1="200" x2="510" y2="200" stroke="#e5e7eb" stroke-width="1"/>
      <text x="457" y="212" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#374151">Joint detail ×10</text>
      <!-- Magnified view frame -->
      <rect x="408" y="217" width="98" height="52" rx="4"
        fill="#f9fafb" stroke="#d97706" stroke-width="1.5"/>
      <!-- Left tile face -->
      <rect x="411" y="220" width="34" height="46" fill="url(#gTileA)" stroke="#d1d5db" stroke-width="0.75" rx="1"/>
      <!-- Grout joint (magnified: 14px wide gap) -->
      <rect x="445" y="220" width="14" height="46" fill="#9ca3af"/>
      <!-- Right tile face -->
      <rect x="459" y="220" width="44" height="46" fill="url(#gTileB)" stroke="#d1d5db" stroke-width="0.75" rx="1"/>
      <!-- Joint width double arrow -->
      <line x1="446" y1="243" x2="458" y2="243" stroke="#d97706" stroke-width="1.5"/>
      <polygon points="446,243 449,240 449,246" fill="#d97706"/>
      <polygon points="458,243 455,240 455,246" fill="#d97706"/>
      <!-- Joint width label below frame -->
      <text x="452" y="281" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="700" fill="#92400e">Joint width</text>

    </svg>
  </div>
  <figcaption class="diagram-caption">
    Tile floor with grout joints. Grout volume = (Joint Width × Tile Depth × Joint Length per ft²) × Total Area. Bags required = ⌈Adjusted Volume ÷ Yield per Bag⌉.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 520px;
    height: auto;
    aspect-ratio: 520 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
