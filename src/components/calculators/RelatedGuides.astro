---
import type { CollectionEntry } from 'astro:content';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
if (!posts || posts.length === 0) return null;
---

<section class="related-guides-section">
  <div class="section-header">
    <h2 class="section-title">Related Construction Guides & Walkthroughs</h2>
    <p class="section-sub">Step-by-step jobsite advice, code requirements, and material breakdowns</p>
  </div>
  <div class="guides-grid">
    {posts.map((post) => {
      const slug = post.id.replace(/\.[^.]+$/, '');
      const tag = post.data.tags?.[0] ?? 'Guide';
      return (
        <a href={`/blog/${slug}/`} class="guide-card">
          <span class="guide-tag">{tag}</span>
          <h3 class="guide-title">{post.data.title}</h3>
          <p class="guide-desc">{post.data.description}</p>
          <span class="guide-cta">
            Read guide
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
              <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </a>
      );
    })}
  </div>
</section>

<style>
  .related-guides-section {
    margin: 3rem 0 2rem;
  }
  .section-header {
    margin-bottom: 1.5rem;
  }
  .section-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.375rem;
  }
  .section-sub {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
  }
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .guide-card {
    display: flex;
    flex-direction: column;
    padding: 1.25rem;
    background: white;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .guide-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.08);
    border-color: var(--color-primary-300, #fdba74);
  }
  .guide-tag {
    align-self: flex-start;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: capitalize;
    background: var(--color-bg-secondary, #f8fafc);
    color: var(--color-text-secondary);
    margin-bottom: 0.75rem;
    border: 1px solid var(--color-border-subtle, #f1f5f9);
  }
  .guide-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.4;
    margin-bottom: 0.5rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .guide-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .guide-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: gap 0.15s ease;
  }
  .guide-card:hover .guide-cta {
    gap: 0.5rem;
  }
</style>
