---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="retaining-wall-diagram-caption" title="Retaining Wall Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 215" role="img" aria-label="Side section showing wall height, base and backfill">
    <rect x="62" y="60" width="56" height="96" fill="#d0dbe0" stroke="#244858" stroke-width="1.5"/>
    <rect x="118" y="76" width="116" height="80" fill="#d3c2aa" stroke="#244858" stroke-width="1.5"/>
    <rect x="43" y="156" width="191" height="22" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <path d="M63 92h55m-55 32h55" fill="none" stroke="#244858" stroke-width="1.6" />
    <text x="177" y="124" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Backfill</text>
    <text x="136" y="173" text-anchor="middle" font-size="14" font-weight="600" fill="#244858">Base</text>
    <path d="M252 60V156m-5 0h10M247 60h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="262" y="113" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Wall height</text>
  </svg>
  <span slot="caption">Measure wall length along its face and height over the section being estimated. Take base, drainage, and reinforcement details from the project design.</span>
</DiagramFrame>
