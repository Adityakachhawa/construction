---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="deck-footing-diagram-caption" title="Deck Footing Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 360" role="img" aria-label="Example footing plan and a section through one hole">
    <text x="16" y="24" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Top view · deck footprint</text>
    <rect x="38" y="64" width="224" height="69" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <circle cx="51" cy="78" r="5" fill="#244858"/>
    <circle cx="51" cy="119" r="5" fill="#244858"/>
    <circle cx="150" cy="78" r="5" fill="#244858"/>
    <circle cx="150" cy="119" r="5" fill="#244858"/>
    <circle cx="249" cy="78" r="5" fill="#244858"/>
    <circle cx="249" cy="119" r="5" fill="#244858"/>
    <path d="M51 52H150m0 -5v10M51 47v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="100.5" y="43" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Spacing</text>
    <path d="M278 64V133m-5 0h10M273 64h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="288" y="103.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Deck width</text>
    <path d="M38 169H262m0 -5v10M38 164v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="150" y="160" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Deck length</text>
    <text x="16" y="207" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Side view · one footing</text>
    <rect x="60" y="247" width="110" height="86" fill="#d0dbe0" stroke="#244858" stroke-width="1.5"/>
    <path d="M20 247H60m110 0h68" fill="none" stroke="#244858" stroke-width="1.6" />
    <path d="M60 238H170m0 -5v10M60 233v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="115" y="229" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Diameter</text>
    <path d="M251 247V333m-5 0h10M246 247h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="261" y="295" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Depth</text>
    <text x="44" y="269" text-anchor="middle" font-size="13" font-weight="600" fill="#244858">Grade</text>
  </svg>
  <span slot="caption">Measure footing spacing from center to center. Measure diameter across the hole and depth from grade to the bottom. Use your approved plan for the support positions and footing dimensions.</span>
</DiagramFrame>
