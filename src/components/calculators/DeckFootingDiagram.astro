---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="deck-footing-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <circle cx="4" cy="10" r="2.5" stroke="currentColor" stroke-width="1.25"/>
        <circle cx="10" cy="10" r="2.5" stroke="currentColor" stroke-width="1.25"/>
        <circle cx="7" cy="4" r="2.5" stroke="currentColor" stroke-width="1.25"/>
        <line x1="4" y1="7.5" x2="4" y2="10" stroke="currentColor" stroke-width="1.25"/>
        <line x1="10" y1="7.5" x2="10" y2="10" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    </span>
    <h2 id="deck-footing-diagram-caption" class="diagram-title">Deck Footing Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="dirtGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c8a96e"/>
          <stop offset="100%" stop-color="#8b6840"/>
        </linearGradient>
        <linearGradient id="concreteFooting" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#b0b8c4"/>
          <stop offset="100%" stop-color="#8090a0"/>
        </linearGradient>
        <linearGradient id="grassGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#7cac5a"/>
          <stop offset="100%" stop-color="#4a7a2a"/>
        </linearGradient>
        <linearGradient id="postWood" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#a0744a"/>
          <stop offset="100%" stop-color="#7a5230"/>
        </linearGradient>
        <!-- Tube form pattern -->
        <pattern id="tubeHatch" x="0" y="0" width="6" height="6" patternUnits="userSpaceOnUse">
          <line x1="0" y1="6" x2="6" y2="0" stroke="#8090a0" stroke-width="0.6" opacity="0.4"/>
        </pattern>
      </defs>

      <!-- â”€â”€ GROUND CROSS-SECTION (left side) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->

      <!-- Soil block -->
      <rect x="30" y="130" width="190" height="140" fill="url(#dirtGrad)" opacity="0.5" rx="2"/>

      <!-- Ground surface -->
      <rect x="30" y="118" width="190" height="14" fill="url(#grassGrad)" rx="2" opacity="0.9"/>

      <!-- Footing hole 1 (left) -->
      <rect x="64" y="132" width="36" height="120" fill="url(#concreteFooting)" rx="3" opacity="0.9"/>
      <rect x="64" y="132" width="36" height="120" fill="url(#tubeHatch)" rx="3"/>
      <!-- Post above ground -->
      <rect x="72" y="60" width="20" height="58" fill="url(#postWood)" rx="2"/>
      <rect x="70" y="58" width="24" height="5" rx="2" fill="#5a3a20"/>

      <!-- Footing hole 2 (right) -->
      <rect x="160" y="132" width="36" height="120" fill="url(#concreteFooting)" rx="3" opacity="0.9"/>
      <rect x="160" y="132" width="36" height="120" fill="url(#tubeHatch)" rx="3"/>
      <!-- Post above ground -->
      <rect x="168" y="60" width="20" height="58" fill="url(#postWood)" rx="2"/>
      <rect x="166" y="58" width="24" height="5" rx="2" fill="#5a3a20"/>

      <!-- Beam across posts -->
      <rect x="68" y="42" width="136" height="18" rx="3" fill="#c89060"/>

      <!-- Grade line label -->
      <line x1="30" y1="118" x2="28" y2="118" stroke="#4a7a2a" stroke-width="1"/>
      <text x="26" y="115" text-anchor="end" font-family="Inter,system-ui,sans-serif"
        font-size="10" font-weight="600" fill="#4a7a2a">Grade</text>

      <!-- Frost line dashed -->
      <line x1="30" y1="210" x2="220" y2="210" stroke="#6b7280" stroke-width="1"
        stroke-dasharray="5 3" opacity="0.55"/>
      <text x="28" y="208" text-anchor="end" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="500" fill="#6b7280">Frost</text>
      <text x="28" y="218" text-anchor="end" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="500" fill="#6b7280">line</text>

      <!-- â”€â”€ DEPTH annotation (right of section, orange) â”€â”€ -->
      <line x1="205" y1="118" x2="225" y2="118" stroke="#d97706" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="205" y1="252" x2="225" y2="252" stroke="#d97706" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="220" y1="118" x2="220" y2="252" stroke="#d97706" stroke-width="1.75"/>
      <polygon points="220,118 215,129 225,129" fill="#d97706"/>
      <polygon points="220,252 215,241 225,241" fill="#d97706"/>
      <text x="238" y="191" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#d97706" letter-spacing="-0.3"
        transform="rotate(90 238 191)">Depth</text>

      <!-- â”€â”€ DIAMETER annotation (bottom of left footing, green) â”€â”€ -->
      <line x1="64" y1="262" x2="64" y2="272" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="100" y1="262" x2="100" y2="272" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="64" y1="268" x2="100" y2="268" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="64,268 74,263 74,273" fill="#16a34a"/>
      <polygon points="100,268 90,263 90,273" fill="#16a34a"/>
      <text x="82" y="284" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#16a34a" letter-spacing="-0.3">Dia.</text>

      <!-- â”€â”€ FOOTING SPACING annotation (top, blue) â”€â”€ -->
      <line x1="82" y1="34" x2="82" y2="42" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="178" y1="34" x2="178" y2="42" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="82" y1="38" x2="178" y2="38" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="82,38 92,33 92,43" fill="#0070f3"/>
      <polygon points="178,38 168,33 168,43" fill="#0070f3"/>
      <text x="130" y="26" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Spacing</text>

      <!-- â”€â”€ PLAN VIEW (right side) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <text x="295" y="35" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="600" fill="#6b7280" letter-spacing="0.05em">PLAN VIEW</text>

      <!-- Deck outline -->
      <rect x="255" y="45" width="190" height="140" rx="4"
        fill="none" stroke="#c89060" stroke-width="1.5" stroke-dasharray="6 3" opacity="0.7"/>

      <!-- 6 footing circles in a 3Ã—2 grid -->
      <!-- Row 1 -->
      <circle cx="275" cy="65"  r="10" fill="url(#concreteFooting)" stroke="#6b7280" stroke-width="1.2" opacity="0.9"/>
      <circle cx="350" cy="65"  r="10" fill="url(#concreteFooting)" stroke="#6b7280" stroke-width="1.2" opacity="0.9"/>
      <circle cx="425" cy="65"  r="10" fill="url(#concreteFooting)" stroke="#6b7280" stroke-width="1.2" opacity="0.9"/>
      <!-- Row 2 -->
      <circle cx="275" cy="165" r="10" fill="url(#concreteFooting)" stroke="#6b7280" stroke-width="1.2" opacity="0.9"/>
      <circle cx="350" cy="165" r="10" fill="url(#concreteFooting)" stroke="#6b7280" stroke-width="1.2" opacity="0.9"/>
      <circle cx="425" cy="165" r="10" fill="url(#concreteFooting)" stroke="#6b7280" stroke-width="1.2" opacity="0.9"/>

      <!-- Deck length arrow (blue, bottom of plan) -->
      <line x1="255" y1="200" x2="445" y2="200" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="255,200 265,195 265,205" fill="#0070f3"/>
      <polygon points="445,200 435,195 435,205" fill="#0070f3"/>
      <text x="350" y="216" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Deck Length</text>

      <!-- Deck width arrow (green, right of plan) -->
      <line x1="456" y1="45" x2="456" y2="185" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="456,45 451,56 461,56" fill="#16a34a"/>
      <polygon points="456,185 451,174 461,174" fill="#16a34a"/>
      <text x="472" y="120" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(90 472 120)">Deck Width</text>
      <!-- ── FORMULA CALLOUT ─────────────────────────── -->
      <rect x="30" y="258" width="200" height="34" rx="6"
        fill="#eff6ff" stroke="#0070f3" stroke-width="1"/>
      <text x="130" y="271" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#1d4ed8" letter-spacing="0.2">FOOTING VOLUME</text>
      <text x="130" y="284" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="800" fill="#1e3a8a">V = π × r² × Depth × Count</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Left: cross-section showing footing depth, diameter, and frost line. Right: plan view showing footing grid across the deck footprint.
  </figcaption>
</figure>

<style>
  .diagram-figure {
    margin-top: 3.5rem;
  }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
