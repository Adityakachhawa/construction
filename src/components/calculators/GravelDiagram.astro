---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="gravel-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="1" y="6" width="12" height="7" rx="1" stroke="currentColor" stroke-width="1.25"/>
        <path d="M3 6V5a4 4 0 018 0v1" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      </svg>
    </span>
    <h2 id="gravel-diagram-caption" class="diagram-title">Gravel Area Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="gravelTop" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#d6c7a0"/>
          <stop offset="100%" stop-color="#b8a87a"/>
        </linearGradient>
        <linearGradient id="gravelFront" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#9e8c5e"/>
          <stop offset="100%" stop-color="#7a6a42"/>
        </linearGradient>
        <linearGradient id="gravelRight" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#8c7a50"/>
          <stop offset="100%" stop-color="#7a6a42"/>
        </linearGradient>
        <!-- Gravel texture pattern on top -->
        <pattern id="gravelPattern" x="0" y="0" width="16" height="16" patternUnits="userSpaceOnUse">
          <circle cx="4" cy="4" r="2.5" fill="#c4a96e" opacity="0.7"/>
          <circle cx="11" cy="4" r="2" fill="#b89a5a" opacity="0.6"/>
          <circle cx="7" cy="11" r="2.5" fill="#cdb47a" opacity="0.7"/>
          <circle cx="2" cy="12" r="1.5" fill="#b89a5a" opacity="0.5"/>
          <circle cx="13" cy="12" r="2" fill="#c4a96e" opacity="0.6"/>
        </pattern>
      </defs>

      <!-- Isometric gravel bed body -->
      <!-- Top face base -->
      <polygon points="90,100 330,100 395,148 155,148"
        fill="url(#gravelTop)" stroke="#7a6a42" stroke-width="1.5"/>
      <!-- Gravel texture overlay on top -->
      <polygon points="90,100 330,100 395,148 155,148"
        fill="url(#gravelPattern)" opacity="0.6"/>
      <!-- Front face -->
      <polygon points="90,100 90,220 155,220 155,148"
        fill="url(#gravelFront)" stroke="#7a6a42" stroke-width="1.5"/>
      <!-- Right face -->
      <polygon points="155,148 395,148 395,220 155,220"
        fill="url(#gravelRight)" stroke="#7a6a42" stroke-width="1.5"/>

      <!-- â”€â”€ LENGTH annotation (top, horizontal) â”€â”€ -->
      <line x1="90" y1="100" x2="90" y2="72" stroke="#0070f3" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="330" y1="100" x2="330" y2="72" stroke="#0070f3" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="90" y1="80" x2="330" y2="80" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="90,80 100,75 100,85" fill="#0070f3"/>
      <polygon points="330,80 320,75 320,85" fill="#0070f3"/>
      <text x="210" y="66" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Length</text>

      <!-- â”€â”€ WIDTH annotation (right side, diagonal) â”€â”€ -->
      <line x1="330" y1="100" x2="418" y2="76" stroke="#16a34a" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="395" y1="148" x2="418" y2="168" stroke="#16a34a" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="418" y1="76" x2="418" y2="168" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="418,76 413,87 423,87" fill="#16a34a"/>
      <polygon points="418,168 413,157 423,157" fill="#16a34a"/>
      <text x="432" y="126" text-anchor="start" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#16a34a" letter-spacing="-0.3">Width</text>

      <!-- â”€â”€ DEPTH annotation (left, vertical) â”€â”€ -->
      <line x1="90" y1="100" x2="55" y2="100" stroke="#d97706" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="90" y1="220" x2="55" y2="220" stroke="#d97706" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="62" y1="100" x2="62" y2="220" stroke="#d97706" stroke-width="1.75"/>
      <polygon points="62,100 57,111 67,111" fill="#d97706"/>
      <polygon points="62,220 57,209 67,209" fill="#d97706"/>
      <text x="48" y="162" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#d97706" letter-spacing="-0.3"
        transform="rotate(-90 48 162)">Depth</text>

      <!-- ── FORMULA CALLOUT ────────────────────────────────────── -->
      <rect x="128" y="252" width="168" height="40" rx="6"
        fill="#f0fdf4" stroke="#16a34a" stroke-width="1"/>
      <text x="212" y="264" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#14532d" letter-spacing="0.2">VOLUME FORMULA</text>
      <text x="212" y="277" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="10" font-weight="800" fill="#14532d">V = L × W × D</text>
      <text x="212" y="288" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" fill="#16a34a">÷ 27 = cu yd  ·  × 1.5 = tons (approx)</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Gravel bed: length × width × depth — enter each dimension above to calculate volume and weight.
  </figcaption>
</figure>

<style>
  .diagram-figure {
    margin-top: 3.5rem;
  }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
