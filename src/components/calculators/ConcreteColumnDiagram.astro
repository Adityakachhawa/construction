---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="column-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <ellipse cx="7" cy="3" rx="4" ry="1.5" stroke="currentColor" stroke-width="1.25"/>
        <line x1="3" y1="3" x2="3" y2="11" stroke="currentColor" stroke-width="1.25"/>
        <line x1="11" y1="3" x2="11" y2="11" stroke="currentColor" stroke-width="1.25"/>
        <ellipse cx="7" cy="11" rx="4" ry="1.5" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    </span>
    <h2 id="column-diagram-caption" class="diagram-title">Concrete Column Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="sonotubeGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%"   stop-color="#94a3b8"/>
          <stop offset="30%"  stop-color="#e2e8f0"/>
          <stop offset="60%"  stop-color="#cbd5e1"/>
          <stop offset="100%" stop-color="#94a3b8"/>
        </linearGradient>
        <linearGradient id="concreteGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%"   stop-color="#9ca3af"/>
          <stop offset="40%"  stop-color="#d1d5db"/>
          <stop offset="100%" stop-color="#9ca3af"/>
        </linearGradient>
        <linearGradient id="groundGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c8a96e"/>
          <stop offset="100%" stop-color="#8b6840"/>
        </linearGradient>
        <linearGradient id="skyGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#eff6ff"/>
          <stop offset="100%" stop-color="#dbeafe"/>
        </linearGradient>
        <!-- Concrete aggregate texture -->
        <pattern id="concreteTexture" x="0" y="0" width="14" height="14" patternUnits="userSpaceOnUse">
          <circle cx="3"  cy="3"  r="1.2" fill="#9ca3af" opacity="0.45"/>
          <circle cx="10" cy="7"  r="1"   fill="#6b7280" opacity="0.35"/>
          <circle cx="6"  cy="11" r="1.1" fill="#9ca3af" opacity="0.4"/>
          <circle cx="12" cy="2"  r="0.8" fill="#d1d5db" opacity="0.3"/>
        </pattern>
        <!-- Soil/ground hatch -->
        <pattern id="soilPattern" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
          <line x1="0" y1="10" x2="10" y2="0" stroke="#92400e" stroke-width="0.8" opacity="0.3"/>
        </pattern>
      </defs>

      <!-- â•â• BACKGROUND â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
      <!-- Sky / above-grade zone -->
      <rect x="0" y="0" width="480" height="180" fill="url(#skyGrad)" opacity="0.4"/>
      <!-- Ground zone -->
      <rect x="0" y="180" width="480" height="120" fill="url(#groundGrad)" opacity="0.3"/>
      <rect x="0" y="180" width="480" height="120" fill="url(#soilPattern)"/>
      <!-- Grade line -->
      <line x1="0" y1="180" x2="480" y2="180" stroke="#92400e" stroke-width="1.5" stroke-dasharray="8 4" opacity="0.5"/>
      <text x="450" y="176" font-family="Inter,system-ui,sans-serif" font-size="9" font-weight="600"
        fill="#92400e" opacity="0.7" text-anchor="end">grade</text>

      <!-- â•â• MAIN COLUMN (centred x=200, tube OD=80px) â•â•â•â• -->

      <!-- Sonotube cardboard form (outer cylinder body) -->
      <rect x="160" y="30" width="80" height="240" fill="url(#sonotubeGrad)" opacity="0.5"/>

      <!-- Concrete fill inside tube -->
      <rect x="168" y="34" width="64" height="232" fill="url(#concreteGrad)"/>
      <rect x="168" y="34" width="64" height="232" fill="url(#concreteTexture)" opacity="0.55"/>

      <!-- Rebar (2 vertical bars, red) -->
      <line x1="183" y1="38" x2="183" y2="262" stroke="#ef4444" stroke-width="3" stroke-linecap="round" opacity="0.85"/>
      <line x1="217" y1="38" x2="217" y2="262" stroke="#ef4444" stroke-width="3" stroke-linecap="round" opacity="0.85"/>

      <!-- Top ellipse (open top of tube) -->
      <ellipse cx="200" cy="34" rx="32" ry="9" fill="url(#concreteGrad)" stroke="#64748b" stroke-width="1.25"/>
      <ellipse cx="200" cy="34" rx="32" ry="9" fill="url(#concreteTexture)" opacity="0.4"/>

      <!-- Tube outer top rim -->
      <ellipse cx="200" cy="30" rx="40" ry="10" fill="none" stroke="#94a3b8" stroke-width="1.5" opacity="0.7"/>

      <!-- Bottom of tube / footing bell (slightly wider) -->
      <ellipse cx="200" cy="262" rx="46" ry="11" fill="#9ca3af" stroke="#64748b" stroke-width="1.25" opacity="0.7"/>

      <!-- Tube side outlines -->
      <line x1="160" y1="30" x2="160" y2="262" stroke="#94a3b8" stroke-width="1.5" opacity="0.6"/>
      <line x1="240" y1="30" x2="240" y2="262" stroke="#94a3b8" stroke-width="1.5" opacity="0.6"/>

      <!-- â•â• DIAMETER annotation (top, blue) â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
      <line x1="160" y1="16" x2="160" y2="28" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="240" y1="16" x2="240" y2="28" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="160" y1="20" x2="240" y2="20" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="160,20 170,15 170,25" fill="#0070f3"/>
      <polygon points="240,20 230,15 230,25" fill="#0070f3"/>
      <text x="200" y="10" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Diameter</text>

      <!-- â•â• HEIGHT annotation (left, green) â•â•â•â•â•â•â•â•â•â•â•â•â• -->
      <line x1="146" y1="30"  x2="158" y2="30"  stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="146" y1="262" x2="158" y2="262" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="150" y1="30"  x2="150" y2="262" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="150,30  145,41  155,41"  fill="#16a34a"/>
      <polygon points="150,262 145,251 155,251" fill="#16a34a"/>
      <text x="136" y="150" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(-90 136 150)">Height</text>

      <!-- â•â• SECOND COLUMN (ghost, offset right) â•â•â•â•â•â•â•â•â•â• -->
      <rect x="298" y="60" width="68" height="210" fill="url(#sonotubeGrad)" opacity="0.22"/>
      <rect x="305" y="64" width="54" height="202" fill="url(#concreteGrad)" opacity="0.3"/>
      <ellipse cx="332" cy="60"  rx="34" ry="8"  fill="none" stroke="#94a3b8" stroke-width="1" stroke-dasharray="5 3" opacity="0.4"/>
      <ellipse cx="332" cy="270" rx="38" ry="9"  fill="none" stroke="#94a3b8" stroke-width="1" stroke-dasharray="5 3" opacity="0.3"/>
      <line x1="298" y1="60" x2="298" y2="270" stroke="#94a3b8" stroke-width="1" stroke-dasharray="5 3" opacity="0.35"/>
      <line x1="366" y1="60" x2="366" y2="270" stroke="#94a3b8" stroke-width="1" stroke-dasharray="5 3" opacity="0.35"/>
      <text x="332" y="170" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="600" fill="#6b7280" opacity="0.6">column 2â€¦</text>

      <!-- â•â• LABELS â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
      <!-- Rebar label -->
      <line x1="217" y1="100" x2="270" y2="90" stroke="#ef4444" stroke-width="1" opacity="0.5"/>
      <text x="272" y="89" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="600" fill="#ef4444">Rebar</text>

      <!-- Concrete label -->
      <line x1="200" y1="130" x2="270" y2="120" stroke="#6b7280" stroke-width="1" opacity="0.4"/>
      <text x="272" y="119" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="600" fill="#4b5563">Concrete fill</text>

      <!-- Sonotube label -->
      <line x1="240" y1="155" x2="270" y2="150" stroke="#94a3b8" stroke-width="1" opacity="0.5"/>
      <text x="272" y="149" font-family="Inter,system-ui,sans-serif" font-size="10" font-weight="600" fill="#475569">Sonotube form</text>

      <!-- Grade label (left) -->
      <text x="58" y="176" font-family="Inter,system-ui,sans-serif" font-size="9" font-weight="600"
        fill="#92400e" opacity="0.65">â†‘ above grade</text>
      <text x="58" y="192" font-family="Inter,system-ui,sans-serif" font-size="9" font-weight="600"
        fill="#92400e" opacity="0.65">â†“ below grade</text>

      <!-- â•â• FORMULA REMINDER (bottom-left) â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
      <rect x="50" y="256" width="96" height="28" rx="6" fill="#f0f9ff" stroke="#bae6fd" stroke-width="1"/>
      <text x="98" y="268" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="9" fill="#0284c7">V = Ï€ Ã— rÂ² Ã— h</text>
      <text x="98" y="279" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="8" fill="#0369a1" opacity="0.8">Ã— No. of columns</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Concrete column (sonotube): diameter and height determine volume per column â€” multiply by the number of columns for total concrete and bags needed.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
