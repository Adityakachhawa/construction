---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="column-diagram-caption" title="Concrete Column Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 226" role="img" aria-label="Diameter across the circular end and vertical poured height">
    <rect x="67" y="68" width="132" height="122" fill="#d0dbe0" stroke="#244858" stroke-width="1.5"/>
    <ellipse cx="133" cy="68" rx="66" ry="14" fill="#e4ecee" stroke="#244858" stroke-width="1.5"/>
    <path d="M67 45H199m0 -5v10M67 40v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="133" y="36" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Diameter</text>
    <path d="M222 68V190m-5 0h10M217 68h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="232" y="134" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Height</text>
  </svg>
  <span slot="caption">Measure the inside diameter across the center of the round form and the poured height. Enter the number of identical columns separately.</span>
</DiagramFrame>
