---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="aggregate-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <circle cx="3.5" cy="5" r="2" stroke="currentColor" stroke-width="1.25"/>
        <circle cx="8"   cy="4" r="1.5" stroke="currentColor" stroke-width="1.25"/>
        <circle cx="11"  cy="6" r="1.8" stroke="currentColor" stroke-width="1.25"/>
        <circle cx="5.5" cy="9" r="1.6" stroke="currentColor" stroke-width="1.25"/>
        <circle cx="10"  cy="10" r="1.4" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    </span>
    <h2 id="aggregate-diagram-caption" class="diagram-title">Aggregate Cross-Section</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="aggLayerGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#d6d3d1"/>
          <stop offset="100%" stop-color="#a8a29e"/>
        </linearGradient>
        <linearGradient id="subGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c8a96e"/>
          <stop offset="100%" stop-color="#8b6840"/>
        </linearGradient>
        <linearGradient id="skyBg" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f5f5f4"/>
          <stop offset="100%" stop-color="#e7e5e4"/>
        </linearGradient>
        <!-- Crushed stone irregular shapes -->
        <pattern id="stonePattern" x="0" y="0" width="40" height="30" patternUnits="userSpaceOnUse">
          <!-- Stone 1 -->
          <polygon points="3,6 10,3 14,8 9,13 3,11" fill="#d6d3d1" stroke="#78716c" stroke-width="0.8" opacity="0.9"/>
          <!-- Stone 2 -->
          <polygon points="16,4 24,2 28,7 22,12 15,9" fill="#c8c4c0" stroke="#78716c" stroke-width="0.8" opacity="0.85"/>
          <!-- Stone 3 -->
          <polygon points="29,5 37,3 39,9 33,14 28,10" fill="#d6d3d1" stroke="#78716c" stroke-width="0.8" opacity="0.9"/>
          <!-- Stone 4 (row 2) -->
          <polygon points="0,16 8,14 12,19 6,25 0,22" fill="#c8c4c0" stroke="#78716c" stroke-width="0.8" opacity="0.85"/>
          <!-- Stone 5 -->
          <polygon points="10,17 19,15 22,21 16,27 9,24" fill="#d6d3d1" stroke="#78716c" stroke-width="0.8" opacity="0.9"/>
          <!-- Stone 6 -->
          <polygon points="23,16 31,13 35,18 30,25 22,23" fill="#e7e5e4" stroke="#78716c" stroke-width="0.8" opacity="0.8"/>
          <!-- Stone 7 -->
          <polygon points="34,18 40,15 40,24 36,26 32,22" fill="#c8c4c0" stroke="#78716c" stroke-width="0.8" opacity="0.85"/>
        </pattern>
        <pattern id="subsoilHatch" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
          <line x1="0" y1="10" x2="10" y2="0" stroke="#92400e" stroke-width="0.8" opacity="0.25"/>
        </pattern>
      </defs>

      <!-- â”€â”€ BACKGROUND â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="0" y="0" width="480" height="300" fill="url(#skyBg)" opacity="0.4"/>

      <!-- â”€â”€ SUBGRADE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="50" y="210" width="340" height="72" fill="url(#subGrad)" opacity="0.55" rx="1"/>
      <rect x="50" y="210" width="340" height="72" fill="url(#subsoilHatch)"/>

      <!-- â”€â”€ AGGREGATE LAYER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="50" y="100" width="340" height="110" fill="url(#aggLayerGrad)" opacity="0.75"/>
      <rect x="50" y="100" width="340" height="110" fill="url(#stonePattern)"/>

      <!-- Top surface line -->
      <line x1="50" y1="100" x2="390" y2="100" stroke="#78716c" stroke-width="1.5" opacity="0.5"/>

      <!-- â”€â”€ LAYER LABELS (right) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <text x="400" y="157" font-family="Inter,system-ui,sans-serif" font-size="11" font-weight="700" fill="#57534e">Aggregate</text>
      <text x="400" y="169" font-family="Inter,system-ui,sans-serif" font-size="9"  font-weight="500" fill="#78716c" opacity="0.8">crushed stone</text>
      <text x="400" y="246" font-family="Inter,system-ui,sans-serif" font-size="11" font-weight="500" fill="#92400e" opacity="0.65">Subgrade</text>
      <line x1="390" y1="155" x2="398" y2="155" stroke="#57534e" stroke-width="1" opacity="0.4"/>
      <line x1="390" y1="245" x2="398" y2="245" stroke="#92400e" stroke-width="1" opacity="0.35"/>

      <!-- â”€â”€ DEPTH annotation (left, amber) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1=”36” y1=”100” x2=”48” y2=”100” stroke=”#d97706” stroke-width=”1” stroke-dasharray=”3 2” opacity=”0.7”/>
      <line x1=”36” y1=”210” x2=”48” y2=”210” stroke=”#d97706” stroke-width=”1” stroke-dasharray=”3 2” opacity=”0.7”/>
      <line x1=”40” y1=”100” x2=”40” y2=”210” stroke=”#d97706” stroke-width=”1.75”/>
      <polygon points=”40,100 35,111 45,111” fill=”#d97706”/>
      <polygon points=”40,210 35,199 45,199” fill=”#d97706”/>
      <text x=”26” y=”158” text-anchor=”middle” font-family=”Inter,system-ui,sans-serif”
        font-size=”11” font-weight=”700” fill=”#d97706” letter-spacing=”-0.3”
        transform=”rotate(-90 26 158)”>Depth</text>

      <!-- â”€â”€ LENGTH annotation (top, blue) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1=”50”  y1=”82” x2=”50”  y2=”97” stroke=”#0070f3” stroke-width=”1” stroke-dasharray=”3 2” opacity=”0.7”/>
      <line x1=”390” y1=”82” x2=”390” y2=”97” stroke=”#0070f3” stroke-width=”1” stroke-dasharray=”3 2” opacity=”0.7”/>
      <line x1=”50”  y1=”86” x2=”390” y2=”86” stroke=”#0070f3” stroke-width=”1.75”/>
      <polygon points=”50,86  60,81  60,91”  fill=”#0070f3”/>
      <polygon points=”390,86 380,81 380,91” fill=”#0070f3”/>
      <text x=”220” y=”76” text-anchor=”middle” font-family=”Inter,system-ui,sans-serif”
        font-size=”11” font-weight=”700” fill=”#0070f3” letter-spacing=”-0.3”>Length</text>

      <!-- â”€â”€ WIDTH perspective lines â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1=”50”  y1=”210” x2=”66”  y2=”228” stroke=”#16a34a” stroke-width=”1.25” stroke-dasharray=”4 3” opacity=”0.85”/>
      <line x1=”390” y1=”210” x2=”406” y2=”228” stroke=”#16a34a” stroke-width=”1.25” stroke-dasharray=”4 3” opacity=”0.85”/>
      <line x1=”66”  y1=”228” x2=”406” y2=”228” stroke=”#16a34a” stroke-width=”1.25” stroke-dasharray=”4 3” opacity=”0.85”/>
      <text x=”236” y=”242” text-anchor=”middle” font-family=”Inter,system-ui,sans-serif”
        font-size=”10” font-weight=”700” fill=”#16a34a”>Width</text>

      <!-- â”€â”€ STONE SIZE CALLOUT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="100" y1="125" x2="88" y2="108" stroke="#78716c" stroke-width="1" opacity="0.5"/>
      <text x="74" y="106" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="600" fill="#57534e" opacity="0.75">#57 stone</text>
      <text x="74" y="116" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="400" fill="#78716c" opacity="0.65">(¾ in typical)</text>

      <!-- â”€â”€ FORMULA REMINDER â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="50" y="256" width="200" height="28" rx="6" fill="#f5f5f4" stroke="#d6d3d1" stroke-width="1"/>
      <text x="150" y="268" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="9" fill="#57534e">V (yd³) = L × W × D (ft) ÷ 27</text>
      <text x="150" y="279" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="8" fill="#78716c" opacity="0.8">Tons = yd³ × 1.5</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Aggregate cross-section: crushed stone layer over compacted subgrade. Depth, length, and width determine total volume — multiply cubic yards by 1.5 for tons.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
