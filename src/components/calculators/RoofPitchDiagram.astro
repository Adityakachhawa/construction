---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="roof-pitch-diagram-caption" title="Roof Pitch Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 232" role="img" aria-label="Gable end showing full horizontal span, one horizontal run, vertical rise and sloped roof face">
    <path d="M36 147 181 57 326 147Z" fill="#d6e8e7" stroke="#244858" stroke-width="1.6" />
    <path d="M181 58v89" fill="none" stroke="#215e70" stroke-width="1.6" stroke-dasharray="4 3"/>
    <text x="105" y="87" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Roof slope</text>
    <path d="M181 57V147m-5 0h10M176 57h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="199" y="112.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Rise</text>
    <path d="M36 182H181m0 -5v10M36 177v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="108.5" y="173" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Run</text>
    <path d="M36 218H326m0 -5v10M36 213v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="181" y="209" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Full span</text>
  </svg>
  <span slot="caption">Measure rise vertically and run horizontally over the same roof section. Pitch is 12 × rise ÷ run. On a symmetrical gable, one run is half the full span.</span>
</DiagramFrame>
