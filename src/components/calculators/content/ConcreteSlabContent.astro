---
// src/components/calculators/content/ConcreteSlabContent.astro
import { slabDimensions, getSlabMetrics } from '../../../data/slab-dimensions';

function getShortUse(useCase: string): string {
  if (useCase.includes('Garage')) return 'Garage Slab';
  if (useCase.includes('Shed')) return 'Shed Slab';
  if (useCase.includes('Patio')) return 'Patio Slab';
  if (useCase.includes('Carport')) return 'Carport Slab';
  if (useCase.includes('Barn')) return 'Pole Barn Slab';
  if (useCase.includes('Pavilion')) return 'Pavilion Slab';
  return 'Slab';
}
---

<div class="calc-content-prose">
  <h2>How to Use the Concrete Slab Calculator</h2>
  <p>
    Whether you are planning a patio, walkway, garage slab, or shed foundation, this calculator determines the exact material volume and bag counts required for your project:
  </p>
  <ol>
    <li><strong>Enter Dimensions:</strong> Input your slab's length and width. You can use standard imperial feet and inches or switch to metric (meters).</li>
    <li><strong>Specify Slab Thickness:</strong> Standard residential walkways and patios use 4 inches, while driveways and garage floors typically require 4 to 6 inches to support vehicle loads.</li>
    <li><strong>Review Results & Recommended Order:</strong> Review your exact net volume in cubic yards and cubic feet, along with the recommended order quantity factoring in a 10% waste allowance.</li>
  </ol>

  <!-- Popular Concrete Slab Sizes (Quick Reference Grid) -->
  <h2>Popular Concrete Slab Sizes (Quick Reference)</h2>
  <p>
    Contractors and homeowners frequently build slabs with standard dimensions. Select an exact-dimension guide below for pre-calculated yardage, 80-lb and 60-lb bag charts, rebar requirements, and site preparation tips:
  </p>

  <div class="slab-sizes-grid">
    {slabDimensions.map((slab) => {
      const m4 = getSlabMetrics(slab.length, slab.width, 4);
      const m6 = getSlabMetrics(slab.length, slab.width, 6);
      const shortLabel = getShortUse(slab.useCase);
      const anchorTitle = `${slab.name} ${shortLabel} (${m4.cuYds} – ${m6.cuYds} yd³)`;
      return (
        <a
          href={`/calculators/concrete-slab-calculator/${slab.slug}/`}
          class="slab-size-card"
          title={`Concrete calculator and bag chart for a ${slab.name} slab`}
        >
          <div class="slab-card-top">
            <span class="slab-card-dim">{slab.name}</span>
            <span class="slab-card-sqft">{slab.areaSqFt} sq ft</span>
          </div>
          <strong class="slab-card-anchor">{anchorTitle}</strong>
          <p class="slab-card-desc">{slab.useCase}</p>
          <div class="slab-card-footer">
            <span class="slab-card-badge">{slab.recommendedThickness}" standard</span>
            <span class="slab-card-cta">View Guide →</span>
          </div>
        </a>
      );
    })}
  </div>

  <h2>Common Concrete Slab Sizes & Bag Counts Reference Table</h2>
  <p>
    The reference table below displays exact concrete volumes and estimated bag quantities for common residential slab sizes. Bag counts include a recommended 10% allowance for subgrade unevenness and form deflection:
  </p>

  <div class="table-container table-scroll-wrapper">
    <table class="reference-table">
      <thead>
        <tr>
          <th>Slab Size (ft)</th>
          <th>Typical Application</th>
          <th>Area (sq ft)</th>
          <th>Volume at 4" (yd³)</th>
          <th>Volume at 6" (yd³)</th>
          <th>80 lb Bags (4" + 10%)</th>
          <th>60 lb Bags (4" + 10%)</th>
        </tr>
      </thead>
      <tbody>
        {slabDimensions.map((slab) => {
          const m4 = getSlabMetrics(slab.length, slab.width, 4);
          const m6 = getSlabMetrics(slab.length, slab.width, 6);
          return (
            <tr>
              <td>
                <a
                  href={`/calculators/concrete-slab-calculator/${slab.slug}/`}
                  class="table-size-link"
                >
                  <strong>{slab.name} Slab</strong>
                </a>
              </td>
              <td>{slab.useCase}</td>
              <td>{slab.areaSqFt}</td>
              <td>{m4.cuYds}</td>
              <td>{m6.cuYds}</td>
              <td>{m4.bags80WithWaste}</td>
              <td>{m4.bags60WithWaste}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <h2>Recommended Slab Thickness by Project Type</h2>
  <p>
    Selecting the appropriate slab thickness ensures structural longevity and prevents premature cracking:
  </p>
  <ul>
    <li><strong>Sidewalks, Walkways & Garden Paths (4 inches):</strong> A 4-inch pour over a compacted gravel sub-base provides plenty of support for standard pedestrian foot traffic and lawnmowers.</li>
    <li><strong>Patios & Outdoor Living Areas (4 inches):</strong> 4 inches is standard for dining tables, fire pits, and grills. If supporting an outdoor stone fireplace or heavy brick pillars, thicken the edges or pour dedicated footings.</li>
    <li><strong>Shed Foundations & Hot Tub Pads (4 to 6 inches):</strong> Small tool sheds (under 100 sq ft) perform well at 4 inches. Hot tub pads, swim spas, and heavy utility workshops should be poured at 5 to 6 inches with #4 rebar reinforcement.</li>
    <li><strong>Residential Driveways & Garage Floors (4 to 5 inches):</strong> Cars, SUVs, and light pickup trucks require a minimum 4-inch slab with 4,000 PSI concrete and wire mesh or rebar. For regular parking of 3/4-ton or 1-ton trucks, pour 5 inches.</li>
    <li><strong>Heavy RV, Boat, or Commercial Equipment Pads (6 inches):</strong> Heavy motorhomes and equipment trailers require a full 6-inch pour over a minimum 6-inch compacted aggregate base with rebar spaced at 12 inches on-center.</li>
  </ul>

  <h2>Ready-Mix Truck vs. Bagged Concrete Breakeven Guide</h2>
  <p>
    Deciding between mixing bags by hand and ordering a ready-mix concrete delivery truck generally comes down to total volume and available labor:
  </p>
  <ul>
    <li><strong>Under 1 Cubic Yard (Under 45–50 Bags):</strong> Mixing bagged concrete using a rented electric drum mixer or wheelbarrow is generally the most economical choice. Ready-mix companies charge "short-load fees" (often $100 to $200 extra) for orders under 4 to 5 yards, making small truck deliveries cost-prohibitive.</li>
    <li><strong>1 to 2 Cubic Yards (45 to 90 Bags):</strong> This is the transitional zone. Mixing 70 to 90 eighty-pound bags requires substantial manual labor and hours of mixing. Consider a volumetric "mix-on-site" mobile concrete service, which dispenses the exact yardage required with zero waste and no short-load penalty.</li>
    <li><strong>Over 2 Cubic Yards (90+ Bags):</strong> Ready-mix truck delivery is strongly recommended. Hand-mixing 100+ bags risks "cold joints" (where one batch hardens before the next is poured, weakening the slab). Ready-mix delivers a uniform, pre-tested mix that can be discharged, screeded, and bull-floated in a single continuous pour.</li>
  </ul>
</div>

