---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="rafter-diagram-caption" title="Rafter Framing Diagram">
  <svg class="diagram-svg" role="img" aria-label="Rafter elevation showing the sloping length from wall to ridge and the tail extending beyond the wall" viewBox="0 0 480 265">
    <path d="M114 173H365V47Z" fill="#e8f1f2"/>
    <path d="M103 177h23v43h-23z" fill="#b6c5c9" stroke="#526b77"/>
    <path d="M98 169h32v9H98zM365 34h9v36h-9z" fill="#d4ad79" stroke="#76573c"/>
    <path d="M32 201 365 34v13L121 169h-8v4l-81 41Z" fill="#e6c391" stroke="#795b3c" stroke-width="1.6" stroke-linejoin="round"/>
    <g fill="none" stroke="#346879" stroke-width="1.4">
      <path d="M126 173h239V51" stroke-dasharray="4 4"/>
      <path d="M354 173v-11h11M32 221v13m81-13v13m252-57v57M32 228h333M378 47h22m-30 126h30m-6-126v126"/>
      <path d="M150 173a37 37 0 0 0-4-16"/>
    </g>
    <g fill="#254958" font-size="14" font-weight="650">
      <text transform="translate(208 103) rotate(-26.6)" text-anchor="middle">Rafter length</text>
      <text x="375" y="30">Ridge</text><text x="403" y="114">Rise</text>
      <text x="161" y="166">Angle</text>
      <text x="73" y="251" text-anchor="middle">Overhang</text>
      <text x="240" y="251" text-anchor="middle">Run</text>
    </g>
  </svg>
  <span slot="caption">Common rafter framing: the structural rafter spans from the bird's-mouth at the wall plate to the ridge. The eave overhang extends the rafter past the wall at the same slope. Both lengths are calculated using the Pythagorean theorem.</span>
</DiagramFrame>
