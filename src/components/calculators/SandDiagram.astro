---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="sand-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <path d="M2 11h10M3 8h8M4 5h6M5 2h4" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      </svg>
    </span>
    <h2 id="sand-diagram-caption" class="diagram-title">Sand Area Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="sandTop" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#f5deb3"/>
          <stop offset="100%" stop-color="#dcc48a"/>
        </linearGradient>
        <linearGradient id="sandFront" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c4a45a"/>
          <stop offset="100%" stop-color="#a07830"/>
        </linearGradient>
        <linearGradient id="sandRight" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#b49042"/>
          <stop offset="100%" stop-color="#a07830"/>
        </linearGradient>
        <!-- Fine sand texture: tiny dots -->
        <pattern id="sandPattern" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="0.8" fill="#e8c870" opacity="0.6"/>
          <circle cx="7" cy="3" r="0.7" fill="#d4b45a" opacity="0.5"/>
          <circle cx="4" cy="7" r="0.9" fill="#e0c060" opacity="0.55"/>
          <circle cx="9" cy="8" r="0.7" fill="#d4b45a" opacity="0.5"/>
          <circle cx="1" cy="8" r="0.6" fill="#e8c870" opacity="0.45"/>
          <circle cx="6" cy="6" r="0.5" fill="#cca848" opacity="0.4"/>
        </pattern>
      </defs>

      <!-- Isometric sand bed body -->
      <!-- Top face base -->
      <polygon points="90,100 330,100 395,148 155,148"
        fill="url(#sandTop)" stroke="#a07830" stroke-width="1.5"/>
      <!-- Sand texture overlay on top -->
      <polygon points="90,100 330,100 395,148 155,148"
        fill="url(#sandPattern)" opacity="0.8"/>
      <!-- Front face -->
      <polygon points="90,100 90,215 155,215 155,148"
        fill="url(#sandFront)" stroke="#a07830" stroke-width="1.5"/>
      <!-- Right face -->
      <polygon points="155,148 395,148 395,215 155,215"
        fill="url(#sandRight)" stroke="#a07830" stroke-width="1.5"/>

      <!-- Surface ripple lines (windblown look) -->
      <line x1="130" y1="108" x2="260" y2="108" stroke="#e8d088" stroke-width="0.8" opacity="0.5"/>
      <line x1="145" y1="118" x2="300" y2="118" stroke="#e8d088" stroke-width="0.8" opacity="0.4"/>
      <line x1="120" y1="128" x2="240" y2="128" stroke="#e8d088" stroke-width="0.7" opacity="0.35"/>

      <!-- ── LENGTH annotation (top, horizontal) ── -->
      <line x1="90" y1="100" x2="90" y2="72" stroke="#0070f3" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="330" y1="100" x2="330" y2="72" stroke="#0070f3" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="90" y1="80" x2="330" y2="80" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="90,80 100,75 100,85" fill="#0070f3"/>
      <polygon points="330,80 320,75 320,85" fill="#0070f3"/>
      <text x="210" y="66" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Length</text>

      <!-- ── WIDTH annotation (right side, diagonal) ── -->
      <line x1="330" y1="100" x2="418" y2="76" stroke="#16a34a" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="395" y1="148" x2="418" y2="168" stroke="#16a34a" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="418" y1="76" x2="418" y2="168" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="418,76 413,87 423,87" fill="#16a34a"/>
      <polygon points="418,168 413,157 423,157" fill="#16a34a"/>
      <text x="432" y="126" text-anchor="start" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#16a34a" letter-spacing="-0.3">Width</text>

      <!-- ── DEPTH annotation (left, vertical) ── -->
      <line x1="90" y1="100" x2="55" y2="100" stroke="#d97706" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="90" y1="215" x2="55" y2="215" stroke="#d97706" stroke-width="1" stroke-dasharray="4 3" opacity="0.7"/>
      <line x1="62" y1="100" x2="62" y2="215" stroke="#d97706" stroke-width="1.75"/>
      <polygon points="62,100 57,111 67,111" fill="#d97706"/>
      <polygon points="62,215 57,204 67,204" fill="#d97706"/>
      <text x="48" y="160" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#d97706" letter-spacing="-0.3"
        transform="rotate(-90 48 160)">Depth</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Sand bed: length × width × depth — enter each dimension above to calculate volume and weight.
  </figcaption>
</figure>

<style>
  .diagram-figure {
    margin-top: 3.5rem;
  }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
