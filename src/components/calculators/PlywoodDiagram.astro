---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="plywood-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="7.5" y="1" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="1" y="7.5" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="7.5" y="7.5" width="5.5" height="5.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    </span>
    <h2 id="plywood-diagram-caption" class="diagram-title">Plywood Sheet Layout Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="sheetGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#fef3c7"/>
          <stop offset="100%" stop-color="#fde68a"/>
        </linearGradient>
        <linearGradient id="sheetSide" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%"   stop-color="#d97706"/>
          <stop offset="100%" stop-color="#b45309"/>
        </linearGradient>
        <linearGradient id="floorGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#f0fdf4"/>
          <stop offset="100%" stop-color="#dcfce7"/>
        </linearGradient>
        <!-- Wood grain texture -->
        <pattern id="grain" x="0" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
          <line x1="0" y1="4"  x2="32" y2="4"  stroke="#d97706" stroke-width="0.4" opacity="0.25"/>
          <line x1="0" y1="10" x2="32" y2="10" stroke="#b45309" stroke-width="0.3" opacity="0.2"/>
          <line x1="0" y1="17" x2="32" y2="17" stroke="#d97706" stroke-width="0.4" opacity="0.22"/>
          <line x1="0" y1="24" x2="32" y2="24" stroke="#b45309" stroke-width="0.3" opacity="0.18"/>
          <line x1="0" y1="29" x2="32" y2="29" stroke="#d97706" stroke-width="0.35" opacity="0.2"/>
        </pattern>
        <!-- Stagger offset grain for second row -->
        <pattern id="grain2" x="16" y="0" width="32" height="32" patternUnits="userSpaceOnUse">
          <line x1="0" y1="4"  x2="32" y2="4"  stroke="#d97706" stroke-width="0.4" opacity="0.25"/>
          <line x1="0" y1="11" x2="32" y2="11" stroke="#b45309" stroke-width="0.3" opacity="0.2"/>
          <line x1="0" y1="18" x2="32" y2="18" stroke="#d97706" stroke-width="0.4" opacity="0.22"/>
          <line x1="0" y1="25" x2="32" y2="25" stroke="#b45309" stroke-width="0.3" opacity="0.18"/>
        </pattern>
      </defs>

      <!-- ── FLOOR AREA (full project area outline) ─────── -->
      <rect x="52" y="28" width="370" height="220" fill="url(#floorGrad)" stroke="#475569"
        stroke-width="2" stroke-dasharray="8 4" rx="2"/>

      <!-- ── ROW 1: 3 full sheets (stagger start at x=52) ── -->
      <!-- Sheet 1,1 -->
      <rect x="52"  y="28" width="110" height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5"/>
      <rect x="52"  y="28" width="110" height="110" fill="url(#grain)" opacity="0.7"/>
      <!-- Sheet 1,2 -->
      <rect x="162" y="28" width="110" height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5"/>
      <rect x="162" y="28" width="110" height="110" fill="url(#grain)" opacity="0.7"/>
      <!-- Sheet 1,3 -->
      <rect x="272" y="28" width="110" height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5"/>
      <rect x="272" y="28" width="110" height="110" fill="url(#grain)" opacity="0.7"/>
      <!-- Sheet 1,4 partial (cut) — clipped to floor area -->
      <rect x="382" y="28" width="40"  height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5" opacity="0.65"/>
      <rect x="382" y="28" width="40"  height="110" fill="url(#grain)" opacity="0.5"/>
      <!-- cut mark on partial -->
      <line x1="382" y1="28"  x2="382" y2="138" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5 3"/>

      <!-- ── ROW 2: staggered (offset by half sheet = 55px) ── -->
      <!-- Sheet 2,0 partial start -->
      <rect x="52"  y="138" width="55"  height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5" opacity="0.65"/>
      <rect x="52"  y="138" width="55"  height="110" fill="url(#grain2)" opacity="0.5"/>
      <line x1="107" y1="138" x2="107" y2="248" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5 3"/>
      <!-- Sheet 2,1 -->
      <rect x="107" y="138" width="110" height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5"/>
      <rect x="107" y="138" width="110" height="110" fill="url(#grain2)" opacity="0.7"/>
      <!-- Sheet 2,2 -->
      <rect x="217" y="138" width="110" height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5"/>
      <rect x="217" y="138" width="110" height="110" fill="url(#grain2)" opacity="0.7"/>
      <!-- Sheet 2,3 -->
      <rect x="327" y="138" width="95"  height="110" fill="url(#sheetGrad)" stroke="#d97706" stroke-width="1.5" opacity="0.65"/>
      <rect x="327" y="138" width="95"  height="110" fill="url(#grain2)" opacity="0.5"/>
      <line x1="422" y1="138" x2="422" y2="248" stroke="#ef4444" stroke-width="1.5" stroke-dasharray="5 3"/>

      <!-- ── SHEET THICKNESS edge (isometric peek at bottom-right) -->
      <polygon points="422,248 422,260 432,254 432,242" fill="url(#sheetSide)" opacity="0.75"/>
      <polygon points="52,248 422,248 432,242 62,242"   fill="#fbbf24" opacity="0.4" stroke="#d97706" stroke-width="0.75"/>

      <!-- ── LENGTH annotation (top) ────────────────────── -->
      <line x1="52"  y1="20" x2="422" y2="20" stroke="#0070f3" stroke-width="1.75"/>
      <line x1="52"  y1="12" x2="52"  y2="28" stroke="#0070f3" stroke-width="1.25"/>
      <line x1="422" y1="12" x2="422" y2="28" stroke="#0070f3" stroke-width="1.25"/>
      <polygon points="52,20  65,15  65,25"  fill="#0070f3"/>
      <polygon points="422,20 409,15 409,25" fill="#0070f3"/>
      <text x="237" y="11" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Length</text>

      <!-- ── WIDTH annotation (right) ─────────────────── -->
      <line x1="430" y1="28"  x2="430" y2="248" stroke="#16a34a" stroke-width="1.75"/>
      <line x1="422" y1="28"  x2="438" y2="28"  stroke="#16a34a" stroke-width="1.25"/>
      <line x1="422" y1="248" x2="438" y2="248" stroke="#16a34a" stroke-width="1.25"/>
      <polygon points="430,28  425,41  435,41"  fill="#16a34a"/>
      <polygon points="430,248 425,235 435,235" fill="#16a34a"/>
      <text x="452" y="142" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(90 452 142)">Width</text>

      <!-- ── SHEET SIZE callout ──────────────────────── -->
      <line x1="162" y1="83" x2="136" y2="270" stroke="#d97706" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
      <rect x="30" y="262" width="112" height="30" rx="6" fill="#fffbeb" stroke="#d97706" stroke-width="1.25"/>
      <text x="86" y="274" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9.5" font-weight="700" fill="#b45309">4×8 sheet = 32 ft²</text>
      <text x="86" y="285" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="500" fill="#92400e">Stagger seams between rows</text>

      <!-- ── CUT / WASTE callout ────────────────────── -->
      <line x1="390" y1="83" x2="396" y2="270" stroke="#ef4444" stroke-width="1" stroke-dasharray="3 2" opacity="0.55"/>
      <rect x="330" y="262" width="112" height="30" rx="6" fill="#fff1f2" stroke="#ef4444" stroke-width="1.25"/>
      <text x="386" y="274" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9.5" font-weight="700" fill="#dc2626">Cut / waste edge</text>
      <text x="386" y="285" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="500" fill="#b91c1c">Add 10–15% waste</text>

      <!-- ── STAGGER label ─────────────────────────── -->
      <line x1="52"  y1="138" x2="107" y2="138" stroke="#6b7280" stroke-width="0.75" stroke-dasharray="3 2" opacity="0.5"/>
      <text x="78" y="132" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="600" fill="#6b7280" opacity="0.8">stagger</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Plywood sheets laid in a running bond (staggered) pattern — seams between rows are offset by half a sheet to distribute load and meet code requirements.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
    aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
