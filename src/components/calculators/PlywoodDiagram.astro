---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="plywood-diagram-caption" title="Plywood Sheet Layout Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 300" role="img" aria-label="Example floor area tiled with sheets and a separate sheet showing a cut and leftover piece">
    <text x="16" y="25" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Top view · first rectangle</text>
    <rect x="42" y="62" width="142" height="71" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <rect x="184" y="62" width="70" height="71" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <path d="M42 53H254m0 -5v10M42 48v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="148" y="44" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Length</text>
    <path d="M269 62V133m-5 0h10M264 62h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="279" y="102.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Width</text>
    <text x="113" y="104" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Full sheet</text>
    <text x="219" y="103" text-anchor="middle" font-size="14" font-weight="600" fill="#244858">Edge cut</text>
    <text x="16" y="180" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Cutting the last sheet</text>
    <rect x="62" y="206" width="142" height="70" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <path d="M132 206v70" fill="none" stroke="#244858" stroke-width="1.6" stroke-dasharray="5 3"/>
    <text x="96" y="248" text-anchor="middle" font-size="15" font-weight="600" fill="#244858">Use</text>
    <text x="168" y="248" text-anchor="middle" font-size="15" font-weight="600" fill="#244858">Offcut</text>
    <path d="M206 242h29" fill="none" stroke="#244858" stroke-width="1.6" />
    <text x="244" y="247" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Check fit</text>
  </svg>
  <span slot="caption">Measure the area to cover, then select the sheet size and orientation. An offcut can serve another edge when both usable dimensions fit. Confirm support and fastening against the project requirements.</span>
</DiagramFrame>
