---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="diagram-caption" title="Slab dimensions diagram">
  <svg class="diagram-svg" role="img" aria-label="Slab in perspective with length along the long edge, width along the receding edge, and vertical thickness" viewBox="0 0 480 240">
    <g stroke="#455d6c" stroke-width="1.6" stroke-linejoin="round">
      <path d="M72 85h249l65 50H137Z" fill="#dce5e8"/>
      <path d="M72 85l65 50v24l-65-50Z" fill="#a9bac2"/>
      <path d="M137 135h249v24H137Z" fill="#819ca9"/>
    </g>
    <g fill="none" stroke="#285b70" stroke-width="1.5">
      <path d="M72 76V51m249 25V51M72 59h249M330 80l19-14m44 64 19-14m-70-45 65 50M392 135h22m-22 24h22m-7-24v24"/>
    </g>
    <g fill="#234c60" font-size="15" font-weight="650" text-anchor="middle">
      <text x="196" y="48">Length</text>
      <text transform="translate(385 84) rotate(37.6)">Width</text>
      <text x="394" y="183">Thickness</text>
    </g>
    <text x="240" y="218" fill="#344f60" text-anchor="middle" font-size="14">Volume = length × width × thickness</text>
  </svg>
  <span slot="caption">Concrete slab: length × width × thickness — enter each dimension above to calculate volume.</span>
</DiagramFrame>
