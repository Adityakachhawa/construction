---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="asphalt-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="1" y="5" width="12" height="7" rx="1" stroke="currentColor" stroke-width="1.25"/>
        <line x1="3" y1="8" x2="11" y2="8" stroke="currentColor" stroke-width="1" stroke-dasharray="2 1.5" opacity="0.6"/>
        <line x1="1" y1="5" x2="13" y2="5" stroke="currentColor" stroke-width="1.5"/>
        <rect x="3" y="2" width="8" height="3" rx="0.5" stroke="currentColor" stroke-width="1" opacity="0.5"/>
      </svg>
    </span>
    <h2 id="asphalt-diagram-caption" class="diagram-title">Asphalt Cross-Section</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="asphaltTopGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#374151"/>
          <stop offset="100%" stop-color="#1f2937"/>
        </linearGradient>
        <linearGradient id="gravelBaseGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#d1c4a0"/>
          <stop offset="100%" stop-color="#a89060"/>
        </linearGradient>
        <linearGradient id="subgradeGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c8a96e"/>
          <stop offset="100%" stop-color="#8b6840"/>
        </linearGradient>
        <pattern id="asphaltTexture" x="0" y="0" width="12" height="12" patternUnits="userSpaceOnUse">
          <circle cx="3"  cy="3"  r="1.2" fill="#4b5563" opacity="0.5"/>
          <circle cx="9"  cy="8"  r="1"   fill="#6b7280" opacity="0.4"/>
          <circle cx="6"  cy="11" r="0.8" fill="#4b5563" opacity="0.35"/>
          <circle cx="11" cy="2"  r="0.9" fill="#9ca3af" opacity="0.3"/>
        </pattern>
        <pattern id="gravelTexture" x="0" y="0" width="10" height="10" patternUnits="userSpaceOnUse">
          <circle cx="2.5" cy="2.5" r="1.5" fill="#b8a070" opacity="0.5"/>
          <circle cx="7"   cy="6"   r="1.2" fill="#a89060" opacity="0.45"/>
          <circle cx="4"   cy="8"   r="1"   fill="#b8a070" opacity="0.4"/>
        </pattern>
        <!-- Centre-line dashes for driveway plan view -->
        <pattern id="centreLine" x="0" y="0" width="24" height="1" patternUnits="userSpaceOnUse">
          <line x1="0" y1="0.5" x2="16" y2="0.5" stroke="#fbbf24" stroke-width="1.5"/>
        </pattern>
      </defs>

      <!-- â•â• LEFT PANEL: cross-section â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->

      <!-- Subgrade (native soil) -->
      <rect x="50" y="236" width="210" height="46" fill="url(#subgradeGrad)" opacity="0.55" rx="1"/>

      <!-- Compacted gravel base (4–8 in) -->
      <rect x="50" y="170" width="210" height="66" fill="url(#gravelBaseGrad)" opacity="0.85"/>
      <rect x="50" y="170" width="210" height="66" fill="url(#gravelTexture)"/>

      <!-- Asphalt surface course -->
      <rect x="50" y="114" width="210" height="56" fill="url(#asphaltTopGrad)"/>
      <rect x="50" y="114" width="210" height="56" fill="url(#asphaltTexture)" opacity="0.6"/>

      <!-- Road surface sheen line -->
      <line x1="50" y1="115" x2="260" y2="115" stroke="#6b7280" stroke-width="1.5" opacity="0.4"/>

      <!-- Layer labels (right of cross-section) -->
      <text x="270" y="146" font-family="Inter,system-ui,sans-serif" font-size="11" font-weight="700" fill="#1f2937">Hot Mix Asphalt (HMA)</text>
      <text x="270" y="158" font-family="Inter,system-ui,sans-serif" font-size="9"  font-weight="500" fill="#4b5563">surface course</text>
      <text x="270" y="198" font-family="Inter,system-ui,sans-serif" font-size="11" font-weight="600" fill="#92714a">Gravel Base</text>
      <text x="270" y="210" font-family="Inter,system-ui,sans-serif" font-size="9"  font-weight="500" fill="#a89060" opacity="0.8">compacted aggregate</text>
      <text x="270" y="252" font-family="Inter,system-ui,sans-serif" font-size="11" font-weight="500" fill="#92400e" opacity="0.65">Subgrade</text>

      <!-- Connector ticks -->
      <line x1="260" y1="142" x2="268" y2="142" stroke="#9ca3af" stroke-width="1" opacity="0.5"/>
      <line x1="260" y1="200" x2="268" y2="200" stroke="#a89060" stroke-width="1" opacity="0.5"/>
      <line x1="260" y1="252" x2="268" y2="252" stroke="#92400e" stroke-width="1" opacity="0.4"/>

      <!-- â”€â”€ THICKNESS annotation (left, blue) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="36" y1="114" x2="48" y2="114" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="36" y1="170" x2="48" y2="170" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="40" y1="114" x2="40" y2="170" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="40,114 35,125 45,125" fill="#0070f3"/>
      <polygon points="40,170 35,159 45,159" fill="#0070f3"/>
      <text x="26" y="145" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#0070f3" letter-spacing="-0.3"
        transform="rotate(-90 26 145)">Thickness</text>

      <!-- â”€â”€ BASE DEPTH annotation (left, green) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="22" y1="170" x2="48" y2="170" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="22" y1="236" x2="48" y2="236" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="26" y1="170" x2="26" y2="236" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="26,170 21,181 31,181" fill="#16a34a"/>
      <polygon points="26,236 21,225 31,225" fill="#16a34a"/>
      <text x="12" y="206" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="10" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(-90 12 206)">Base</text>

      <!-- â”€â”€ WIDTH annotation (top, green) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1=”50”  y1=”101” x2=”50”  y2=”111” stroke=”#16a34a” stroke-width=”1” stroke-dasharray=”3 2” opacity=”0.7”/>
      <line x1=”260” y1=”101” x2=”260” y2=”111” stroke=”#16a34a” stroke-width=”1” stroke-dasharray=”3 2” opacity=”0.7”/>
      <line x1=”50”  y1=”105” x2=”260” y2=”105” stroke=”#16a34a” stroke-width=”1.75”/>
      <polygon points=”50,105  60,100  60,110”  fill=”#16a34a”/>
      <polygon points=”260,105 250,100 250,110” fill=”#16a34a”/>
      <text x=”155” y=”94” text-anchor=”middle” font-family=”Inter,system-ui,sans-serif”
        font-size=”11” font-weight=”700” fill=”#16a34a” letter-spacing=”-0.3”>Width</text>

      <!-- â•â• RIGHT PANEL: driveway plan view â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
      <text x="390" y="94" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="10" font-weight="600" fill="#6b7280" letter-spacing="0.05em">PLAN VIEW</text>

      <!-- Driveway body -->
      <rect x="340" y="104" width="100" height="178" fill="url(#asphaltTopGrad)" rx="3"/>
      <rect x="340" y="104" width="100" height="178" fill="url(#asphaltTexture)" opacity="0.5" rx="3"/>

      <!-- Centre-line stripe -->
      <rect x="387" y="110" width="6" height="166" fill="url(#centreLine)" opacity="0.9"/>

      <!-- Edge lines -->
      <line x1="352" y1="106" x2="352" y2="280" stroke="#6b7280" stroke-width="1" opacity="0.5"/>
      <line x1="428" y1="106" x2="428" y2="280" stroke="#6b7280" stroke-width="1" opacity="0.5"/>

      <!-- Garage end cap -->
      <rect x="340" y="104" width="100" height="10" fill="#4b5563" rx="2"/>
      <text x="390" y="113" text-anchor="middle" font-family="Inter,system-ui,sans-serif" font-size="8" fill="#d1d5db">garage</text>

      <!-- Length annotation (right, blue) -->
      <line x1="448" y1="104" x2="442" y2="104" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="448" y1="282" x2="442" y2="282" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="452" y1="104" x2="452" y2="282" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="452,104 447,115 457,115" fill="#0070f3"/>
      <polygon points="452,282 447,271 457,271" fill="#0070f3"/>
      <text x="467" y="197" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="13" font-weight="700" fill="#0070f3" letter-spacing="-0.3"
        transform="rotate(90 467 197)">Length</text>

      <!-- Width annotation (bottom, green) -->
      <line x1="340" y1="288" x2="340" y2="284" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="440" y1="288" x2="440" y2="284" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="340" y1="290" x2="440" y2="290" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="340,290 350,285 350,295" fill="#16a34a"/>
      <polygon points="440,290 430,285 430,295" fill="#16a34a"/>
      <text x="390" y="299" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#16a34a">Width</text>

      <!-- â•â• LEGEND â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â• -->
      <rect x="50" y="255" width="204" height="42" rx="6" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1"/>
      <rect x="62"  y="263" width="14" height="10" fill="url(#asphaltTopGrad)" rx="1"/>
      <text x="82"  y="272" font-family="Inter,system-ui,sans-serif" font-size="10" fill="#374151">Asphalt (HMA) ~145 lbs/ft³</text>
      <rect x="62"  y="279" width="14" height="10" fill="url(#gravelBaseGrad)" rx="1"/>
      <text x="82"  y="288" font-family="Inter,system-ui,sans-serif" font-size="10" fill="#374151">Gravel base</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Asphalt cross-section: compacted subgrade → gravel base (4–8 in) → hot-mix asphalt surface course. Enter your driveway or parking lot dimensions above.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
