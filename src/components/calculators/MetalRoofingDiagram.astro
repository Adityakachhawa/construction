---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="metal-roofing-diagram-caption" title="Metal Roofing Panel Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 236" role="img" aria-label="Roof face seen square on, with an overlap between adjacent panels">
    <rect x="42" y="66" width="112" height="112" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <rect x="144" y="66" width="112" height="112" fill="#d0dbe0" stroke="#244858" stroke-width="1.5"/>
    <rect x="144" y="66" width="10" height="112" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <path d="M42 54H144m0 -5v10M42 49v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="93" y="45" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Cover width</text>
    <path d="M276 66V178m-5 0h10M271 66h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="286" y="127" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Panel length</text>
    <text x="149" y="202" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Overlap</text>
    <path d="M149 179v8" fill="none" stroke="#244858" stroke-width="1.6" />
    <text x="67" y="228" text-anchor="middle" font-size="14" font-weight="600" fill="#244858">Eave</text>
    <text x="223" y="55" text-anchor="middle" font-size="14" font-weight="600" fill="#244858">Ridge</text>
  </svg>
  <span slot="caption">Use effective coverage width after the side lap. Measure panel length along the roof slope from eave toward ridge. Use the supplier’s lap details.</span>
</DiagramFrame>
