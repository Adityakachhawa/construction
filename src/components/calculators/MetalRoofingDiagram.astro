---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="metal-roofing-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <polygon points="7,1 13,8 1,8" stroke="currentColor" stroke-width="1.25" fill="none"/>
        <line x1="4"  y1="8" x2="4"  y2="13" stroke="currentColor" stroke-width="1.25"/>
        <line x1="7"  y1="8" x2="7"  y2="13" stroke="currentColor" stroke-width="1.25"/>
        <line x1="10" y1="8" x2="10" y2="13" stroke="currentColor" stroke-width="1.25"/>
      </svg>
    </span>
    <h2 id="metal-roofing-diagram-caption" class="diagram-title">Metal Roofing Panel Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="panelGradA" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#e0f2fe"/>
          <stop offset="100%" stop-color="#bae6fd"/>
        </linearGradient>
        <linearGradient id="panelGradB" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#bae6fd"/>
          <stop offset="100%" stop-color="#7dd3fc"/>
        </linearGradient>
        <linearGradient id="ridgeMetal" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#94a3b8"/>
          <stop offset="100%" stop-color="#64748b"/>
        </linearGradient>
        <linearGradient id="wallGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%"   stop-color="#f1f5f9"/>
          <stop offset="100%" stop-color="#e2e8f0"/>
        </linearGradient>
        <!-- Rib profile texture — vertical lines across panels -->
        <pattern id="ribsA" x="0" y="0" width="36" height="1" patternUnits="userSpaceOnUse">
          <rect x="0"  y="0" width="36" height="200" fill="none"/>
          <line x1="0"  y1="0" x2="0"  y2="200" stroke="#0284c7" stroke-width="1.5" opacity="0.25"/>
          <line x1="18" y1="0" x2="18" y2="200" stroke="#0284c7" stroke-width="0.75" opacity="0.15"/>
        </pattern>
        <pattern id="ribsB" x="0" y="0" width="36" height="1" patternUnits="userSpaceOnUse">
          <rect x="0"  y="0" width="36" height="200" fill="none"/>
          <line x1="0"  y1="0" x2="0"  y2="200" stroke="#0369a1" stroke-width="1.5" opacity="0.22"/>
          <line x1="18" y1="0" x2="18" y2="200" stroke="#0369a1" stroke-width="0.75" opacity="0.14"/>
        </pattern>
      </defs>

      <!--
        Isometric-style gable roof with visible panel seams.
        Front slope only (perspective view, right side shown in shadow).

        Ridge: x=76..376, y=62
        Left eave: x=76, y=230
        Right eave: x=376, y=230   (gable end, front face of left slope)
        Depth right side: (376,62)→(430,100) ridge, (376,230)→(430,168) eave

        Panel columns: 5 visible across the slope width (left to right)
        Panel seam lines run eave-to-ridge (vertical in this projection).
        Panel rows: 2 rows shown (row break at mid-slope).
      -->

      <!-- ── LEFT ROOF SLOPE (front face) ─── 5 panel columns ── -->
      <!-- col boundaries: x = 76, 136, 196, 256, 316, 376 (Δ=60 each) -->
      <!-- Panel row break at y=146 (mid-slope between 62 and 230) -->

      <!-- Row 1 (upper) panels — alternating gradient for visual separation -->
      <rect x="76"  y="62"  width="60" height="84" fill="url(#panelGradA)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="76"  y="62"  width="60" height="84" fill="url(#ribsA)" opacity="1"/>
      <rect x="136" y="62"  width="60" height="84" fill="url(#panelGradB)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="136" y="62"  width="60" height="84" fill="url(#ribsB)" opacity="1"/>
      <rect x="196" y="62"  width="60" height="84" fill="url(#panelGradA)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="196" y="62"  width="60" height="84" fill="url(#ribsA)" opacity="1"/>
      <rect x="256" y="62"  width="60" height="84" fill="url(#panelGradB)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="256" y="62"  width="60" height="84" fill="url(#ribsB)" opacity="1"/>
      <rect x="316" y="62"  width="60" height="84" fill="url(#panelGradA)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="316" y="62"  width="60" height="84" fill="url(#ribsA)" opacity="1"/>

      <!-- Row 2 (lower) panels -->
      <rect x="76"  y="146" width="60" height="84" fill="url(#panelGradA)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="76"  y="146" width="60" height="84" fill="url(#ribsA)" opacity="1"/>
      <rect x="136" y="146" width="60" height="84" fill="url(#panelGradB)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="136" y="146" width="60" height="84" fill="url(#ribsB)" opacity="1"/>
      <rect x="196" y="146" width="60" height="84" fill="url(#panelGradA)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="196" y="146" width="60" height="84" fill="url(#ribsA)" opacity="1"/>
      <rect x="256" y="146" width="60" height="84" fill="url(#panelGradB)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="256" y="146" width="60" height="84" fill="url(#ribsB)" opacity="1"/>
      <rect x="316" y="146" width="60" height="84" fill="url(#panelGradA)" stroke="#0284c7" stroke-width="1.25"/>
      <rect x="316" y="146" width="60" height="84" fill="url(#ribsA)" opacity="1"/>

      <!-- Row overlap line (visible lap between row 1 and row 2) -->
      <line x1="76" y1="146" x2="376" y2="146" stroke="#0369a1" stroke-width="2" opacity="0.5"/>

      <!-- ── RIGHT SLOPE DEPTH (side face, darker) ────────────── -->
      <polygon points="376,62 430,100 430,208 376,230"
        fill="#bae6fd" stroke="#0284c7" stroke-width="1.25" opacity="0.55"/>
      <!-- Right slope rib lines (depth illusion) -->
      <line x1="376" y1="146" x2="430" y2="154" stroke="#0369a1" stroke-width="1.5" opacity="0.35"/>

      <!-- ── RIDGE CAP ──────────────────────────────────────────── -->
      <rect x="72"  y="55" width="308" height="12"
        fill="url(#ridgeMetal)" stroke="#475569" stroke-width="1.5"/>
      <!-- Ridge cap depth right -->
      <polygon points="380,55 434,93 434,105 380,67"
        fill="#64748b" stroke="#475569" stroke-width="1.25"/>
      <text x="226" y="50" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#475569">Ridge cap</text>

      <!-- ── WALL FASCIA / EAVE ────────────────────────────────── -->
      <rect x="72" y="230" width="308" height="14"
        fill="url(#wallGrad)" stroke="#94a3b8" stroke-width="1.25"/>
      <polygon points="380,230 434,208 434,222 380,244"
        fill="#e2e8f0" stroke="#94a3b8" stroke-width="1"/>
      <text x="226" y="258" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="600" fill="#64748b">Eave</text>

      <!-- ── PANEL WIDTH annotation (single panel, top) ─────────── -->
      <line x1="76"  y1="38" x2="136" y2="38" stroke="#0070f3" stroke-width="1.5"/>
      <line x1="76"  y1="31" x2="76"  y2="45" stroke="#0070f3" stroke-width="1.25"/>
      <line x1="136" y1="31" x2="136" y2="45" stroke="#0070f3" stroke-width="1.25"/>
      <polygon points="76,38  89,33  89,43"  fill="#0070f3"/>
      <polygon points="136,38 123,33 123,43" fill="#0070f3"/>
      <text x="106" y="29" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="700" fill="#0070f3">Panel width</text>

      <!-- ── ROOF LENGTH annotation (bottom, along eave) ─────────── -->
      <line x1="76"  y1="275" x2="376" y2="275" stroke="#0070f3" stroke-width="1.75"/>
      <line x1="76"  y1="267" x2="76"  y2="283" stroke="#0070f3" stroke-width="1.25"/>
      <line x1="376" y1="267" x2="376" y2="283" stroke="#0070f3" stroke-width="1.25"/>
      <polygon points="76,275  89,270  89,280"  fill="#0070f3"/>
      <polygon points="376,275 363,270 363,280" fill="#0070f3"/>
      <text x="226" y="296" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Roof Length (ridge)</text>

      <!-- ── PANEL LENGTH annotation (left side, eave to ridge) ──── -->
      <line x1="44" y1="62"  x2="44" y2="230" stroke="#16a34a" stroke-width="1.75"/>
      <line x1="36" y1="62"  x2="52" y2="62"  stroke="#16a34a" stroke-width="1.25"/>
      <line x1="36" y1="230" x2="52" y2="230" stroke="#16a34a" stroke-width="1.25"/>
      <polygon points="44,62  39,75   49,75"  fill="#16a34a"/>
      <polygon points="44,230 39,217  49,217" fill="#16a34a"/>
      <text x="26" y="150" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(-90 26 150)">Panel Length</text>

      <!-- ── PANEL COUNT callout ───────────────────────────────── -->
      <rect x="290" y="72" width="80" height="28" rx="5"
        fill="#f0f9ff" stroke="#0284c7" stroke-width="1.25"/>
      <text x="330" y="84" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="700" fill="#0369a1">5 cols × 2 rows</text>
      <text x="330" y="95" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#0284c7">× 2 slopes</text>

      <!-- ── PANEL COUNT FORMULA ───────────────────────────────── -->
      <rect x="292" y="216" width="182" height="48" rx="6"
        fill="#eff6ff" stroke="#0070f3" stroke-width="1.25"/>
      <text x="383" y="229" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#1d4ed8" letter-spacing="0.2">PANEL COUNT FORMULA</text>
      <text x="383" y="242" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="800" fill="#1e3a8a">Panels = ⌈Length ÷ Panel Width⌉ × Rows × Slopes</text>
      <text x="383" y="255" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" fill="#2563eb">always round up; add 10% waste</text>

      <!-- ── FASTENER DOTS (sample screws on visible panels) ────── -->
      <circle cx="96"  cy="104" r="2.5" fill="#0369a1" opacity="0.7"/>
      <circle cx="96"  cy="180" r="2.5" fill="#0369a1" opacity="0.7"/>
      <circle cx="156" cy="104" r="2.5" fill="#0369a1" opacity="0.7"/>
      <circle cx="156" cy="180" r="2.5" fill="#0369a1" opacity="0.7"/>
      <circle cx="216" cy="104" r="2.5" fill="#0369a1" opacity="0.7"/>
      <circle cx="216" cy="180" r="2.5" fill="#0369a1" opacity="0.7"/>
      <!-- Fastener label -->
      <line x1="96" y1="104" x2="70" y2="118" stroke="#0369a1" stroke-width="0.9" stroke-dasharray="3 2" opacity="0.6"/>
      <text x="56" y="122" text-anchor="end" font-family="Inter,system-ui,sans-serif"
        font-size="7.5" font-weight="600" fill="#0369a1">Fastener</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Metal roofing panel layout: panels run eave-to-ridge (panel length) and side-by-side along the ridge (panel coverage width). Total panels = columns × rows × 2 slopes.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
    aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
