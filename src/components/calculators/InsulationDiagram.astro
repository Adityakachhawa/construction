---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="insulation-diagram-caption" title="Insulation Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 195" role="img" aria-label="Measured rectangular area used to estimate insulation packages">
    <g stroke="#244858" stroke-width="1.6" stroke-linejoin="round">
      <rect x="52" y="69" width="197" height="95" fill="#eeddbb"/>
      <path d="M52 52h197m0-5v10M52 47v10M268 69v95m-5 0h10M263 69h10" fill="none"/>
    </g>
    <g fill="#244858" font-size="16" font-weight="600">
      <text x="151" y="42" text-anchor="middle">Length</text>
      <text x="282" y="122">Width</text>
      <text x="151" y="121" text-anchor="middle">Area to insulate</text>
    </g>
  </svg>
  <span slot="caption">Measure the length and width of the surface and enter the coverage printed on one roll or package. The estimate uses surface area and the selected waste allowance.</span>
</DiagramFrame>
