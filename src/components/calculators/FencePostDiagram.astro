---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="fence-post-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="2" y="1" width="3" height="12" rx="1" stroke="currentColor" stroke-width="1.25"/>
        <rect x="9" y="1" width="3" height="12" rx="1" stroke="currentColor" stroke-width="1.25"/>
        <line x1="2" y1="4.5" x2="12" y2="4.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        <line x1="2" y1="7.5" x2="12" y2="7.5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      </svg>
    </span>
    <h2 id="fence-post-diagram-caption" class="diagram-title">Fence Post Diagram</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="postGrad" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#a0744a"/>
          <stop offset="100%" stop-color="#7a5230"/>
        </linearGradient>
        <linearGradient id="groundGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#7cac5a"/>
          <stop offset="100%" stop-color="#4a7a2a"/>
        </linearGradient>
        <linearGradient id="soilGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c8a96e"/>
          <stop offset="100%" stop-color="#8b6840"/>
        </linearGradient>
        <linearGradient id="concreteGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#b0b8c4"/>
          <stop offset="100%" stop-color="#8090a0"/>
        </linearGradient>
      </defs>

      <!-- Ground surface -->
      <rect x="30" y="160" width="420" height="14" rx="2" fill="url(#groundGrad)" opacity="0.9"/>

      <!-- Soil / below ground -->
      <rect x="30" y="174" width="420" height="96" rx="0" fill="url(#soilGrad)" opacity="0.45"/>

      <!-- â”€â”€ POST 1 (left) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <!-- Below-ground section with concrete collar -->
      <rect x="85" y="174" width="28" height="96" rx="2" fill="url(#concreteGrad)" opacity="0.85"/>
      <!-- Above-ground section -->
      <rect x="85" y="40" width="28" height="120" rx="2" fill="url(#postGrad)"/>
      <!-- Post top cap -->
      <rect x="83" y="38" width="32" height="5" rx="2" fill="#6b4226"/>

      <!-- â”€â”€ POST 2 (center) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="226" y="174" width="28" height="96" rx="2" fill="url(#concreteGrad)" opacity="0.85"/>
      <rect x="226" y="40" width="28" height="120" rx="2" fill="url(#postGrad)"/>
      <rect x="224" y="38" width="32" height="5" rx="2" fill="#6b4226"/>

      <!-- â”€â”€ POST 3 (right) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="367" y="174" width="28" height="96" rx="2" fill="url(#concreteGrad)" opacity="0.85"/>
      <rect x="367" y="40" width="28" height="120" rx="2" fill="url(#postGrad)"/>
      <rect x="365" y="38" width="32" height="5" rx="2" fill="#6b4226"/>

      <!-- â”€â”€ RAILS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="113" y="65" width="113" height="10" rx="3" fill="#c89060" opacity="0.9"/>
      <rect x="113" y="105" width="113" height="10" rx="3" fill="#c89060" opacity="0.9"/>
      <rect x="113" y="145" width="113" height="10" rx="3" fill="#c89060" opacity="0.9"/>
      <rect x="254" y="65" width="113" height="10" rx="3" fill="#c89060" opacity="0.9"/>
      <rect x="254" y="105" width="113" height="10" rx="3" fill="#c89060" opacity="0.9"/>
      <rect x="254" y="145" width="113" height="10" rx="3" fill="#c89060" opacity="0.9"/>

      <!-- Ground line label -->
      <line x1="30" y1="160" x2="75" y2="160" stroke="#4a7a2a" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
      <text x="28" y="157" text-anchor="end" font-family="Inter,system-ui,sans-serif"
        font-size="10" font-weight="600" fill="#4a7a2a">Grade</text>

      <!-- â”€â”€ POST SPACING annotation (top, blue) â”€â”€â”€â”€â”€â”€ -->
      <line x1="99" y1="30" x2="99" y2="44" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="240" y1="30" x2="240" y2="44" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="99" y1="36" x2="240" y2="36" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="99,36 109,31 109,41" fill="#0070f3"/>
      <polygon points="240,36 230,31 230,41" fill="#0070f3"/>
      <text x="169" y="24" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Spacing</text>

      <!-- â”€â”€ POST DEPTH annotation (right, orange) â”€â”€â”€â”€ -->
      <line x1="404" y1="160" x2="438" y2="160" stroke="#d97706" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="404" y1="270" x2="438" y2="270" stroke="#d97706" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="432" y1="160" x2="432" y2="270" stroke="#d97706" stroke-width="1.75"/>
      <polygon points="432,160 427,171 437,171" fill="#d97706"/>
      <polygon points="432,270 427,259 437,259" fill="#d97706"/>
      <text x="450" y="220" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#d97706" letter-spacing="-0.3"
        transform="rotate(90 450 220)">Depth</text>

      <!-- â”€â”€ ABOVE-GROUND HEIGHT annotation (left, green) â”€â”€ -->
      <line x1="76" y1="43" x2="76" y2="160" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="76,43 71,54 81,54" fill="#16a34a"/>
      <polygon points="76,160 71,149 81,149" fill="#16a34a"/>
      <line x1="85" y1="43" x2="68" y2="43" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="85" y1="160" x2="68" y2="160" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <text x="62" y="107" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="12" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(-90 62 107)">Height</text>

      <!-- Concrete collar label -->
      <line x1="395" y1="215" x2="415" y2="215" stroke="#8090a0" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <text x="417" y="218" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="500" fill="#6b7280">Concrete</text>

      <!-- ── FORMULA CALLOUT ── -->
      <rect x="30" y="272" width="330" height="24" rx="4"
        fill="#eff6ff" stroke="#0070f3" stroke-width="1.25"/>
      <text x="195" y="282" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8.5" font-weight="800" fill="#1e3a8a">Posts = ⌈Fence Length ÷ Spacing⌉ + 1</text>
      <text x="195" y="292" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="8" font-weight="700" fill="#1e3a8a">Concrete Vol = π × r² × Depth × Posts</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Fence posts spaced evenly along the run — enter fence length, post spacing, and desired hole depth above.
  </figcaption>
</figure>

<style>
  .diagram-figure {
    margin-top: 3.5rem;
  }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
