---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="fence-post-diagram-caption" title="Fence Post Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 221" role="img" aria-label="Fence elevation with spacing between post centerlines">
    <rect x="52" y="87" width="220" height="12" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <rect x="52" y="132" width="220" height="12" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <rect x="52" y="62" width="12" height="112" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <rect x="156" y="62" width="12" height="112" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <rect x="260" y="62" width="12" height="112" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <path d="M58 49H162m0 -5v10M58 44v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="110" y="40" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Post spacing</text>
    <path d="M58 207H266m0 -5v10M58 202v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="162" y="198" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Run between end centers</text>
  </svg>
  <span slot="caption">Measure each fence run between end-post centers. Measure spacing from the center of one post to the center of the next. Identify gate openings separately.</span>
</DiagramFrame>
