---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="sqft-diagram-caption" title="Shape Reference">
  <svg class="diagram-svg" viewBox="0 0 410 445" role="img" aria-label="Four reference shapes with measurement endpoints for area calculations">
    <text x="18" y="26" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Rectangle</text>
    <rect x="65" y="61" width="140" height="38" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <path d="M65 52H205m0 -5v10M65 47v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="135" y="43" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Length</text>
    <path d="M222 61V99m-5 0h10M217 61h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="232" y="85" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Width</text>
    <text x="18" y="136" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Square</text>
    <rect x="81" y="151" width="52" height="52" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <path d="M151 151V203m-5 0h10M146 151h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="161" y="182" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Side</text>
    <text x="18" y="244" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Triangle</text>
    <path d="M62 300l80-61 75 61Z" fill="#d6e8e7" stroke="#244858" stroke-width="1.6" />
    <path d="M142 242v58" fill="none" stroke="#215e70" stroke-width="1.6" stroke-dasharray="4 3"/>
    <text x="195" y="271" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Height</text>
    <path d="M62 333H217m0 -5v10M62 328v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="139.5" y="324" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Base</text>
    <text x="18" y="368" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Circle</text>
    <circle cx="143" cy="393" r="40" fill="#d6e8e7" stroke="#244858" stroke-width="1.6"/>
    <circle cx="143" cy="393" r="2" fill="#244858"/>
    <path d="M143 393h40" fill="none" stroke="#244858" stroke-width="1.6" />
    <text x="224" y="398" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Radius</text>
  </svg>
  <span slot="caption">Rectangle: length × width. Square: side × side. Triangle: base × perpendicular height ÷ 2. Circle: π × radius², measured from the center to the edge.</span>
</DiagramFrame>
