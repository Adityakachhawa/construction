---
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<figure class={`diagram-figure ${className}`} aria-labelledby="flooring-diagram-caption">
  <div class="diagram-header">
    <span class="diagram-badge">
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
        <rect x="1" y="1" width="5" height="3.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="8" y="1" width="5" height="3.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="1" y="6" width="5" height="3.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="8" y="6" width="5" height="3.5" rx="0.5" stroke="currentColor" stroke-width="1.25"/>
        <rect x="1" y="11" width="5" height="2" rx="0.5" stroke="currentColor" stroke-width="1" opacity="0.5"/>
        <rect x="8" y="11" width="5" height="2" rx="0.5" stroke="currentColor" stroke-width="1" opacity="0.5"/>
      </svg>
    </span>
    <h2 id="flooring-diagram-caption" class="diagram-title">Room Floor Layout</h2>
  </div>
  <div class="diagram-box">
    <svg
      viewBox="0 0 480 300"
      width="100%"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
      focusable="false"
      class="diagram-svg"
    >
      <defs>
        <linearGradient id="plankGrad1" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#d4a96a"/>
          <stop offset="100%" stop-color="#b8864e"/>
        </linearGradient>
        <linearGradient id="plankGrad2" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#c49458"/>
          <stop offset="100%" stop-color="#a07040"/>
        </linearGradient>
        <linearGradient id="plankGrad3" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="#dbb478"/>
          <stop offset="100%" stop-color="#c09050"/>
        </linearGradient>
        <linearGradient id="wasteGrad" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="#fef3c7"/>
          <stop offset="100%" stop-color="#fde68a"/>
        </linearGradient>
      </defs>

      <!-- â”€â”€ ROOM BOUNDARY â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="50" y="40" width="340" height="220" fill="#f5f0e8" stroke="#92400e" stroke-width="2" rx="2"/>

      <!-- â”€â”€ PLANK GRID (staggered rows, 6 rows Ã— 4+ planks) â”€â”€ -->
      <!-- Row 1 (y=40â€“76) â€” starts at x=50 -->
      <rect x="50"  y="40" width="84" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="134" y="40" width="84" height="36" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="218" y="40" width="84" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="302" y="40" width="84" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>

      <!-- Row 2 (y=76â€“112) â€” staggered offset 42px -->
      <rect x="50"  y="76" width="42" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="92"  y="76" width="84" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="176" y="76" width="84" height="36" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="260" y="76" width="84" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="344" y="76" width="46" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>

      <!-- Row 3 (y=112â€“148) â€” same as row 1 -->
      <rect x="50"  y="112" width="84" height="36" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="134" y="112" width="84" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="218" y="112" width="84" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="302" y="112" width="84" height="36" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>

      <!-- Row 4 (y=148â€“184) â€” staggered -->
      <rect x="50"  y="148" width="42" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="92"  y="148" width="84" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="176" y="148" width="84" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="260" y="148" width="84" height="36" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="344" y="148" width="46" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>

      <!-- Row 5 (y=184â€“220) â€” same as row 1 -->
      <rect x="50"  y="184" width="84" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="134" y="184" width="84" height="36" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="218" y="184" width="84" height="36" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="302" y="184" width="84" height="36" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>

      <!-- Row 6 (y=220â€“256) â€” staggered, partial height (last row) -->
      <rect x="50"  y="220" width="42" height="40" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="92"  y="220" width="84" height="40" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="176" y="220" width="84" height="40" fill="url(#plankGrad3)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="260" y="220" width="84" height="40" fill="url(#plankGrad2)" stroke="#8b6340" stroke-width="0.8"/>
      <rect x="344" y="220" width="46" height="40" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8"/>

      <!-- â”€â”€ WASTE / CUT PIECES (right + bottom edge, amber) â”€â”€ -->
      <!-- Right edge cut strip -->
      <rect x="386" y="40" width="4" height="220" fill="url(#wasteGrad)" stroke="#f59e0b" stroke-width="1" stroke-dasharray="4 3" opacity="0.85"/>
      <!-- Bottom edge cut strip -->
      <rect x="50" y="256" width="340" height="4" fill="url(#wasteGrad)" stroke="#f59e0b" stroke-width="1" stroke-dasharray="4 3" opacity="0.85"/>

      <!-- Waste label -->
      <text x="432" y="152" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="600" fill="#d97706"
        transform="rotate(90 432 152)">cut / waste</text>

      <!-- â”€â”€ WOOD GRAIN lines on planks (subtle) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="80"  y1="44"  x2="80"  y2="70"  stroke="#9a6838" stroke-width="0.5" opacity="0.3"/>
      <line x1="164" y1="44"  x2="164" y2="70"  stroke="#9a6838" stroke-width="0.5" opacity="0.3"/>
      <line x1="248" y1="44"  x2="248" y2="70"  stroke="#9a6838" stroke-width="0.5" opacity="0.3"/>
      <line x1="332" y1="44"  x2="332" y2="70"  stroke="#9a6838" stroke-width="0.5" opacity="0.3"/>

      <!-- â”€â”€ LENGTH annotation (top, blue) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="50"  y1="26" x2="50"  y2="38" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="390" y1="26" x2="390" y2="38" stroke="#0070f3" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="50"  y1="30" x2="390" y2="30" stroke="#0070f3" stroke-width="1.75"/>
      <polygon points="50,30  60,25  60,35"  fill="#0070f3"/>
      <polygon points="390,30 380,25 380,35" fill="#0070f3"/>
      <text x="220" y="20" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#0070f3" letter-spacing="-0.3">Room Length</text>

      <!-- â”€â”€ WIDTH annotation (right, green) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <line x1="402" y1="40"  x2="392" y2="40"  stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="402" y1="260" x2="392" y2="260" stroke="#16a34a" stroke-width="1" stroke-dasharray="3 2" opacity="0.7"/>
      <line x1="406" y1="40"  x2="406" y2="260" stroke="#16a34a" stroke-width="1.75"/>
      <polygon points="406,40  401,51  411,51"  fill="#16a34a"/>
      <polygon points="406,260 401,249 411,249" fill="#16a34a"/>
      <text x="422" y="153" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="11" font-weight="700" fill="#16a34a" letter-spacing="-0.3"
        transform="rotate(90 422 153)">Room Width</text>

      <!-- â”€â”€ PLANK WIDTH annotation (between row 1 & 2) â”€â”€ -->
      <line x1="50"  y1="270" x2="50"  y2="262" stroke="#7c3aed" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
      <line x1="134" y1="270" x2="134" y2="262" stroke="#7c3aed" stroke-width="1" stroke-dasharray="3 2" opacity="0.6"/>
      <line x1="50"  y1="274" x2="134" y2="274" stroke="#7c3aed" stroke-width="1.5"/>
      <polygon points="50,274  60,269  60,279"  fill="#7c3aed"/>
      <polygon points="134,274 124,269 124,279" fill="#7c3aed"/>
      <text x="92" y="286" text-anchor="middle" font-family="Inter,system-ui,sans-serif"
        font-size="9" font-weight="700" fill="#7c3aed">1 plank</text>

      <!-- â”€â”€ LEGEND â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
      <rect x="148" y="266" width="196" height="28" rx="6" fill="#f8fafc" stroke="#e2e4e8" stroke-width="1"/>
      <rect x="160" y="274" width="14" height="10" fill="url(#plankGrad1)" stroke="#8b6340" stroke-width="0.8" rx="1"/>
      <text x="178" y="283" font-family="Inter,system-ui,sans-serif" font-size="10" fill="#4b5563">Flooring planks (staggered)</text>
      <rect x="282" y="274" width="14" height="10" fill="url(#wasteGrad)" stroke="#f59e0b" stroke-width="1" rx="1"/>
      <text x="300" y="283" font-family="Inter,system-ui,sans-serif" font-size="10" fill="#4b5563">Waste / cuts</text>
    </svg>
  </div>
  <figcaption class="diagram-caption">
    Staggered plank layout: rows offset by half a plank for strength and appearance. Edge cuts (amber) contribute to the waste factor â€” add 10â€“15% when ordering.
  </figcaption>
</figure>

<style>
  .diagram-figure { margin-top: 3.5rem; }

  .diagram-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .diagram-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    border-radius: 8px;
    flex-shrink: 0;
  }

  .diagram-title {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
  }

  .diagram-box {
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    padding: 2rem;
    display: flex;
    justify-content: center;
    overflow: hidden;
    box-shadow: var(--shadow-card);
  }

  .diagram-svg {
    max-width: 480px;
    height: auto;
  aspect-ratio: 480 / 300;
    display: block;
  }

  .diagram-caption {
    margin-top: 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    text-align: center;
    line-height: 1.5;
  }
</style>
