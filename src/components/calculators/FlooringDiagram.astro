---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="flooring-diagram-caption" title="Room Floor Layout">
  <svg class="diagram-svg" viewBox="0 0 410 221" role="img" aria-label="Room outline with plank rows, showing where the final row ends">
    <rect x="42" y="60" width="213" height="111" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <path d="M42 97h213m-213 37h213m-116-74v37m43 0v37m-65 0v37m120-37v37" fill="none" stroke="#244858" stroke-width="1.6" />
    <path d="M42 49H255m0 -5v10M42 44v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="148.5" y="40" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Room length</text>
    <path d="M267 60V171m-5 0h10M262 60h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="277" y="120.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Room width</text>
  </svg>
  <span slot="caption">Measure the room inside its finished boundaries. Split irregular spaces into rectangles. The stagger shown is illustrative; use your product’s layout and waste guidance.</span>
</DiagramFrame>
