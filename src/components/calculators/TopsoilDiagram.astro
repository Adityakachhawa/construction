---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="topsoil-diagram-caption" title="Topsoil Depth Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 236" role="img" aria-label="Footprint viewed from above and material layer viewed from the side">
    <text x="16" y="23" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Top view</text>
    <rect x="56" y="63" width="177" height="51" fill="#d6e8e7" stroke="#244858" stroke-width="1.5"/>
    <path d="M56 55H233m0 -5v10M56 50v10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="144.5" y="46" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Length</text>
    <path d="M249 63V114m-5 0h10M244 63h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="259" y="93.5" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Width</text>
    <text x="16" y="150" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Side view</text>
    <rect x="56" y="168" width="177" height="32" fill="#efd5ae" stroke="#244858" stroke-width="1.5"/>
    <rect x="56" y="200" width="177" height="16" fill="#d3c2aa" stroke="#244858" stroke-width="1.5"/>
    <text x="144" y="190" text-anchor="middle" font-size="16" font-weight="600" fill="#244858">Topsoil</text>
    <path d="M249 168V200m-5 0h10M244 168h10" fill="none" stroke="#215e70" stroke-width="1.6" /><text x="259" y="189" text-anchor="start" font-size="16" font-weight="600" fill="#244858">Depth</text>
  </svg>
  <span slot="caption">Measure the bed footprint and the new topsoil depth above the existing ground.</span>
</DiagramFrame>
