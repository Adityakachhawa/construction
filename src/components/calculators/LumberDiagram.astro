---
import DiagramFrame from "./DiagramFrame.astro";
interface Props { class?: string }
---

<DiagramFrame class={Astro.props.class} id="lumber-diagram-caption" title="Lumber Diagram">
  <svg class="diagram-svg" viewBox="0 0 410 232" role="img" aria-label="Three equal boards with the length dimension along one piece">
    <g stroke="#244858" stroke-width="1.6" stroke-linejoin="round">
      <path d="M44 94h225l33 19H77Z" fill="#efd5ae"/>
      <path d="M44 94l33 19v18l-33-19Z M44 118l33 19v18l-33-19Z M44 142l33 19v18l-33-19Z" fill="#c9a477"/>
      <path d="M77 113h225v18H77Z M77 137h225v18H77Z M77 161h225v18H77Z" fill="#ead1ad"/>
      <path d="M77 71h225m0-5v10M77 66v10" fill="none"/>
    </g>
    <g fill="#244858" font-size="16" font-weight="600">
      <text x="190" y="59" text-anchor="middle">Length per board</text>
      <text x="318" y="150">3 boards</text>
      <text x="205" y="214" text-anchor="middle">3 × 8 ft = 24 linear ft</text>
    </g>
  </svg>
  <span slot="caption">Example with zero waste: three 8 ft boards give 24 linear ft. Select the board size, enter length and quantity, then set the waste allowance for your order.</span>
</DiagramFrame>
