---
export type ButtonVariant = 'primary' | 'secondary' | 'ghost' | 'outline' | 'white';
export type ButtonSize = 'sm' | 'md' | 'lg';

interface Props {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
  ariaLabel,
} = Astro.props;

const base =
  'inline-flex items-center justify-center font-semibold transition-[background-color,transform,border-color,color] duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] disabled:opacity-50 disabled:cursor-not-allowed';

const variants: Record<ButtonVariant, string> = {
  primary:
    'bg-[var(--color-primary)] text-white rounded-full hover:bg-[var(--color-primary-hover)] hover:-translate-y-px active:translate-y-0',
  secondary:
    'bg-[var(--border-subtle)] text-[var(--color-text-primary)] rounded-lg hover:bg-[var(--border-default)]',
  ghost:
    'text-[var(--color-text-secondary)] rounded-lg hover:bg-[var(--border-subtle)] hover:text-[var(--color-text-primary)]',
  outline:
    'border border-[var(--border-default)] text-[var(--color-text-primary)] rounded-full hover:border-[var(--color-primary)] hover:text-[var(--color-primary)]',
  white:
    'bg-white text-[var(--color-text-primary)] rounded-full hover:bg-[var(--color-primary-50)] hover:-translate-y-px font-semibold',
};

const sizes: Record<ButtonSize, string> = {
  sm: 'text-sm px-3.5 py-1.5 gap-1.5',
  md: 'text-sm px-4.5 py-2.5 gap-2',
  lg: 'text-base px-6 py-3 gap-2',
};

const classes = [base, variants[variant], sizes[size], className].join(' ');
---

{href ? (
  <a href={href} class={classes} aria-label={ariaLabel}>
    <slot />
  </a>
) : (
  <button type={type} class={classes} disabled={disabled} aria-label={ariaLabel}>
    <slot />
  </button>
)}
