---
interface Props {
  variant?: 'default' | 'bordered' | 'flat' | 'calculator';
  padding?: 'sm' | 'md' | 'lg' | 'none';
  class?: string;
  href?: string;
}

const {
  variant = 'default',
  padding = 'md',
  class: className = '',
  href,
} = Astro.props;

const variantClasses = {
  default:    'bg-white border border-[var(--border-default)] shadow-[var(--shadow-card)]',
  bordered:   'bg-white border border-[var(--border-default)]',
  flat:       'bg-[var(--surface-page)]',
  calculator: 'bg-white border border-[var(--border-default)] shadow-[var(--shadow-widget)]',
};

const paddingClasses = {
  none: '',
  sm:   'p-4',
  md:   'p-5',
  lg:   'p-7',
};

const hoverClasses = href
  ? 'transition-all hover:shadow-[var(--shadow-hover)] hover:-translate-y-0.5 hover:border-[var(--border-strong)] cursor-pointer'
  : '';

const classes = [
  'rounded-2xl overflow-hidden',
  variantClasses[variant],
  paddingClasses[padding],
  hoverClasses,
  className,
].join(' ');
---

{href ? (
  <a href={href} class={classes}>
    <slot />
  </a>
) : (
  <div class={classes}>
    <slot />
  </div>
)}
