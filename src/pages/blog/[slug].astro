---
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import RelatedCalculators from '../../components/calculators/RelatedCalculators.astro';
import { buildArticleMeta } from '../../utils/seo';
import { buildArticleSchema, buildBreadcrumbList, buildFaqSchema, parseFaqFromMarkdown } from '../../utils/schema';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { calculatorRegistry } from '../../data/registry';
import { categories } from '../../data/categories';
import type { CalculatorConfig } from '../../calculators/_types';
import type { GetStaticPaths } from 'astro';

const CATEGORY_SLUGS = new Set(categories.map(c => c.slug));

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  posts.sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
  return posts.map((post, i) => {
    const slug = post.id.replace(/\.[^.]+$/, '');
    const prevPost = posts[i + 1]
      ? { title: posts[i + 1].data.title, slug: posts[i + 1].id.replace(/\.[^.]+$/, '') }
      : undefined;
    const nextPost = posts[i - 1]
      ? { title: posts[i - 1].data.title, slug: posts[i - 1].id.replace(/\.[^.]+$/, '') }
      : undefined;
    return {
      params: { slug },
      props: { post, slug, prevPost, nextPost },
    };
  });
};

type Props = {
  post: CollectionEntry<'blog'>;
  slug: string;
  prevPost?: { title: string; slug: string; };
  nextPost?: { title: string; slug: string; };
};

const { post, slug, prevPost, nextPost } = Astro.props as Props;
const { Content } = await render(post);

const wordCount = (post.body ?? '').trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));

const meta = buildArticleMeta({
  title: post.data.title,
  description: post.data.description,
  slug,
  section: 'blog',
  publishedAt: post.data.publishedAt,
  updatedAt: post.data.updatedAt,
  ogImage: post.data.featuredImage,
});

const faqItems = parseFaqFromMarkdown(post.body ?? '');

const schemas = [
  buildArticleSchema({
    title: post.data.title,
    description: post.data.description,
    url: meta.canonical,
    imageUrl: post.data.featuredImage ?? 'https://buildbymath.com/og-default.png',
    publishedAt: post.data.publishedAt,
    updatedAt: post.data.updatedAt,
    authorName: post.data.author,
    type: 'Article',
  }),
  buildBreadcrumbList([
    { name: 'Home', href: '/' },
    { name: 'Blog', href: '/blog/' },
    { name: post.data.title, href: `/blog/${slug}/` },
  ]),
  ...(faqItems.length ? [buildFaqSchema(faqItems)] : []),
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
  { name: post.data.title, href: `/blog/${slug}/` },
];

const relatedCalcSlugs: string[] = (post.data.relatedCalculators as string[]) ?? [];
const relatedCalcs = relatedCalcSlugs
  .map(s => calculatorRegistry.find(c => c.slug === s))
  .filter((c): c is CalculatorConfig => c !== undefined);

const categoryLinks = ((post.data.tags as string[]) ?? [])
  .filter(t => CATEGORY_SLUGS.has(t))
  .map(t => {
    const cat = categories.find(c => c.slug === t)!;
    return { name: cat.name, slug: cat.slug };
  });
---

<ArticleLayout
  meta={meta}
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  variant="blog"
  title={post.data.title}
  description={post.data.description}
  publishedAt={post.data.publishedAt}
  updatedAt={post.data.updatedAt}
  author={post.data.author}
  readingTime={readingTime}
  featuredImage={post.data.featuredImage}
  tags={post.data.tags}
  categoryLinks={categoryLinks}
  prevPost={prevPost}
  nextPost={nextPost}
>
  <Content />
  {relatedCalcs.length > 0 && (
    <RelatedCalculators slot="related" calcs={relatedCalcs} />
  )}
</ArticleLayout>
