---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { buildBlogIndexMeta, buildCanonical } from '../../utils/seo';
import { buildBreadcrumbList } from '../../utils/schema';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';

const SITE_URL = 'https://constructcalc.com';
const CATEGORY_SLUGS = new Set(categories.map(c => c.slug));

const meta = buildBlogIndexMeta();

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

// Derive all unique tags from published posts
const allTags = [...new Set(allPosts.flatMap(p => (p.data.tags as string[]) ?? []))].sort();

// URL-based active filter (static build: read from ?tag= via JS)
// We render all posts and filter client-side for snappy UX without extra static pages

const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'ConstructCalc Blog',
  description: 'Construction tips, material guides, cost breakdowns, and project planning for contractors and DIYers.',
  url: buildCanonical('/blog/'),
  publisher: {
    '@type': 'Organization',
    name: 'ConstructCalc',
    url: SITE_URL,
  },
  blogPost: allPosts.map(post => {
    const slug = post.id.replace(/\.[^.]+$/, '');
    return {
      '@type': 'BlogPosting',
      headline: post.data.title,
      description: post.data.description,
      url: `${SITE_URL}/blog/${slug}/`,
      datePublished: post.data.publishedAt,
      ...(post.data.updatedAt ? { dateModified: post.data.updatedAt } : {}),
    };
  }),
};

const schemas = [
  blogSchema,
  buildBreadcrumbList([
    { name: 'Home', href: '/' },
    { name: 'Blog', href: '/blog/' },
  ]),
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Blog', href: '/blog/' },
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="page-header">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="page-title">Construction Blog</h1>
      <p class="page-sub">Material guides, cost breakdowns, and project planning for contractors and DIYers.</p>
    </div>
  </div>

  <div class="page-body">
    <div class="container">

      <!-- Tag / category filter -->
      <div class="filter-bar" id="filter-bar">
        <button class="filter-chip is-active" data-tag="all">All</button>
        {allTags.map(tag => (
          <button class="filter-chip" data-tag={tag}>
            {tag.charAt(0).toUpperCase() + tag.slice(1)}
          </button>
        ))}
      </div>

      {allPosts.length === 0 ? (
        <div class="empty-state">
          <p>Articles coming soon.</p>
        </div>
      ) : (
        <div class="posts-grid" id="posts-grid">
          {allPosts.map(post => {
            const slug = post.id.replace(/\.[^.]+$/, '');
            const displayDate = post.data.updatedAt ?? post.data.publishedAt;
            const dateLabel = post.data.updatedAt ? 'Updated' : '';
            const date = new Date(displayDate as string).toLocaleDateString('en-US', {
              year: 'numeric', month: 'short', day: 'numeric',
            });
            const wordCount = (post.body ?? '').trim().split(/\s+/).length;
            const readingTime = Math.max(1, Math.ceil(wordCount / 200));
            const tags = (post.data.tags as string[]) ?? [];
            return (
              <a
                href={`/blog/${slug}/`}
                class="post-card"
                data-tags={tags.join(',')}
              >
                {post.data.featuredImage ? (
                  <div class="post-image">
                    <img
                      src={post.data.featuredImage}
                      alt={post.data.title}
                      width="400"
                      height="210"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  <div class="post-image post-image--placeholder" aria-hidden="true">
                    <svg width="32" height="32" viewBox="0 0 28 28" fill="none">
                      <rect x="2" y="14" width="7" height="12" rx="1.5" fill="currentColor" opacity="0.3"/>
                      <rect x="10.5" y="8" width="7" height="18" rx="1.5" fill="currentColor" opacity="0.2"/>
                      <rect x="19" y="2" width="7" height="24" rx="1.5" fill="currentColor" opacity="0.15"/>
                    </svg>
                  </div>
                )}
                <div class="post-body">
                  <div class="post-meta">
                    <time datetime={displayDate as string} class="post-date">
                      {dateLabel && <span class="post-date-label">{dateLabel} </span>}{date}
                    </time>
                    <span class="post-read">{readingTime} min read</span>
                  </div>
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-desc">{post.data.description}</p>
                  <div class="post-footer">
                    <div class="post-tags">
                      {tags.slice(0, 2).map(tag => (
                        <span
                          class={`post-tag${CATEGORY_SLUGS.has(tag) ? ' post-tag--category' : ''}`}
                          data-tag-link={tag}
                          onclick={`event.preventDefault(); filterByTag('${tag}')`}
                        >
                          {tag}
                        </span>
                      ))}
                    </div>
                    <span class="post-cta">
                      Read
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                        <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      )}

      <div class="no-results" id="no-results" style="display:none">
        <p>No articles found for this filter.</p>
      </div>

    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-default);
    padding: 2rem 0 2.5rem;
  }

  .container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    margin-top: 1rem;
    line-height: 1.1;
  }

  .page-sub {
    margin-top: 0.625rem;
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 44rem;
    line-height: 1.6;
  }

  .page-body {
    padding: 2.5rem 0 5rem;
  }

  /* Filter bar */
  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .filter-chip {
    padding: 0.375rem 0.875rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 150ms, color 150ms, background 150ms;
  }
  .filter-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .filter-chip.is-active {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: #fff;
  }

  /* Grid */
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 640px)  { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .posts-grid { grid-template-columns: repeat(3, 1fr); } }

  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 16px;
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: box-shadow 150ms, transform 150ms;
  }
  .post-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
  }
  .post-card[data-hidden] { display: none; }

  .post-image {
    width: 100%;
    aspect-ratio: 16 / 8.4;
    overflow: hidden;
    background: var(--border-subtle);
  }
  .post-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 300ms;
  }
  .post-card:hover .post-image img { transform: scale(1.03); }

  .post-image--placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    background: var(--surface-page);
  }

  .post-body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.25rem 1.5rem 1.5rem;
    flex: 1;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .post-date {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .post-date-label {
    color: var(--color-primary);
    font-weight: 600;
  }

  .post-read {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }
  .post-read::before { content: '·'; margin-right: 0.25rem; color: var(--border-default); }

  .post-title {
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .post-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 0.25rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .post-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0.1875rem 0.5rem;
    background: var(--color-primary-50);
    color: var(--color-primary);
    border-radius: 9999px;
    cursor: pointer;
    transition: background 150ms;
  }
  .post-tag:hover { background: var(--color-primary-100); }
  .post-tag--category {
    background: #f0fdf4;
    color: #15803d;
  }
  .post-tag--category:hover { background: #dcfce7; }

  .post-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .no-results {
    text-align: center;
    padding: 4rem 1rem;
    border: 1px dashed var(--border-default);
    border-radius: 12px;
    color: var(--color-text-muted);
  }

  .empty-state {
    text-align: center;
    padding: 4rem 1rem;
    border: 1px dashed var(--border-default);
    border-radius: 12px;
    color: var(--color-text-muted);
  }
</style>

<script>
  function filterByTag(tag: string) {
    const bar = document.getElementById('filter-bar');
    const grid = document.getElementById('posts-grid');
    const noResults = document.getElementById('no-results');
    if (!bar || !grid) return;

    // Update active chip
    bar.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach(chip => {
      chip.classList.toggle('is-active', chip.dataset.tag === tag);
    });

    // Show/hide cards
    const cards = grid.querySelectorAll<HTMLElement>('.post-card');
    let visible = 0;
    cards.forEach(card => {
      const tags = card.dataset.tags?.split(',') ?? [];
      const match = tag === 'all' || tags.includes(tag);
      if (match) {
        card.removeAttribute('data-hidden');
        visible++;
      } else {
        card.setAttribute('data-hidden', '');
      }
    });

    if (noResults) noResults.style.display = visible === 0 ? 'block' : 'none';

    // Update URL without reload
    const url = new URL(window.location.href);
    if (tag === 'all') url.searchParams.delete('tag');
    else url.searchParams.set('tag', tag);
    history.replaceState(null, '', url.toString());
  }

  // Wire filter chips
  document.getElementById('filter-bar')?.querySelectorAll<HTMLButtonElement>('.filter-chip').forEach(chip => {
    chip.addEventListener('click', () => filterByTag(chip.dataset.tag ?? 'all'));
  });

  // Restore filter from URL on load
  const params = new URLSearchParams(window.location.search);
  const activeTag = params.get('tag');
  if (activeTag) filterByTag(activeTag);

  // Expose for inline onclick on tag pills
  (window as any).filterByTag = filterByTag;
</script>
