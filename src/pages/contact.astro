---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { buildPageTitle, buildCanonical } from '../utils/seo';
import { DEFAULT_OG_IMAGE } from '../utils/constants';
import { buildBreadcrumbList } from '../utils/schema';

const meta = {
  title: buildPageTitle('Contact BuildByMath'),
  description: 'Contact the BuildByMath team. Report formula errors, suggest new calculators, or ask questions about any tool.',
  canonical: buildCanonical('/contact/'),
  ogType: 'website' as const,
  ogImage: DEFAULT_OG_IMAGE,
};

const schemas = [
  buildBreadcrumbList([
    { name: 'Home', href: '/' },
    { name: 'Contact', href: '/contact/' },
  ]),
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="page-header">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="page-title">Contact Us</h1>
      <p class="page-sub">Questions, formula corrections, or calculator suggestions — we read every message.</p>
    </div>
  </div>

  <div class="page-body">
    <div class="container-narrow">

      <div class="contact-grid">
        <div class="contact-reasons">
          <h2>How Can We Help?</h2>

          <div class="reason-card">
            <div class="reason-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 2v20M2 12h20"/>
              </svg>
            </div>
            <div>
              <h3>Suggest a Calculator</h3>
              <p>We're always adding new tools. If there's a calculation you need that we don't have, let us know — we prioritize based on user demand.</p>
            </div>
          </div>

          <div class="reason-card">
            <div class="reason-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
              </svg>
            </div>
            <div>
              <h3>Report a Formula Error</h3>
              <p>If you've found a result that doesn't match your hand calculations or industry references, please report it. Formula accuracy is our top priority.</p>
            </div>
          </div>

          <div class="reason-card">
            <div class="reason-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z"/>
              </svg>
            </div>
            <div>
              <h3>General Questions</h3>
              <p>Questions about a specific calculation, unit conversions, or how to apply a result to your project.</p>
            </div>
          </div>
        </div>

        <div class="contact-form-wrap">
          <h2>Send a Message</h2>

          <!-- Success banner (hidden until submission succeeds) -->
          <div id="form-success" class="form-banner form-banner--success" role="alert" aria-live="polite" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            <div>
              <strong>Message sent!</strong> Thanks for reaching out — we typically reply within 1–2 business days.
            </div>
          </div>

          <!-- Error banner (hidden until a submission error occurs) -->
          <div id="form-error" class="form-banner form-banner--error" role="alert" aria-live="polite" hidden>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div id="form-error-text">Something went wrong. Please try again.</div>
          </div>

          <!--
            action: Formspree endpoint (fallback for non-JS; JS intercepts and uses fetch).
            The Accept: application/json header in the fetch call tells Formspree to
            return JSON instead of redirecting, preventing the 405 error.
          -->
          <form
            id="contact-form"
            class="contact-form"
            name="contact"
            method="POST"
            action="https://formspree.io/f/xppqznyz"
            novalidate
            aria-label="Contact form"
          >
            <!-- Honeypot: Formspree ignores submissions where this field is filled.
                 Hidden via CSS — real users never see or fill it. -->
            <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

            <div class="form-group">
              <label for="name" class="form-label">Your Name <span class="required-mark" aria-hidden="true">*</span></label>
              <input
                type="text"
                id="name"
                name="name"
                class="form-input"
                placeholder="John Smith"
                required
                autocomplete="name"
                aria-required="true"
                aria-describedby="name-error"
              />
              <span id="name-error" class="field-error" role="alert" aria-live="polite" hidden>Please enter your name.</span>
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email Address <span class="required-mark" aria-hidden="true">*</span></label>
              <input
                type="email"
                id="email"
                name="email"
                class="form-input"
                placeholder="you@example.com"
                required
                autocomplete="email"
                aria-required="true"
                aria-describedby="email-error"
              />
              <span id="email-error" class="field-error" role="alert" aria-live="polite" hidden>Please enter a valid email address.</span>
            </div>

            <div class="form-group">
              <label for="subject" class="form-label">Subject <span class="required-mark" aria-hidden="true">*</span></label>
              <select
                id="subject"
                name="subject"
                class="form-input"
                required
                aria-required="true"
                aria-describedby="subject-error"
              >
                <option value="">— Please select —</option>
                <option value="formula-error">Report a formula error</option>
                <option value="suggest-calculator">Suggest a calculator</option>
                <option value="general">General question</option>
                <option value="other">Other</option>
              </select>
              <span id="subject-error" class="field-error" role="alert" aria-live="polite" hidden>Please select a subject.</span>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message <span class="required-mark" aria-hidden="true">*</span></label>
              <textarea
                id="message"
                name="message"
                class="form-input form-textarea"
                placeholder="Describe your question or issue..."
                rows="5"
                required
                aria-required="true"
                aria-describedby="message-error"
              ></textarea>
              <span id="message-error" class="field-error" role="alert" aria-live="polite" hidden>Please enter a message.</span>
            </div>

            <button type="submit" id="form-submit" class="form-submit" aria-busy="false">
              <span class="submit-label">Send Message</span>
              <span class="submit-spinner" aria-hidden="true" hidden>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="spinner-icon"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
                Sending…
              </span>
            </button>
          </form>

          <p class="form-note">We typically respond within 1–2 business days. For urgent formula issues, please include the calculator name and the inputs you used.</p>
        </div>
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  (function () {
    const FORMSPREE_URL = 'https://formspree.io/f/xppqznyz';

    const form      = document.getElementById('contact-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('form-submit') as HTMLButtonElement | null;
    const successEl = document.getElementById('form-success') as HTMLElement | null;
    const errorEl   = document.getElementById('form-error') as HTMLElement | null;
    const errorText = document.getElementById('form-error-text') as HTMLElement | null;

    if (!form || !submitBtn) return;

    // ─── Helpers ────────────────────────────────────────────────────────────────

    function setFieldError(input: HTMLElement, errorId: string, show: boolean) {
      const errorEl = document.getElementById(errorId);
      if (!errorEl) return;
      if (show) {
        input.setAttribute('aria-invalid', 'true');
        errorEl.hidden = false;
      } else {
        input.removeAttribute('aria-invalid');
        errorEl.hidden = true;
      }
    }

    function isValidEmail(val: string): boolean {
      return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val.trim());
    }

    // Clear field error on user input
    function clearOnInput(id: string, errorId: string) {
      const el = document.getElementById(id);
      if (!el) return;
      el.addEventListener('input', () => setFieldError(el, errorId, false));
      el.addEventListener('change', () => setFieldError(el, errorId, false));
    }
    clearOnInput('name',    'name-error');
    clearOnInput('email',   'email-error');
    clearOnInput('subject', 'subject-error');
    clearOnInput('message', 'message-error');

    // ─── Client-side validation ─────────────────────────────────────────────────

    function validate(): boolean {
      let ok = true;

      const nameEl    = document.getElementById('name')    as HTMLInputElement;
      const emailEl   = document.getElementById('email')   as HTMLInputElement;
      const subjectEl = document.getElementById('subject') as HTMLSelectElement;
      const messageEl = document.getElementById('message') as HTMLTextAreaElement;

      if (!nameEl.value.trim()) {
        setFieldError(nameEl, 'name-error', true);
        ok = false;
      }
      if (!emailEl.value.trim() || !isValidEmail(emailEl.value)) {
        setFieldError(emailEl, 'email-error', true);
        ok = false;
      }
      if (!subjectEl.value) {
        setFieldError(subjectEl, 'subject-error', true);
        ok = false;
      }
      if (!messageEl.value.trim()) {
        setFieldError(messageEl, 'message-error', true);
        ok = false;
      }

      return ok;
    }

    // ─── UI state helpers ────────────────────────────────────────────────────────

    function setSubmitting(busy: boolean) {
      const label   = submitBtn!.querySelector('.submit-label') as HTMLElement;
      const spinner = submitBtn!.querySelector('.submit-spinner') as HTMLElement;
      submitBtn!.disabled = busy;
      submitBtn!.setAttribute('aria-busy', String(busy));
      label.hidden   = busy;
      spinner.hidden = !busy;
    }

    function showBanner(type: 'success' | 'error', message?: string) {
      if (successEl) successEl.hidden = type !== 'success';
      if (errorEl)   errorEl.hidden   = type !== 'error';
      if (type === 'error' && errorText && message) {
        errorText.textContent = message;
      }
      // Scroll banner into view
      const banner = type === 'success' ? successEl : errorEl;
      banner?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function hideBanners() {
      if (successEl) successEl.hidden = true;
      if (errorEl)   errorEl.hidden   = true;
    }

    // ─── Submit handler ──────────────────────────────────────────────────────────

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      hideBanners();

      if (!validate()) {
        // Focus the first invalid field for accessibility
        const firstInvalid = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
        firstInvalid?.focus();
        return;
      }

      setSubmitting(true);

      try {
        const data = new FormData(form);
        const response = await fetch(FORMSPREE_URL, {
          method: 'POST',
          body: data,
          headers: { 'Accept': 'application/json' },
        });

        if (response.ok) {
          showBanner('success');
          form.reset();
        } else {
          const json = await response.json().catch(() => ({}));
          const msg = (json as any)?.errors?.map((err: any) => err.message).join(' ') ||
                      'Submission failed. Please try again.';
          showBanner('error', msg);
        }
      } catch {
        showBanner('error', 'Network error — please check your connection and try again.');
      } finally {
        setSubmitting(false);
      }
    });
  })();
</script>

<style>
  .page-header {
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-default);
    padding: 2rem 0 2.5rem;
  }

  .container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .container-narrow {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .page-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    margin-top: 1rem;
    line-height: 1.1;
  }

  .page-sub {
    margin-top: 0.625rem;
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .page-body {
    padding: 3rem 0 5rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 768px) {
    .contact-grid { grid-template-columns: 1fr 1fr; align-items: start; }
  }

  .contact-reasons h2,
  .contact-form-wrap h2 {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .reason-card {
    display: flex;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    margin-bottom: 0.875rem;
  }

  .reason-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-primary-50);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    flex-shrink: 0;
  }

  .reason-card h3 {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .reason-card p {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ── Banners ── */
  .form-banner {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.875rem 1rem;
    border-radius: 10px;
    font-size: 0.875rem;
    line-height: 1.5;
    margin-bottom: 1.25rem;
  }
  .form-banner svg { flex-shrink: 0; margin-top: 0.1em; }
  .form-banner--success {
    background: #f0fdf4;
    border: 1px solid #86efac;
    color: #166534;
  }
  .form-banner--error {
    background: #fef2f2;
    border: 1px solid #fca5a5;
    color: #991b1b;
  }

  /* ── Form ── */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .form-label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .required-mark {
    color: var(--color-primary);
    margin-left: 0.125rem;
  }

  .form-input {
    width: 100%;
    padding: 0.625rem 0.875rem;
    background: var(--surface-card);
    border: 1.5px solid var(--border-strong);
    border-radius: 8px;
    font-size: 0.9375rem;
    color: var(--color-text-primary);
    transition: border-color 150ms;
    appearance: none;
  }

  .form-input:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-50);
  }

  .form-input[aria-invalid="true"] {
    border-color: #ef4444;
  }
  .form-input[aria-invalid="true"]:focus {
    box-shadow: 0 0 0 3px #fee2e2;
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  /* Inline field errors */
  .field-error {
    font-size: 0.8125rem;
    color: #dc2626;
    font-weight: 500;
  }

  /* ── Submit button ── */
  .form-submit {
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 700;
    border: none;
    border-radius: 9999px;
    cursor: pointer;
    transition: background 150ms, transform 150ms, opacity 150ms;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .form-submit:hover:not(:disabled) {
    background: var(--color-primary-hover);
    transform: translateY(-1px);
  }
  .form-submit:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }

  /* Spinner animation */
  .submit-spinner {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }
  .spinner-icon {
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .form-note {
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
</style>