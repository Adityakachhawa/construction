---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildHomeMeta } from '../utils/seo';
import { buildWebSiteSchema, buildOrganizationSchema, buildFaqSchema } from '../utils/schema';
import { categories } from '../data/categories';
import { getFeaturedCalculators, calculatorRegistry, getCalculatorsByCategory } from '../data/registry';
import CategoryIcon from '../components/ui/CategoryIcon.astro';
import { getCollection } from 'astro:content';

const meta = buildHomeMeta();
const totalCalcs = calculatorRegistry.length;
const featuredCalcs = getFeaturedCalculators(6);

// Search index — inlined into the page so search works without a network request
const searchIndex = calculatorRegistry.map(c => ({
  slug: c.slug,
  name: c.name,
  description: c.description,
  category: c.category,
}));

// Fetch recent blog posts
const posts = await getCollection('blog', ({ data }) => !data.draft);
posts.sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));
const recentPosts = posts.slice(0, 6);

const formulas = [
  {
    name: 'Concrete Volume',
    formula: 'L × W × T ÷ 27',
    desc: 'Cubic yards for any slab',
    href: '/calculators/concrete-slab-calculator/',
  },
  {
    name: 'Rafter Length',
    formula: '√(Run² + Rise²)',
    desc: 'Pythagorean method',
    href: '/calculators/rafter-calculator/',
  },
  {
    name: 'Roof Pitch',
    formula: 'Rise ÷ Run × 12',
    desc: 'X:12 slope ratio',
    href: '/calculators/roof-pitch-calculator/',
  },
  {
    name: 'Stud Count',
    formula: '(Wall ÷ Spacing) + 1',
    desc: 'Field studs per wall',
    href: '/calculators/stud-calculator/',
  },
  {
    name: 'Gravel Volume',
    formula: 'L × W × D ÷ 27',
    desc: 'Cubic yards of fill',
    href: '/calculators/gravel-calculator/',
  },
  {
    name: 'Board Feet',
    formula: 'T × W × L ÷ 12',
    desc: 'Lumber pricing unit',
    href: '/calculators/board-foot-calculator/',
  },
];

const faqs = [
  {
    q: 'How much concrete do I need for a 10×10 slab at 4 inches thick?',
    a: 'A 10×10 slab at 4 inches thick requires about 1.23 cubic yards. Add a 10% waste factor and you need roughly 1.35 yards — around 25 bags of 80 lb concrete mix. Use the concrete slab calculator to adjust for any dimensions.',
  },
  {
    q: 'How many bags of concrete do I need per post hole?',
    a: 'A standard 10-inch diameter hole 3 feet deep takes about half an 80 lb bag. For a 6-inch diameter hole at 2 feet deep, one 40 lb bag per hole is usually sufficient. Hole diameter and depth are the main variables — the post hole calculator handles both.',
  },
  {
    q: 'What waste factor should I use for roofing shingles?',
    a: 'Use 10% for simple gable roofs and 15% for hip roofs, multi-valley roofs, or pitches above 8:12. Always round up to whole squares when ordering — a partial square costs the same to deliver.',
  },
  {
    q: 'How do I calculate the number of studs for a wall?',
    a: 'Divide wall length in inches by stud spacing (16 or 24 inches) and add 1 for the end stud. Add 3 studs per corner assembly and 4 studs per opening (2 king + 2 jack studs). The stud calculator handles all of this automatically.',
  },
  {
    q: 'Are these calculators accurate enough for contractor use?',
    a: 'Yes. Our formulas follow ACI, IRC, and NRCA industry standards — the same references used by engineers and estimators. Results are material estimates; always verify critical quantities with your supplier and add appropriate waste factors for your specific conditions.',
  },
];

const schemas = [
  buildWebSiteSchema(),
  buildOrganizationSchema(),
  buildFaqSchema(faqs.map(f => ({ question: f.q, answer: f.a }))),
];
---

<BaseLayout meta={meta} schemas={schemas}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-inner">
      <h1 class="hero-headline">
        Construction calculators<br/>that actually work on site.
      </h1>

      <p class="hero-sub">
        Accurate material estimates for concrete, framing, roofing, excavation,
        masonry, and more. Built for contractors and serious DIYers.
      </p>

      <!-- Category pills — visible without scroll on mobile -->
      <div class="hero-cats">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}/`} class="hero-cat-pill" style={`--accent: ${cat.color}`}>
            {cat.name}
          </a>
        ))}
      </div>

      <!-- Search bar -->
      <div class="hero-search-wrap">
        <div class="hero-search">
          <svg class="hero-search-icon" width="18" height="18" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.5"/>
            <path d="M13 13l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
          <input
            id="hero-search-input"
            type="search"
            placeholder="Search calculators — concrete, rebar, roof pitch…"
            class="hero-search-input"
            autocomplete="off"
            aria-label="Search calculators"
          />
        </div>
        <div id="hero-search-results" class="hero-search-results" aria-live="polite"></div>
      </div>

      <div class="hero-actions">
        <a href="/calculators/" class="hero-btn-primary">
          Browse all {totalCalcs} calculators
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/blog/" class="hero-btn-ghost">Read the guides</a>
      </div>

      <div class="hero-proof">
        <span>{totalCalcs}+ calculators</span>
        <span class="hero-proof-sep">·</span>
        <span>{categories.length} categories</span>
        <span class="hero-proof-sep">·</span>
        <span>Imperial &amp; metric</span>
        <span class="hero-proof-sep">·</span>
        <span>No signup</span>
      </div>
    </div>
  </section>

  <!-- ── Popular Calculators ──────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">Popular calculators</h2>
          <p class="section-sub">Most-used tools by contractors and DIYers</p>
        </div>
        <a href="/calculators/" class="section-link">View all {totalCalcs} →</a>
      </div>
      <div class="calc-grid">
        {featuredCalcs.map(calc => {
          const cat = categories.find(c => c.slug === calc.category);
          return (
            <a href={`/calculators/${calc.slug}/`} class="calc-card" style={`--accent: ${cat?.color ?? '#ea580c'}`}>
              <div class="calc-card-icon">
                <CategoryIcon name={calc.category} size={22} />
              </div>
              <h3 class="calc-card-title">{calc.name}</h3>
              <p class="calc-card-desc">{calc.description}</p>
              <span class="calc-card-cta">
                Open calculator
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Category Grid ─────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">Browse by category</h2>
          <p class="section-sub">Every trade, every material</p>
        </div>
      </div>
      <div class="cat-grid">
        {categories.map(cat => {
          const count = getCalculatorsByCategory(cat.slug).length;
          return (
            <a href={`/category/${cat.slug}/`} class="cat-card" style={`--accent: ${cat.color}`}>
              <div class="cat-card-icon">
                <CategoryIcon name={cat.icon} size={28} />
              </div>
              <span class="cat-card-name">{cat.name}</span>
              <span class="cat-card-count">{count} calculator{count !== 1 ? 's' : ''}</span>
              <span class="cat-card-desc">{cat.shortDescription}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ── Common Formulas ───────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header--center">
        <div>
          <h2 class="section-title">Construction formula reference</h2>
          <p class="section-sub">The six most common calculations — click any to open the full calculator</p>
        </div>
      </div>
      <div class="formula-grid">
        {formulas.map(f => (
          <a href={f.href} class="formula-card">
            <span class="formula-name">{f.name}</span>
            <code class="formula-eq">{f.formula}</code>
            <span class="formula-desc">{f.desc}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why section ───────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header section-header--center">
        <div>
          <h2 class="section-title">Why professionals use ConstructCalc</h2>
          <p class="section-sub">Built for the job site, not the classroom</p>
        </div>
      </div>
      <div class="features-grid">
        {[
          {
            icon: `<path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
            title: 'Contractor-grade formulas',
            body: 'Industry-standard calculations with built-in waste factors. Same math used by professionals on every project.',
          },
          {
            icon: `<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M9 2v20M15 2v20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".4"/>`,
            title: 'Imperial & metric, one click',
            body: 'Switch unit systems without re-entering a single number. Results update instantly.',
          },
          {
            icon: `<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M12 8v4l3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
            title: 'No account, no waiting',
            body: 'Open a calculator, enter dimensions, get your answer. No email, no signup, no friction.',
          },
          {
            icon: `<rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/><path d="M6 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
            title: 'Cost estimates built in',
            body: 'Enter your local material price to get a budget estimate alongside every volume calculation.',
          },
          {
            icon: `<path d="M12 2L2 7l10 5 10-5-10-5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>`,
            title: 'Step-by-step formulas',
            body: 'Every calculator shows exactly how the math works — verify any result against your own calculations.',
          },
          {
            icon: `<rect x="5" y="2" width="14" height="20" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 7h6M9 11h6M9 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
            title: 'Formulas explained',
            body: 'Common project questions answered alongside each calculator — standards, bag counts, and code requirements.',
          },
        ].map(f => (
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={f.icon}></svg>
            </div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>
        ))}
      </div>

      <div class="stats-row">
        {[
          { value: `${totalCalcs}+`, label: 'Calculators' },
          { value: `${categories.length}`, label: 'Trade categories' },
          { value: 'ACI/IRC', label: 'Formula standards' },
          { value: '$0', label: 'Always free' },
        ].map(stat => (
          <div class="stat-block">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Blog / Guides ─────────────────────────────────────────── -->
  {recentPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <h2 class="section-title">Construction guides & articles</h2>
            <p class="section-sub">How-to guides, cost breakdowns, and formula walkthroughs</p>
          </div>
          <a href="/blog/" class="section-link">View all →</a>
        </div>
        <div class="post-grid">
          {recentPosts.map(post => {
            const slug = post.id.replace(/\.[^.]+$/, '');
            return (
              <a href={`/blog/${slug}/`} class="post-card">
                {post.data.tags.slice(0,1).map(t => (
                  <span class="post-tag">{t}</span>
                ))}
                <h3 class="post-title">{post.data.title}</h3>
                <p class="post-desc">{post.data.description}</p>
                <span class="post-cta">Read →</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ── Trust / EEAT ──────────────────────────────────────────── -->
  <section class="section section--alt trust-section">
    <div class="container">
      <div class="section-header section-header--center">
        <div>
          <h2 class="section-title">Built on industry standards</h2>
          <p class="section-sub">Our formulas follow the same references used by engineers and contractors</p>
        </div>
      </div>
      <div class="trust-grid">
        {[
          { label: 'ACI', desc: 'American Concrete Institute — concrete volume and mix design' },
          { label: 'IRC', desc: 'International Residential Code — footing depth, stud spacing, rafter spans' },
          { label: 'NRCA', desc: 'National Roofing Contractors Association — roofing material estimating' },
          { label: 'PCA', desc: 'Portland Cement Association — concrete mix ratios and curing standards' },
          { label: 'ASTM', desc: 'ASTM International — material weight and density standards' },
          { label: 'WWPA', desc: 'Western Wood Products Association — lumber sizing and span tables' },
        ].map(ref => (
          <div class="trust-card">
            <span class="trust-badge">{ref.label}</span>
            <p class="trust-desc">{ref.desc}</p>
          </div>
        ))}
      </div>
      <div class="trust-links">
        <a href="/methodology/">How our calculations work</a>
        <a href="/about/">About ConstructCalc</a>
        <a href="/contact/">Report an error</a>
      </div>
    </div>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────── -->
  <section class="section">
    <div class="container-narrow">
      <div class="section-header section-header--center">
        <div>
          <h2 class="section-title">Frequently asked questions</h2>
        </div>
      </div>
      <div class="faq-list">
        {faqs.map((item, i) => (
          <details class="faq-item" open={i === 0}>
            <summary class="faq-question">
              {item.q}
              <svg class="faq-chevron" width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                <path d="M4.5 6.75L9 11.25l4.5-4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <p class="faq-answer">{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Bottom CTA ────────────────────────────────────────────── -->
  <section class="cta-section">
    <div class="cta-glow"></div>
    <div class="container cta-inner">
      <h2 class="cta-headline">Start calculating your project today.</h2>
      <p class="cta-sub">
        {totalCalcs}+ free calculators. No signup required. Works on any device.
      </p>
      <div class="cta-actions">
        <a href="/calculators/" class="cta-btn-primary">Browse calculators</a>
        <a href="/blog/" class="cta-btn-ghost">Read the guides</a>
      </div>
    </div>
  </section>

</BaseLayout>

<script define:vars={{ searchIndex }}>
  const input = document.getElementById('hero-search-input');
  const resultsBox = document.getElementById('hero-search-results');
  let activeIndex = -1;

  if (input && resultsBox) {
    const calcs = searchIndex;

    const escapeHtml = (s) => s.replace(/[&<>"']/g, c => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
    ));

    const updateActive = () => {
      const items = resultsBox.querySelectorAll('.sr-item');
      items.forEach((item, i) => {
        item.classList.toggle('is-active', i === activeIndex);
        if (i === activeIndex) item.scrollIntoView({ block: 'nearest' });
      });
    };

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      activeIndex = -1;
      if (!q || q.length < 2) { resultsBox.innerHTML = ''; resultsBox.removeAttribute('data-open'); return; }
      const matches = calcs.filter(c =>
        c.name.toLowerCase().includes(q) || c.description.toLowerCase().includes(q)
      ).slice(0, 6);
      if (!matches.length) { resultsBox.innerHTML = '<p class="sr-empty">No calculators found</p>'; resultsBox.setAttribute('data-open', ''); return; }
      resultsBox.innerHTML = matches.map(c =>
        `<a href="/calculators/${c.slug}/" class="sr-item"><strong>${escapeHtml(c.name)}</strong><span>${escapeHtml(c.description)}</span></a>`
      ).join('');
      resultsBox.setAttribute('data-open', '');
    });

    input.addEventListener('keydown', e => {
      const items = resultsBox.querySelectorAll('.sr-item');
      if (!items.length) return;

      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % items.length;
        updateActive();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = (activeIndex - 1 + items.length) % items.length;
        updateActive();
      } else if (e.key === 'Enter' && activeIndex >= 0) {
        e.preventDefault();
        items[activeIndex].click();
      } else if (e.key === 'Escape') {
        resultsBox.innerHTML = '';
        resultsBox.removeAttribute('data-open');
      }
    });

    document.addEventListener('click', e => {
      if (!input.contains(e.target) && !resultsBox.contains(e.target)) {
        resultsBox.innerHTML = '';
        resultsBox.removeAttribute('data-open');
      }
    });
  }
</script>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--ink);
    overflow: hidden;
    padding: 5.5rem 1.5rem 5rem;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(249,115,22,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 56rem;
    margin: 0 auto;
  }

  .hero-headline {
    font-size: clamp(2.25rem, 5vw, 4rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.1875rem);
    color: #9ca3af;
    line-height: 1.7;
    max-width: 40rem;
    margin: 0 auto 1.75rem;
  }

  /* Category pills */
  .hero-cats {
    display: flex;
    gap: 0.5rem;
    justify-content: center;
    flex-wrap: wrap;
    margin: 0 auto 2rem;
    max-width: 42rem;
  }

  @media (max-width: 639px) {
    .hero-cats {
      flex-wrap: nowrap;
      overflow-x: auto;
      justify-content: flex-start;
      padding-bottom: 0.375rem;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }
    .hero-cats::-webkit-scrollbar { display: none; }
  }

  .hero-cat-pill {
    flex-shrink: 0;
    padding: 0.375rem 0.875rem;
    background: color-mix(in srgb, var(--accent, #6b7280) 15%, rgba(255,255,255,0.04));
    border: 1px solid color-mix(in srgb, var(--accent, #6b7280) 30%, rgba(255,255,255,0.08));
    color: color-mix(in srgb, var(--accent, #9ca3af) 70%, #d1d5db);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
    transition: background 150ms, border-color 150ms;
  }
  .hero-cat-pill:hover {
    background: color-mix(in srgb, var(--accent, #6b7280) 25%, rgba(255,255,255,0.08));
    border-color: color-mix(in srgb, var(--accent, #6b7280) 50%, rgba(255,255,255,0.15));
  }

  /* Search */
  .hero-search-wrap {
    position: relative;
    max-width: 42rem;
    margin: 0 auto 2rem;
  }

  .hero-search {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.125rem;
    background: rgba(255,255,255,0.07);
    border: 1.5px solid rgba(255,255,255,0.14);
    border-radius: 9999px;
    transition: border-color 150ms, background 150ms;
  }
  .hero-search:focus-within {
    border-color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.10);
  }

  .hero-search-icon { color: #6b7280; flex-shrink: 0; }

  .hero-search-input {
    flex: 1;
    padding: 0.875rem 0;
    background: none;
    border: none;
    outline: none;
    font-size: 0.9375rem;
    color: #fff;
  }
  .hero-search-input::placeholder { color: #6b7280; }

  .hero-search-results {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0; right: 0;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 14px;
    box-shadow: var(--shadow-widget);
    overflow: hidden;
    z-index: 50;
  }
  .hero-search-results[data-open] { display: block; }

  .hero-search-results :global(.sr-item) {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding: 0.75rem 1.125rem;
    border-bottom: 1px solid var(--border-subtle);
    transition: background 100ms;
  }
  .hero-search-results :global(.sr-item:last-child) { border-bottom: none; }
  .hero-search-results :global(.sr-item:hover),
  .hero-search-results :global(.sr-item.is-active) { background: var(--border-subtle); }
  .hero-search-results :global(.sr-item strong) { font-size: 0.9rem; color: var(--color-text-primary); }
  .hero-search-results :global(.sr-item span) { font-size: 0.8rem; color: var(--color-text-muted); }
  .hero-search-results :global(.sr-empty) { padding: 1rem; text-align: center; font-size: 0.875rem; color: var(--color-text-muted); }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 2.25rem;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: #fff;
