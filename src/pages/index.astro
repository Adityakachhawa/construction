---
import BaseLayout from '../layouts/BaseLayout.astro';
import { buildHomeMeta } from '../utils/seo';
import { buildWebSiteSchema, buildOrganizationSchema } from '../utils/schema';
import { categories } from '../data/categories';
import { getFeaturedCalculators, calculatorRegistry } from '../data/registry';
import CategoryIcon from '../components/ui/CategoryIcon.astro';

const meta = buildHomeMeta();
const schemas = [buildWebSiteSchema(), buildOrganizationSchema()];
const featuredCalcs = getFeaturedCalculators(6);
const totalCalcs = calculatorRegistry.length;
---

<BaseLayout meta={meta} schemas={schemas}>

  <!-- ── Hero ─────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-glow"></div>
    <div class="hero-inner">
      <div class="hero-badge">
        <span class="hero-badge-dot"></span>
        Free &nbsp;·&nbsp; No signup required &nbsp;·&nbsp; Works on any device
      </div>

      <h1 class="hero-headline">
        Calculate exactly how<br/>much material you need.
      </h1>

      <p class="hero-sub">
        Accurate, instant estimates for concrete, framing, decking,
        fencing, and more. Built for contractors and serious DIYers.
      </p>

      <div class="hero-actions">
        <a href="/calculators/" class="hero-btn-primary">
          Browse Calculators
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="/guides/" class="hero-btn-ghost">View Guides</a>
      </div>

      <div class="hero-proof">
        <span>{totalCalcs > 0 ? `${totalCalcs} calculators` : '12+ calculators'}</span>
        <span class="hero-proof-sep">·</span>
        <span>{categories.length} categories</span>
        <span class="hero-proof-sep">·</span>
        <span>Always free</span>
      </div>
    </div>
  </section>

  <!-- ── Featured Calculators ──────────────────────────────────── -->
  {featuredCalcs.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-header">
          <div>
            <h2 class="section-title">Popular Calculators</h2>
            <p class="section-sub">Most-used tools by contractors and DIYers</p>
          </div>
          <a href="/calculators/" class="section-link">
            View all {totalCalcs > 0 ? totalCalcs : ''} →
          </a>
        </div>
        <div class="calc-grid">
          {featuredCalcs.map(calc => {
            const cat = categories.find(c => c.slug === calc.category);
            return (
              <a href={`/calculators/${calc.slug}/`} class="calc-card" style={`--accent: ${cat?.color ?? '#0070f3'}`}>
                <div class="calc-card-icon">
                  <CategoryIcon name={calc.category} size={22} />
                </div>
                <h3 class="calc-card-title">{calc.name}</h3>
                <p class="calc-card-desc">{calc.description}</p>
                <span class="calc-card-cta">
                  Open calculator
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M2.5 7h9M7.5 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ── Category Grid ─────────────────────────────────────────── -->
  <section class="section section--alt">
    <div class="container">
      <div class="section-header">
        <div>
          <h2 class="section-title">Browse by Category</h2>
          <p class="section-sub">Every trade, every material</p>
        </div>
      </div>
      <div class="cat-grid">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}/`} class="cat-card" style={`--accent: ${cat.color}`}>
            <div class="cat-card-icon">
              <CategoryIcon name={cat.icon} size={28} />
            </div>
            <span class="cat-card-name">{cat.name}</span>
            <span class="cat-card-desc">{cat.shortDescription}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Why section ───────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <div class="section-header section-header--center">
        <div>
          <h2 class="section-title">Why professionals use ConstructCalc</h2>
          <p class="section-sub">Everything you need, nothing you don't</p>
        </div>
      </div>
      <div class="features-grid">
        {([
          {
            icon: `<path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 12a9 9 0 1018 0A9 9 0 003 12" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
            title: 'Contractor-grade formulas',
            body: 'Industry-standard calculations with built-in waste factors used by professionals on every project.',
          },
          {
            icon: `<path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M9 2v20M15 2v20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".4"/>`,
            title: 'Imperial & metric, one click',
            body: 'Switch between unit systems without re-entering a single number. Results update instantly.',
          },
          {
            icon: `<path d="M12 2v20M2 12h20" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" opacity=".4"/><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
            title: 'No account required',
            body: 'Open a calculator, enter your dimensions, get your answer. No email, no signup, no friction.',
          },
          {
            icon: `<rect x="2" y="5" width="20" height="14" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M2 10h20" stroke="currentColor" stroke-width="1.5"/><path d="M6 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
            title: 'Cost estimates built in',
            body: 'Enter your local material price and get a budget estimate alongside your volume calculation.',
          },
          {
            icon: `<path d="M12 2L2 7l10 5 10-5-10-5z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" fill="none"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>`,
            title: 'Step-by-step formulas',
            body: 'Every calculator shows exactly how the math works — so you can verify the result yourself.',
          },
          {
            icon: `<rect x="5" y="2" width="14" height="20" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 7h6M9 11h6M9 15h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`,
            title: 'FAQ on every page',
            body: 'Common project questions answered alongside each calculator — thickness standards, bag counts, and more.',
          },
        ] as const).map((f) => (
          <div class="feature-card">
            <div class="feature-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" set:html={f.icon}></svg>
            </div>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>
        ))}
      </div>

      <!-- Stats row -->
      <div class="stats-row">
        {([
          { value: totalCalcs > 0 ? `${totalCalcs}+` : '12+', label: 'Calculators' },
          { value: `${categories.length}`, label: 'Categories' },
          { value: '2', label: 'Unit systems' },
          { value: '$0', label: 'Cost' },
        ] as const).map(stat => (
          <div class="stat-block">
            <span class="stat-value">{stat.value}</span>
            <span class="stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Bottom CTA ────────────────────────────────────────────── -->
  <section class="cta-section">
    <div class="cta-glow"></div>
    <div class="container cta-inner">
      <h2 class="cta-headline">Start calculating your project today.</h2>
      <p class="cta-sub">
        All calculators are free, work on any device, and require no sign-up.
      </p>
      <div class="cta-actions">
        <a href="/calculators/" class="cta-btn-primary">Browse Calculators</a>
        <a href="/guides/" class="cta-btn-ghost">Read Guides</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--ink);
    overflow: hidden;
    padding: 7rem 1.5rem 6rem;
    text-align: center;
  }

  .hero-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0,112,243,0.18) 0%, transparent 70%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 52rem;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1rem;
    border: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.06);
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: #9ca3af;
    letter-spacing: 0.01em;
    margin-bottom: 2rem;
  }

  .hero-badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 5.5vw, 4.25rem);
    font-weight: 900;
    color: #fff;
    line-height: 1.08;
    letter-spacing: -0.04em;
    margin-bottom: 1.5rem;
  }

  .hero-sub {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #9ca3af;
    line-height: 1.7;
    max-width: 38rem;
    margin: 0 auto 2.5rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-bottom: 2.5rem;
  }

  .hero-btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.75rem;
    background: #fff;
    color: #0a0a0a;
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 9999px;
    transition: background 150ms, transform 150ms;
    letter-spacing: -0.01em;
  }
  .hero-btn-primary:hover {
    background: var(--color-primary-50);
    transform: translateY(-2px);
  }

  .hero-btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 1.75rem;
    border: 1px solid rgba(255,255,255,0.18);
    background: transparent;
    color: #e5e7eb;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 9999px;
    transition: border-color 150ms, background 150ms;
  }
  .hero-btn-ghost:hover {
    border-color: rgba(255,255,255,0.35);
    background: rgba(255,255,255,0.06);
  }

  .hero-proof {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: #6b7280;
    font-weight: 500;
  }

  .hero-proof-sep { opacity: 0.4; }

  /* ── Sections ─────────────────────────────────────────────── */
  .section {
    padding: 5rem 0;
  }
  .section--alt {
    background: var(--ink);
    padding: 5rem 0;
  }

  .container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .section-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .section-header--center {
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .section-title {
    font-size: 1.625rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    line-height: 1.2;
  }
  .section--alt .section-title { color: #fff; }

  .section-sub {
    margin-top: 0.375rem;
    font-size: 0.9375rem;
    color: var(--color-text-muted);
  }
  .section--alt .section-sub { color: #6b7280; }

  .section-link {
    flex-shrink: 0;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: opacity 150ms;
  }
  .section-link:hover { opacity: 0.7; }

  /* ── Calculator cards ─────────────────────────────────────── */
  .calc-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
  }
  @media (min-width: 640px)  { .calc-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .calc-grid { grid-template-columns: repeat(3, 1fr); } }

  .calc-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.375rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-left: 3px solid var(--accent, var(--color-primary));
    border-radius: 16px;
    box-shadow: var(--shadow-card);
    transition: box-shadow 150ms, transform 150ms, border-color 150ms;
    cursor: pointer;
  }
  .calc-card:hover {
    box-shadow: var(--shadow-hover);
    transform: translateY(-3px);
    border-color: var(--accent, var(--color-primary));
  }

  .calc-card-icon {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent, var(--color-primary)) 12%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent, var(--color-primary));
    flex-shrink: 0;
  }

  .calc-card-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .calc-card-desc {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .calc-card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary);
    margin-top: 0.25rem;
  }

  /* ── Category cards ───────────────────────────────────────── */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.875rem;
  }
  @media (min-width: 640px)  { .cat-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { .cat-grid { grid-template-columns: repeat(6, 1fr); } }

  .cat-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.625rem;
    padding: 1.5rem 1rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 16px;
    transition: background 150ms, border-color 150ms, transform 150ms;
    cursor: pointer;
  }
  .cat-card:hover {
    background: rgba(255,255,255,0.07);
    border-color: color-mix(in srgb, var(--accent, #fff) 40%, transparent);
    transform: scale(1.03);
  }

  .cat-card-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent, #6b7280) 15%, rgba(255,255,255,0.04));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent, #9ca3af);
  }

  .cat-card-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.01em;
  }

  .cat-card-desc {
    font-size: 0.75rem;
    color: #6b7280;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ── Features grid ────────────────────────────────────────── */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1rem;
    margin-bottom: 3rem;
  }
  @media (min-width: 640px)  { .features-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .features-grid { grid-template-columns: repeat(3, 1fr); } }

  .feature-card {
    padding: 1.5rem;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: 16px;
  }

  .feature-icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: var(--color-primary-50);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-primary);
    margin-bottom: 1rem;
  }

  .feature-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-bottom: 0.5rem;
  }

  .feature-body {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* ── Stats ────────────────────────────────────────────────── */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  @media (min-width: 640px) { .stats-row { grid-template-columns: repeat(4, 1fr); } }

  .stat-block {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 2rem 1rem;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    border-radius: 16px;
  }

  .stat-value {
    font-size: 3rem;
    font-weight: 900;
    color: var(--color-primary);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .stat-label {
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-muted);
  }

  /* ── CTA ──────────────────────────────────────────────────── */
  .cta-section {
    position: relative;
    background: var(--ink);
    overflow: hidden;
    padding: 6rem 1.5rem;
    text-align: center;
  }

  .cta-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 80% at 50% 50%, rgba(0,112,243,0.14) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-inner {
    position: relative;
    max-width: 42rem;
    margin: 0 auto;
  }

  .cta-headline {
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.04em;
    margin-bottom: 1rem;
  }

  .cta-sub {
    font-size: 1.0625rem;
    color: #9ca3af;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .cta-actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  .cta-btn-primary {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    background: #fff;
    color: #0a0a0a;
    font-size: 0.9375rem;
    font-weight: 700;
    border-radius: 9999px;
    letter-spacing: -0.01em;
    transition: background 150ms, transform 150ms;
  }
  .cta-btn-primary:hover {
    background: var(--color-primary-50);
    transform: translateY(-2px);
  }

  .cta-btn-ghost {
    display: inline-flex;
    align-items: center;
    padding: 0.875rem 2rem;
    border: 1px solid rgba(255,255,255,0.18);
    color: #e5e7eb;
    font-size: 0.9375rem;
    font-weight: 600;
    border-radius: 9999px;
    transition: border-color 150ms;
  }
  .cta-btn-ghost:hover { border-color: rgba(255,255,255,0.35); }
</style>
