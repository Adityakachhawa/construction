---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { buildCalculatorMeta } from '../../utils/seo';
import { buildWebAppSchema, buildBreadcrumbList, buildFaqSchema } from '../../utils/schema';
import { calculatorRegistry, getRelatedCalculators } from '../../data/registry';
import { getCategoryBySlug } from '../../data/categories';
import CalculatorWidget from '../../components/calculators/CalculatorWidget.astro';
import FormulaDisplay from '../../components/calculators/FormulaDisplay.astro';
import FaqSection from '../../components/calculators/FaqSection.astro';
import RelatedCalculators from '../../components/calculators/RelatedCalculators.astro';
import SlabDiagram from '../../components/calculators/SlabDiagram.astro';
import GravelDiagram from '../../components/calculators/GravelDiagram.astro';
import MulchDiagram from '../../components/calculators/MulchDiagram.astro';
import SandDiagram from '../../components/calculators/SandDiagram.astro';
import FencePostDiagram from '../../components/calculators/FencePostDiagram.astro';
import DeckFootingDiagram from '../../components/calculators/DeckFootingDiagram.astro';
import RetainingWallDiagram from '../../components/calculators/RetainingWallDiagram.astro';
import PaverBaseDiagram from '../../components/calculators/PaverBaseDiagram.astro';
import RebarDiagram from '../../components/calculators/RebarDiagram.astro';
import DrywallDiagram from '../../components/calculators/DrywallDiagram.astro';
import AsphaltDiagram from '../../components/calculators/AsphaltDiagram.astro';
import FlooringDiagram from '../../components/calculators/FlooringDiagram.astro';
import ConcreteColumnDiagram from '../../components/calculators/ConcreteColumnDiagram.astro';
import TopsoilDiagram from '../../components/calculators/TopsoilDiagram.astro';
import AggregateDiagram from '../../components/calculators/AggregateDiagram.astro';
import ConcreteBlockDiagram from '../../components/calculators/ConcreteBlockDiagram.astro';
import ConcreteDrivewayDiagram from '../../components/calculators/ConcreteDrivewayDiagram.astro';
import ConcreteFootingDiagram from '../../components/calculators/ConcreteFootingDiagram.astro';
import PlywoodDiagram from '../../components/calculators/PlywoodDiagram.astro';
import StudDiagram from '../../components/calculators/StudDiagram.astro';
import RoofPitchDiagram from '../../components/calculators/RoofPitchDiagram.astro';
import RoofingDiagram from '../../components/calculators/RoofingDiagram.astro';
import RafterDiagram from '../../components/calculators/RafterDiagram.astro';
import MetalRoofingDiagram from '../../components/calculators/MetalRoofingDiagram.astro';
import LumberDiagram from '../../components/calculators/LumberDiagram.astro';
import StairDiagram from '../../components/calculators/StairDiagram.astro';
import SidingDiagram from '../../components/calculators/SidingDiagram.astro';
import BoardFootDiagram from '../../components/calculators/BoardFootDiagram.astro';
import ExcavationDiagram from '../../components/calculators/ExcavationDiagram.astro';
import SquareFootageDiagram from '../../components/calculators/SquareFootageDiagram.astro';
import FrenchDrainDiagram from '../../components/calculators/FrenchDrainDiagram.astro';
import ConcreteBagsDiagram from '../../components/calculators/ConcreteBagsDiagram.astro';
import InsulationDiagram from '../../components/calculators/InsulationDiagram.astro';
import MortarDiagram from '../../components/calculators/MortarDiagram.astro';
import GroutDiagram from '../../components/calculators/GroutDiagram.astro';
import PostHoleDiagram from '../../components/calculators/PostHoleDiagram.astro';
import ReferencesSection from '../../components/calculators/ReferencesSection.astro';
import MethodologyLink from '../../components/calculators/MethodologyLink.astro';
import type { GetStaticPaths } from 'astro';

// Diagram lookup — add new slugs here instead of adding more booleans
const diagramMap: Record<string, any> = {
  'concrete-slab-calculator':      SlabDiagram,
  'gravel-calculator':             GravelDiagram,
  'mulch-calculator':              MulchDiagram,
  'sand-calculator':               SandDiagram,
  'fence-post-calculator':         FencePostDiagram,
  'deck-footing-calculator':       DeckFootingDiagram,
  'retaining-wall-calculator':     RetainingWallDiagram,
  'paver-base-calculator':         PaverBaseDiagram,
  'rebar-calculator':              RebarDiagram,
  'drywall-calculator':            DrywallDiagram,
  'asphalt-calculator':            AsphaltDiagram,
  'flooring-calculator':           FlooringDiagram,
  'concrete-column-calculator':    ConcreteColumnDiagram,
  'topsoil-calculator':            TopsoilDiagram,
  'aggregate-calculator':          AggregateDiagram,
  'concrete-block-calculator':     ConcreteBlockDiagram,
  'concrete-driveway-calculator':  ConcreteDrivewayDiagram,
  'concrete-footing-calculator':   ConcreteFootingDiagram,
  'plywood-calculator':            PlywoodDiagram,
  'stud-calculator':               StudDiagram,
  'roof-pitch-calculator':         RoofPitchDiagram,
  'roofing-calculator':            RoofingDiagram,
  'rafter-calculator':             RafterDiagram,
  'metal-roofing-calculator':      MetalRoofingDiagram,
  'lumber-calculator':             LumberDiagram,
  'stair-calculator':              StairDiagram,
  'siding-calculator':             SidingDiagram,
  'board-foot-calculator':         BoardFootDiagram,
  'excavation-calculator':         ExcavationDiagram,
  'square-footage-calculator':     SquareFootageDiagram,
  'french-drain-calculator':       FrenchDrainDiagram,
  'concrete-bags-calculator':      ConcreteBagsDiagram,
  'insulation-calculator':         InsulationDiagram,
  'mortar-calculator':             MortarDiagram,
  'grout-calculator':              GroutDiagram,
  'post-hole-calculator':          PostHoleDiagram,
};

export const getStaticPaths: GetStaticPaths = async () => {
  return calculatorRegistry.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
};

const { calc } = Astro.props;

const category = getCategoryBySlug(calc.category);
const categoryName = category?.name ?? calc.category;

const meta = buildCalculatorMeta({
  title: calc.seo.title,
  description: calc.seo.description,
  slug: calc.slug,
  ogImage: calc.seo.ogImage,
});

const schemas = [
  buildWebAppSchema({
    name: calc.name,
    description: calc.seo.description,
    url: meta.canonical,
    appType: calc.schema.appType,
    features: calc.schema.features,
  }),
  buildBreadcrumbList([
    { name: 'Home', href: '/' },
    { name: `${categoryName} Calculators`, href: `/category/${calc.category}/` },
    { name: calc.name, href: `/calculators/${calc.slug}/` },
  ]),
  ...(calc.faq?.length ? [buildFaqSchema(calc.faq)] : []),
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: `${categoryName} Calculators`, href: `/category/${calc.category}/` },
  { name: calc.name, href: `/calculators/${calc.slug}/` },
];

const relatedCalcs = getRelatedCalculators(calc.relatedCalculators);
const Diagram = diagramMap[calc.slug];
const intro = calc.seo.intro ?? calc.seo.description;
---

<CalculatorLayout
  meta={meta}
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  h1={calc.seo.h1}
  intro={intro}
  categoryColor={category?.color}
  categoryIcon={category?.icon}
  lastUpdated={calc.lastUpdated}
>
  <CalculatorWidget slot="calculator" calc={calc} />

  <MethodologyLink slot="diagram" calcSlug={calc.slug} categorySlug={calc.category} />

  {Diagram && <Diagram slot="diagram" />}

  {calc.formulaSteps?.length && (
    <FormulaDisplay slot="explainer" steps={calc.formulaSteps} />
  )}

  {calc.faq?.length && (
    <FaqSection slot="faq" items={calc.faq} />
  )}

  {relatedCalcs.length > 0 && (
    <RelatedCalculators slot="related" calcs={relatedCalcs} />
  )}

  {calc.references?.length && (
    <ReferencesSection slot="references" references={calc.references} />
  )}
</CalculatorLayout>
