---
import CalculatorLayout from '../../layouts/CalculatorLayout.astro';
import { buildCalculatorMeta } from '../../utils/seo';
import { buildWebAppSchema, buildBreadcrumbList, buildFaqSchema } from '../../utils/schema';
import { calculatorRegistry, getRelatedCalculators } from '../../data/registry';
import { getCategoryBySlug } from '../../data/categories';
import CalculatorWidget from '../../components/calculators/CalculatorWidget.astro';
import FormulaDisplay from '../../components/calculators/FormulaDisplay.astro';
import FaqSection from '../../components/calculators/FaqSection.astro';
import SlabDiagram from '../../components/calculators/SlabDiagram.astro';
import GravelDiagram from '../../components/calculators/GravelDiagram.astro';
import MulchDiagram from '../../components/calculators/MulchDiagram.astro';
import SandDiagram from '../../components/calculators/SandDiagram.astro';
import FencePostDiagram from '../../components/calculators/FencePostDiagram.astro';
import DeckFootingDiagram from '../../components/calculators/DeckFootingDiagram.astro';
import RetainingWallDiagram from '../../components/calculators/RetainingWallDiagram.astro';
import PaverBaseDiagram from '../../components/calculators/PaverBaseDiagram.astro';
import RebarDiagram from '../../components/calculators/RebarDiagram.astro';
import DrywallDiagram from '../../components/calculators/DrywallDiagram.astro';
import AsphaltDiagram from '../../components/calculators/AsphaltDiagram.astro';
import FlooringDiagram from '../../components/calculators/FlooringDiagram.astro';
import ConcreteColumnDiagram from '../../components/calculators/ConcreteColumnDiagram.astro';
import TopsoilDiagram from '../../components/calculators/TopsoilDiagram.astro';
import AggregateDiagram from '../../components/calculators/AggregateDiagram.astro';
import Card from '../../components/ui/Card.astro';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  return calculatorRegistry.map((calc) => ({
    params: { slug: calc.slug },
    props: { calc },
  }));
};

const { calc } = Astro.props;

const category = getCategoryBySlug(calc.category);
const categoryName = category?.name ?? calc.category;

const meta = buildCalculatorMeta({
  title: calc.seo.title,
  description: calc.seo.description,
  slug: calc.slug,
  ogImage: calc.seo.ogImage,
});

const schemas = [
  buildWebAppSchema({
    name: calc.name,
    description: calc.seo.description,
    url: meta.canonical,
    appType: calc.schema.appType,
    features: calc.schema.features,
  }),
  buildBreadcrumbList([
    { name: 'Home', href: '/' },
    { name: `${categoryName} Calculators`, href: `/category/${calc.category}/` },
    { name: calc.name, href: `/calculators/${calc.slug}/` },
  ]),
  ...(calc.faq?.length ? [buildFaqSchema(calc.faq)] : []),
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: `${categoryName} Calculators`, href: `/category/${calc.category}/` },
  { name: calc.name, href: `/calculators/${calc.slug}/` },
];

const relatedCalcs = getRelatedCalculators(calc.relatedCalculators);
const isSlabCalc          = calc.slug === 'concrete-slab-calculator';
const isGravelCalc        = calc.slug === 'gravel-calculator';
const isMulchCalc         = calc.slug === 'mulch-calculator';
const isSandCalc          = calc.slug === 'sand-calculator';
const isFencePostCalc     = calc.slug === 'fence-post-calculator';
const isDeckFootingCalc   = calc.slug === 'deck-footing-calculator';
const isRetainingWallCalc = calc.slug === 'retaining-wall-calculator';
const isPaverBaseCalc     = calc.slug === 'paver-base-calculator';
const isRebarCalc         = calc.slug === 'rebar-calculator';
const isDrywallCalc       = calc.slug === 'drywall-calculator';
const isAsphaltCalc       = calc.slug === 'asphalt-calculator';
const isFlooringCalc      = calc.slug === 'flooring-calculator';
const isConcreteColumnCalc = calc.slug === 'concrete-column-calculator';
const isTopsoilCalc        = calc.slug === 'topsoil-calculator';
const isAggregateCalc      = calc.slug === 'aggregate-calculator';
---

<CalculatorLayout
  meta={meta}
  schemas={schemas}
  breadcrumbs={breadcrumbs}
  h1={calc.seo.h1}
  intro={calc.seo.description}
>
  <CalculatorWidget slot="calculator" calc={calc} />

  {isSlabCalc          && <SlabDiagram          slot="diagram" />}
  {isGravelCalc        && <GravelDiagram        slot="diagram" />}
  {isMulchCalc         && <MulchDiagram         slot="diagram" />}
  {isSandCalc          && <SandDiagram          slot="diagram" />}
  {isFencePostCalc     && <FencePostDiagram     slot="diagram" />}
  {isDeckFootingCalc   && <DeckFootingDiagram   slot="diagram" />}
  {isRetainingWallCalc && <RetainingWallDiagram slot="diagram" />}
  {isPaverBaseCalc     && <PaverBaseDiagram     slot="diagram" />}
  {isRebarCalc         && <RebarDiagram         slot="diagram" />}
  {isDrywallCalc       && <DrywallDiagram       slot="diagram" />}
  {isAsphaltCalc       && <AsphaltDiagram       slot="diagram" />}
  {isFlooringCalc      && <FlooringDiagram      slot="diagram" />}
  {isConcreteColumnCalc && <ConcreteColumnDiagram slot="diagram" />}
  {isTopsoilCalc        && <TopsoilDiagram        slot="diagram" />}
  {isAggregateCalc      && <AggregateDiagram      slot="diagram" />}

  {calc.formulaSteps?.length && (
    <FormulaDisplay slot="explainer" steps={calc.formulaSteps} />
  )}

  {calc.faq?.length && (
    <FaqSection slot="faq" items={calc.faq} />
  )}

  {relatedCalcs.length > 0 && (
    <div slot="related" class="mt-12">
      <h2 class="text-lg font-semibold text-[var(--color-text-primary)] mb-4">Related Calculators</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {relatedCalcs.map(related => (
          <Card href={`/calculators/${related.slug}/`} variant="bordered" padding="md">
            <div class="flex flex-col gap-2">
              <h3 class="font-semibold text-[var(--color-text-primary)] leading-snug">{related.name}</h3>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{related.description}</p>
              <span class="text-sm font-medium text-[var(--color-primary)] mt-1">Open →</span>
            </div>
          </Card>
        ))}
      </div>
    </div>
  )}
</CalculatorLayout>
