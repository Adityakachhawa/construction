---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { buildCalculatorsIndexMeta } from '../../utils/seo';
import { calculatorRegistry } from '../../data/registry';
import { categories } from '../../data/categories';
import Card from '../../components/ui/Card.astro';
import Badge from '../../components/ui/Badge.astro';

const meta = buildCalculatorsIndexMeta();

const grouped = calculatorRegistry.reduce<Record<string, typeof calculatorRegistry>>((acc, calc) => {
  if (!acc[calc.category]) acc[calc.category] = [];
  acc[calc.category].push(calc);
  return acc;
}, {});

// Respect category ordering defined in categories.ts
const orderedCategories = categories
  .filter((cat) => grouped[cat.slug])
  .map((cat) => ({ slug: cat.slug, name: cat.name, calcs: grouped[cat.slug] }));
---

<BaseLayout meta={meta}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <h1 class="text-2xl sm:text-3xl font-bold text-[var(--color-text-primary)]">All Construction Calculators</h1>
    <p class="mt-2 text-[var(--color-text-secondary)]">
      {calculatorRegistry.length > 0
        ? `${calculatorRegistry.length} free calculator${calculatorRegistry.length !== 1 ? 's' : ''} across ${orderedCategories.length} categories.`
        : 'Calculators coming soon.'}
    </p>

    {calculatorRegistry.length === 0 && (
      <div class="mt-12 text-center py-16 rounded-xl border border-dashed border-[var(--color-border)]">
        <p class="text-[var(--color-text-muted)]">Calculators are being built. Check back soon.</p>
      </div>
    )}

    {orderedCategories.map(({ slug, name, calcs }) => (
      <section class="mt-10">
        <div class="flex items-center justify-between mb-4">
          <h2 class="text-lg font-semibold text-[var(--color-text-primary)]">{name}</h2>
          <a href={`/category/${slug}/`} class="text-sm text-[var(--color-primary)] hover:underline">
            View all {name.toLowerCase()} →
          </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {calcs.map(calc => (
            <Card href={`/calculators/${calc.slug}/`} variant="bordered" padding="md">
              <div class="flex flex-col gap-2">
                <div class="flex items-start justify-between gap-2">
                  <h3 class="font-semibold text-[var(--color-text-primary)] leading-snug">{calc.name}</h3>
                  <Badge color="gray" size="sm">{calc.category}</Badge>
                </div>
                <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{calc.description}</p>
                <span class="text-sm font-medium text-[var(--color-primary)] mt-1">Open →</span>
              </div>
            </Card>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
