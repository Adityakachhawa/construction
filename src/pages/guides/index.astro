---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { buildPageTitle, buildCanonical } from '../../utils/seo';
import { buildBreadcrumbList } from '../../utils/schema';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';

const meta = {
  title: buildPageTitle('Construction Reference Guides & Material Estimators'),
  description:
    'In-depth construction guides, engineering reference tables, frost depth maps, and material calculation walkthroughs for builders and DIYers.',
  canonical: buildCanonical('/guides/'),
  ogType: 'website' as const,
};

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Guides', href: '/guides/' },
];

const schemas = [
  buildBreadcrumbList([
    { name: 'Home', href: '/' },
    { name: 'Guides', href: '/guides/' },
  ]),
];

// Fetch published calculation guides from blog collection
const projectGuides = await getCollection('blog', ({ data }) => !data.draft);
projectGuides.sort((a, b) => b.data.publishedAt.localeCompare(a.data.publishedAt));

// Reference guides hand-built with deep technical tables
const technicalReferences = [
  {
    title: 'Frost Depth Reference by State & Zone',
    description: 'Code-compliant footing depths and frost lines across all 50 US states to prevent foundation movement and frost heave.',
    href: '/guides/frost-depth/',
    tag: 'Building Code Spec',
    readTime: '8 min read',
    icon: 'M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07L19.07 4.93',
  },
  {
    title: 'Concrete Mix Comparison Guide (3000 vs 4000 vs 5000 PSI)',
    description: 'Compressive strength ratings, water-cement ratios, slump targets, and cure timelines for slabs, footings, and driveways.',
    href: '/guides/compare-concrete-mixes/',
    tag: 'Mix Design Spec',
    readTime: '10 min read',
    icon: 'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
  },
  {
    title: 'Engineering & Construction Math Methodology',
    description: 'Mathematical proofs, geometric derivations, density benchmarks, and ASTM standards underpinning our calculation engine.',
    href: '/methodology/',
    tag: 'Formula Derivations',
    readTime: '6 min read',
    icon: 'M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z',
  },
];
---

<BaseLayout meta={meta} schemas={schemas}>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
    <Breadcrumbs items={breadcrumbs} />

    <header class="mt-4 mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-(--color-primary-50) text-(--color-primary) border border-(--color-primary-100) mb-3">
        <span>Knowledge Base & Technical Manuals</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-(--color-text-primary) tracking-tight">
        Construction Guides & Reference Tables
      </h1>
      <p class="mt-3 text-lg text-(--color-text-secondary) max-w-3xl leading-relaxed">
        Authoritative calculation walkthroughs, code-compliant depth tables, and material estimation standards to ensure your projects are built right the first time.
      </p>
    </header>

    <!-- SECTION 1: Technical Standards & Reference Tables -->
    <section class="mb-14">
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-(--color-text-primary)">Technical Reference Manuals</h2>
          <p class="text-sm text-(--color-text-muted) mt-1">Deep-dive tables and structural code standards</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {technicalReferences.map((ref) => (
          <a
            href={ref.href}
            class="group flex flex-col justify-between p-6 rounded-2xl border border-(--color-border) bg-white hover:border-(--color-primary) hover:shadow-lg transition-all"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="inline-block px-2.5 py-1 text-xs font-semibold rounded-md bg-(--color-bg-secondary) text-(--color-text-primary)">
                  {ref.tag}
                </span>
                <span class="text-xs text-(--color-text-muted)">{ref.readTime}</span>
              </div>
              <h3 class="text-lg font-bold text-(--color-text-primary) group-hover:text-(--color-primary) transition-colors leading-snug">
                {ref.title}
              </h3>
              <p class="mt-2.5 text-sm text-(--color-text-secondary) leading-relaxed">
                {ref.description}
              </p>
            </div>
            <div class="mt-6 pt-4 border-t border-(--color-border-subtle) flex items-center text-sm font-semibold text-(--color-primary)">
              <span>Explore Reference</span>
              <svg class="ml-1.5 w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- SECTION 2: Project Planning & Estimation Walkthroughs -->
    <section class="mb-14">
      <div class="flex items-baseline justify-between mb-6">
        <div>
          <h2 class="text-xl sm:text-2xl font-bold text-(--color-text-primary)">Project Calculation Guides</h2>
          <p class="text-sm text-(--color-text-muted) mt-1">Step-by-step material estimation for every project stage</p>
        </div>
        <a href="/blog/" class="text-sm font-semibold text-(--color-primary) hover:underline hidden sm:inline-block">
          View all {projectGuides.length} articles →
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {projectGuides.slice(0, 12).map((post) => {
          const slug = post.id.replace(/\.[^.]+$/, '');
          return (
            <a
              href={`/blog/${slug}/`}
              class="group flex flex-col justify-between p-6 rounded-xl border border-(--color-border) bg-white hover:border-(--color-primary) hover:shadow-md transition-all"
            >
              <div>
                <div class="flex items-center gap-2 mb-2.5">
                  {post.data.tags?.[0] && (
                    <span class="text-xs font-semibold uppercase tracking-wider text-(--color-primary)">
                      {post.data.tags[0]}
                    </span>
                  )}
                  <span class="text-xs text-(--color-text-muted)">• {post.data.publishedAt}</span>
                </div>
                <h3 class="font-semibold text-(--color-text-primary) leading-snug group-hover:text-(--color-primary) transition-colors line-clamp-2">
                  {post.data.title}
                </h3>
                <p class="mt-2 text-sm text-(--color-text-secondary) leading-relaxed line-clamp-3">
                  {post.data.description}
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-(--color-border-subtle) flex items-center justify-between text-xs font-medium text-(--color-primary)">
                <span>Read Guide</span>
                <span>→</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <!-- SECTION 3: Calculator Categories Directory -->
    <section class="p-8 rounded-2xl bg-(--color-bg-secondary) border border-(--color-border)">
      <h2 class="text-lg font-bold text-(--color-text-primary) mb-2">Need a Specific Construction Calculator?</h2>
      <p class="text-sm text-(--color-text-secondary) mb-5">
        Jump directly to our specialized material estimation tools:
      </p>
      <div class="flex flex-wrap gap-2.5">
        {categories.map((cat) => (
          <a
            href={`/category/${cat.slug}/`}
            class="px-4 py-2 text-sm font-medium rounded-lg bg-white border border-(--color-border) text-(--color-text-primary) hover:border-(--color-primary) hover:text-(--color-primary) transition-all"
          >
            {cat.name} Calculators
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
