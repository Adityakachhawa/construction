---
import MetaTags from '../components/seo/MetaTags.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { MetaProps } from '../utils/seo';
import '../styles/global.css';

interface Props {
  meta: MetaProps;
  schemas?: Record<string, unknown>[];
  currentPath?: string;
  heroPage?: boolean;
}

const { meta, schemas = [], currentPath = Astro.url.pathname, heroPage = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <MetaTags {...meta} />
    {schemas.length > 0 && <SchemaOrg schema={schemas} />}
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header currentPath={currentPath} heroPage={heroPage} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <style>
      .skip-link {
        position: absolute;
        left: 0.5rem;
        top: -3rem;
        z-index: 200;
        padding: 0.625rem 1rem;
        background: var(--color-primary);
        color: #fff;
        font-size: 0.875rem;
        font-weight: 600;
        border-radius: 8px;
        transition: top 150ms ease;
      }
      .skip-link:focus {
        top: 0.5rem;
        outline: 2px solid #fff;
        outline-offset: 2px;
      }
    </style>
  </body>
</html>
