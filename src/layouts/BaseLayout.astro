---
import MetaTags from '../components/seo/MetaTags.astro';
import SchemaOrg from '../components/seo/SchemaOrg.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import type { MetaProps } from '../utils/seo';
import '../styles/global.css';

interface Props {
  meta: MetaProps;
  schemas?: Record<string, unknown>[];
  currentPath?: string;
}

const { meta, schemas = [], currentPath = Astro.url.pathname } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <MetaTags {...meta} />
    {schemas.length > 0 && <SchemaOrg schema={schemas} />}
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
