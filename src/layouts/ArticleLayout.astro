---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import type { MetaProps } from '../utils/seo';
import type { BreadcrumbItem } from '../utils/schema';

interface Props {
  meta: MetaProps;
  schemas?: Record<string, unknown>[];
  breadcrumbs: BreadcrumbItem[];
  variant?: 'blog' | 'guide';
  title: string;
  description: string;
  publishedAt?: string;
  updatedAt?: string;
  author?: string;
  readingTime?: number;
  featuredImage?: string;
  tags?: string[];
  categoryLinks?: Array<{ name: string; slug: string }>;
  prevPost?: { title: string; slug: string };
  nextPost?: { title: string; slug: string };
}

const {
  meta,
  schemas = [],
  breadcrumbs,
  variant = 'blog',
  title,
  description,
  publishedAt,
  updatedAt,
  author = 'ConstructCalc Team',
  readingTime,
  featuredImage,
  tags = [],
  categoryLinks = [],
  prevPost,
  nextPost,
} = Astro.props;

const displayDate = updatedAt ?? publishedAt;
---

<BaseLayout meta={meta} schemas={schemas}>
  <!-- Reading progress bar -->
  <div id="progress-bar" class="progress-bar" aria-hidden="true"></div>

  <div class={variant === 'guide'
    ? 'max-w-6xl mx-auto px-4 sm:px-6 py-6 lg:grid lg:grid-cols-[1fr_260px] lg:gap-10'
    : 'article-page-wrap'}>

    <article class="min-w-0" id="article-body">
      <div class={variant === 'blog' ? 'article-narrow' : ''}>
        <Breadcrumbs items={breadcrumbs} />

        <!-- Article header -->
        <header class="article-header">
          {tags.length > 0 && (
            <div class="article-tags">
              {tags.slice(0, 3).map(tag => (
                <a href={`/blog/tag/${tag}/`} class="article-tag">{tag}</a>
              ))}
            </div>
          )}

          <h1 class="article-h1">{title}</h1>

          <p class="article-desc">{description}</p>

          <div class="article-meta">
            <span class="article-author">{author}</span>
            {displayDate && (
              <time datetime={displayDate} class="article-date">
                {updatedAt && <span class="article-date-label">Updated </span>}
                {new Date(displayDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
              </time>
            )}
            {readingTime && <span class="article-read">{readingTime} min read</span>}
          </div>
        </header>

        {featuredImage && (
          <div class="article-hero">
            <img src={featuredImage} alt={title} width="900" height="473" loading="eager" />
          </div>
        )}

        <!-- Auto ToC (populated by script) -->
        <div id="article-toc" class="article-toc" style="display:none" aria-label="Table of contents">
          <button id="toc-toggle" class="toc-toggle" type="button" aria-expanded="true">
            <span class="toc-toggle-label">Contents</span>
            <svg class="toc-chevron" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 6l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <nav id="toc-nav" class="toc-nav"></nav>
        </div>

        <!-- Guide ToC on mobile -->
        {variant === 'guide' && (
          <div class="lg:hidden mb-8">
            <slot name="toc" />
          </div>
        )}

        <!-- Article body -->
        <div class="article-prose">
          <slot />
        </div>

        <!-- Related calculators -->
        <slot name="related" />

        <!-- Category cross-links -->
        {categoryLinks.length > 0 && (
          <div class="article-category-links">
            <p class="category-links-label">Browse more</p>
            <div class="category-links-row">
              {categoryLinks.map(cat => (
                <a href={`/category/${cat.slug}/`} class="category-link-chip">
                  {cat.name} Calculators →
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Social share -->
        <div class="article-share">
          <span class="share-label">Share</span>
          <a
            id="share-twitter"
            href="#"
            class="share-btn share-btn--twitter"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Share on X (Twitter)"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.263 5.633 5.901-5.633zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          <button
            id="share-copy"
            class="share-btn share-btn--copy"
            type="button"
            aria-label="Copy link"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2"/>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
            </svg>
            <span id="copy-label">Copy link</span>
          </button>
        </div>

        <!-- Author card -->
        <div class="author-card">
          <div class="author-avatar" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
          </div>
          <div class="author-info">
            <p class="author-name">{author}</p>
            <p class="author-bio">Construction estimator and technical writer at ConstructCalc. Focused on material calculations for residential and light commercial projects.</p>
          </div>
        </div>

        <!-- Back to blog -->
        <div class="back-to-blog">
          <a href="/blog/" class="back-link">← All articles</a>
        </div>

        <!-- Prev / Next navigation -->
        {(prevPost || nextPost) && (
          <nav class="article-nav" aria-label="Article navigation">
            <div class="article-nav-grid">
              {prevPost ? (
                <a href={`/blog/${prevPost.slug}/`} class="article-nav-card article-nav-card--prev">
                  <span class="article-nav-dir">← Previous</span>
                  <span class="article-nav-title">{prevPost.title}</span>
                </a>
              ) : <div />}
              {nextPost && (
                <a href={`/blog/${nextPost.slug}/`} class="article-nav-card article-nav-card--next">
                  <span class="article-nav-dir">Next →</span>
                  <span class="article-nav-title">{nextPost.title}</span>
                </a>
              )}
            </div>
          </nav>
        )}
      </div>
    </article>

    <!-- Guide sidebar ToC (desktop) -->
    {variant === 'guide' && (
      <aside class="hidden lg:block">
        <div class="sticky top-20">
          <slot name="toc" />
        </div>
      </aside>
    )}

  </div>
</BaseLayout>

<style>
  /* Reading progress bar */
  .progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 3px;
    width: 0%;
    background: var(--color-primary);
    z-index: 200;
    transition: width 100ms linear;
    pointer-events: none;
  }

  /* Page wrapper */
  .article-page-wrap {
    max-width: 72rem;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 0;
  }

  /* Narrow reading column for blog variant */
  .article-narrow {
    max-width: 44rem;
    margin: 0 auto;
  }

  /* Header */
  .article-header {
    margin-top: 1rem;
    margin-bottom: 2rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.875rem;
  }

  .article-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary);
    background: var(--color-primary-50);
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    transition: background 150ms;
  }
  .article-tag:hover { background: var(--color-primary-100); }

  .article-h1 {
    font-size: clamp(1.625rem, 3.5vw, 2.25rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    line-height: 1.15;
  }

  .article-desc {
    margin-top: 0.75rem;
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
    margin-top: 1rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .article-author { font-weight: 500; }

  .article-date { }

  .article-date-label {
    font-weight: 700;
    color: var(--color-primary);
  }

  .article-read::before {
    content: '·';
    margin-right: 0.5rem;
    color: var(--border-default);
  }

  /* Hero image */
  .article-hero {
    margin-bottom: 2rem;
    border-radius: 14px;
    overflow: hidden;
  }
  .article-hero img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ToC */
  .article-toc {
    margin-bottom: 2rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    overflow: hidden;
  }

  .toc-toggle {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.875rem 1.25rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.01em;
  }

  .toc-chevron {
    color: var(--color-text-muted);
    transition: transform 200ms;
    flex-shrink: 0;
  }
  .toc-toggle[aria-expanded="false"] .toc-chevron { transform: rotate(-90deg); }

  .toc-nav {
    padding: 0 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .toc-nav[hidden] { display: none; }

  /* Prose */
  .article-prose {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-top: 0.5rem;
  }

  .article-prose :global(h2) {
    font-size: 1.375rem;
    font-weight: 800;
    color: var(--color-text-primary);
    letter-spacing: -0.03em;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    scroll-margin-top: 80px;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .article-prose :global(h3) {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
    margin-top: 2rem;
    margin-bottom: 0.875rem;
    line-height: 1.35;
    scroll-margin-top: 80px;
  }

  .article-prose :global(h4) {
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-top: 1.5rem;
    margin-bottom: 0.625rem;
    scroll-margin-top: 80px;
  }

  .article-prose :global(p) {
    margin-bottom: 1.375rem;
  }

  /* First paragraph after a heading — slightly tighter top margin */
  .article-prose :global(h2 + p),
  .article-prose :global(h3 + p),
  .article-prose :global(h4 + p) {
    margin-top: 0;
  }

  .article-prose :global(ul),
  .article-prose :global(ol) {
    padding-left: 1.625rem;
    margin-bottom: 1.375rem;
    margin-top: 0.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .article-prose :global(li) {
    color: var(--color-text-secondary);
    line-height: 1.7;
  }

  /* Nested lists */
  .article-prose :global(li > ul),
  .article-prose :global(li > ol) {
    margin-top: 0.375rem;
    margin-bottom: 0;
  }

  .article-prose :global(a) {
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 1px solid var(--color-primary-200, #bfdbfe);
    transition: border-color 150ms;
  }
  .article-prose :global(a:hover) {
    border-color: var(--color-primary);
  }

  .article-prose :global(strong) {
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .article-prose :global(code) {
    font-size: 0.875em;
    background: var(--surface-page);
    border: 1px solid var(--border-default);
    padding: 0.15em 0.4em;
    border-radius: 5px;
    font-family: ui-monospace, monospace;
  }

  /* Callout boxes via blockquote */
  .article-prose :global(blockquote) {
    position: relative;
    margin: 1.75rem 0;
    padding: 1rem 1.25rem 1rem 1.375rem;
    border-left: 3px solid var(--color-primary);
    background: var(--color-primary-50);
    border-radius: 0 10px 10px 0;
  }

  .article-prose :global(blockquote p) {
    margin-bottom: 0;
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
  }

  .article-prose :global(blockquote p:not(:last-child)) {
    margin-bottom: 0.625rem;
  }

  /* Warning blockquote — use > ⚠️ prefix as signal */
  .article-prose :global(blockquote:has(p > strong:first-child)) {
    border-left-color: #d97706;
    background: #fffbeb;
  }

  /* hr */
  .article-prose :global(hr) {
    border: none;
    border-top: 1px solid var(--border-default);
    margin: 2.5rem 0;
  }

  /* Table styling */
  .article-prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
    overflow-x: auto;
    display: block;
  }

  .article-prose :global(thead) {
    background: var(--surface-page);
  }

  .article-prose :global(th) {
    padding: 0.625rem 0.875rem;
    text-align: left;
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--color-text-primary);
    letter-spacing: 0.02em;
    border: 1px solid var(--border-default);
    white-space: nowrap;
  }

  .article-prose :global(td) {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--border-default);
    color: var(--color-text-secondary);
    vertical-align: top;
  }

  .article-prose :global(tbody tr:nth-child(even)) {
    background: var(--surface-page);
  }

  /* Category cross-links */
  .article-category-links {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-default);
  }

  .category-links-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: 0.75rem;
  }

  .category-links-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .category-link-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    transition: border-color 150ms, color 150ms, background 150ms;
  }
  .category-link-chip:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
    background: var(--color-primary-50);
  }

  /* Social share */
  .article-share {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-default);
  }

  .share-label {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-right: 0.25rem;
  }

  .share-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4375rem 0.875rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    border: 1px solid var(--border-default);
    background: var(--surface-card);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: border-color 150ms, color 150ms, background 150ms;
  }
  .share-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .share-btn--copy { }
  .share-btn--copy.is-copied {
    border-color: #15803d;
    color: #15803d;
    background: #f0fdf4;
  }

  /* Author card */
  .author-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 2rem;
    padding: 1.25rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 14px;
  }

  .author-avatar {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-primary-50);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-name {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: 0.25rem;
  }

  .author-bio {
    font-size: 0.875rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Back to blog */
  .back-to-blog {
    margin-top: 1.5rem;
  }

  .back-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-text-muted);
    transition: color 150ms;
  }
  .back-link:hover { color: var(--color-primary); }

  /* Prev/Next nav */
  .article-nav {
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-default);
    margin-bottom: 4rem;
  }

  .article-nav-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .article-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    background: var(--surface-card);
    border: 1px solid var(--border-default);
    border-radius: 12px;
    transition: border-color 150ms, box-shadow 150ms;
  }
  .article-nav-card:hover {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-50);
  }

  .article-nav-card--next {
    text-align: right;
  }

  .article-nav-dir {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .article-nav-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--color-text-primary);
    line-height: 1.35;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  // Reading progress bar
  const progressBar = document.getElementById('progress-bar');
  if (progressBar) {
    const update = () => {
      const body = document.documentElement;
      const scrollTop = body.scrollTop || document.body.scrollTop;
      const scrollHeight = body.scrollHeight - body.clientHeight;
      const pct = scrollHeight > 0 ? (scrollTop / scrollHeight) * 100 : 0;
      progressBar.style.width = pct + '%';
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }

  // Auto ToC
  const article = document.getElementById('article-body');
  const tocContainer = document.getElementById('article-toc');
  const tocNav = document.getElementById('toc-nav');
  const tocToggle = document.getElementById('toc-toggle');

  if (article && tocContainer && tocNav) {
    const headings = Array.from(article.querySelectorAll<HTMLElement>('h2, h3'));

    if (headings.length >= 3) {
      headings.forEach((h, i) => {
        if (!h.id) h.id = `heading-${i}`;
        const link = document.createElement('a');
        link.href = `#${h.id}`;
        link.textContent = h.textContent ?? '';
        link.className = h.tagName === 'H3' ? 'toc-link toc-link--sub' : 'toc-link';
        link.style.cssText = h.tagName === 'H3'
          ? 'display:block;padding:0.25rem 0 0.25rem 1rem;font-size:0.8125rem;color:var(--color-text-secondary);text-decoration:none;border-left:2px solid var(--border-default);transition:color 150ms,border-color 150ms;'
          : 'display:block;padding:0.3rem 0;font-size:0.875rem;font-weight:600;color:var(--color-text-secondary);text-decoration:none;transition:color 150ms;';

        link.addEventListener('mouseenter', () => { link.style.color = 'var(--color-primary)'; });
        link.addEventListener('mouseleave', () => { link.style.color = ''; });
        tocNav.appendChild(link);
      });
      tocContainer.style.display = 'block';
    }
  }

  // ToC toggle
  if (tocToggle && tocNav) {
    tocToggle.addEventListener('click', () => {
      const expanded = tocToggle.getAttribute('aria-expanded') === 'true';
      tocToggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      if (expanded) tocNav.setAttribute('hidden', '');
      else tocNav.removeAttribute('hidden');
    });
  }

  // Social share — Twitter
  const twitterBtn = document.getElementById('share-twitter') as HTMLAnchorElement | null;
  if (twitterBtn) {
    const text = encodeURIComponent(document.title);
    const url = encodeURIComponent(window.location.href);
    twitterBtn.href = `https://twitter.com/intent/tweet?text=${text}&url=${url}`;
  }

  // Social share — copy link
  const copyBtn = document.getElementById('share-copy');
  const copyLabel = document.getElementById('copy-label');
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyLabel.textContent = 'Copied!';
        copyBtn.classList.add('is-copied');
        setTimeout(() => {
          copyLabel.textContent = 'Copy link';
          copyBtn.classList.remove('is-copied');
        }, 2000);
      } catch {
        copyLabel.textContent = 'Copy link';
      }
    });
  }
</script>
