---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import CategoryIcon from '../components/ui/CategoryIcon.astro';
import type { MetaProps } from '../utils/seo';
import type { BreadcrumbItem } from '../utils/schema';

interface Props {
  meta: MetaProps;
  schemas?: Record<string, unknown>[];
  breadcrumbs: BreadcrumbItem[];
  name: string;
  description: string;
  calculatorCount: number;
  categoryColor?: string;
  categoryIcon?: string;
}

const { meta, schemas = [], breadcrumbs, name, description, calculatorCount, categoryColor = '#ea580c', categoryIcon = 'concrete' } = Astro.props;
---

<BaseLayout meta={meta} schemas={schemas}>
  <!-- Page header -->
  <div class="page-header">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="header-body">
        <div class="header-icon" style={`--accent: ${categoryColor}`}>
          <CategoryIcon name={categoryIcon} size={28} />
        </div>
        <div>
          <h1 class="page-title">{name} Calculators</h1>
          <p class="page-sub">{description}</p>
          <p class="page-count">
            {calculatorCount} calculator{calculatorCount !== 1 ? 's' : ''} available
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="content">
    <div class="container">
      <slot name="featured" />

      <section class="calc-section">
        <slot name="grid" />
      </section>

      <slot name="guides" />
      <slot name="faq" />
      <slot name="content" />
    </div>
  </div>
</BaseLayout>

<style>
  .page-header {
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-default);
    padding: 2rem 0 2.5rem;
  }

  .container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .header-body {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .header-icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent, #ea580c) 12%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent, var(--color-primary));
    flex-shrink: 0;
    margin-top: 4px;
  }

  .page-title {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .page-sub {
    margin-top: 0.5rem;
    font-size: 1rem;
    color: var(--color-text-secondary);
    max-width: 44rem;
    line-height: 1.6;
  }

  .page-count {
    margin-top: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .content {
    padding: 3rem 0 5rem;
  }

  .calc-section {
    margin-top: 0.5rem;
  }
</style>
