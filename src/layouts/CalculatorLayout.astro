---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import type { MetaProps } from '../utils/seo';
import type { BreadcrumbItem } from '../utils/schema';

interface Props {
  meta: MetaProps;
  schemas?: Record<string, unknown>[];
  breadcrumbs: BreadcrumbItem[];
  h1: string;
  intro?: string;
}

const { meta, schemas = [], breadcrumbs, h1, intro } = Astro.props;
---

<BaseLayout meta={meta} schemas={schemas}>
  <!-- Zone 1: Page header band -->
  <div class="calc-page-header">
    <div class="calc-container">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="calc-h1">{h1}</h1>
      {intro && <p class="calc-intro">{intro}</p>}
    </div>
  </div>

  <!-- Zone 2: Calculator body — 40/60 two-column sticky layout -->
  <div class="calc-body">
    <div class="calc-container calc-body-grid">
      <!-- Left: inputs -->
      <div class="calc-inputs-col">
        <slot name="calculator" />
      </div>
      <!-- Right: results (sticky) — injected inside CalculatorWidget via slot="results" -->
      <!-- results panel is rendered inside the widget, which occupies the inputs col -->
      <!-- the widget itself outputs both columns via its own inner grid -->
    </div>
  </div>

  <!-- Zone 3: Supporting content — narrow reading column -->
  <div class="calc-support">
    <div class="calc-container-narrow">
      <slot name="diagram" />
      <slot name="explainer" />
      <slot name="faq" />
    </div>
    <!-- Related breaks back to full width -->
    <div class="calc-container">
      <slot name="related" />
    </div>
    <div class="calc-container-narrow">
      <slot name="content" />
    </div>
  </div>
</BaseLayout>

<style>
  .calc-page-header {
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-default);
    padding: 2rem 0 2.5rem;
  }

  .calc-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .calc-container-narrow {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .calc-h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    margin-top: 1rem;
    line-height: 1.1;
  }

  .calc-intro {
    margin-top: 0.625rem;
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 44rem;
    line-height: 1.6;
  }

  .calc-body {
    background: var(--surface-page);
    padding: 2.5rem 0 3rem;
  }

  /* The calculator widget fills the full container width —
     it handles its own 40/60 internal grid */
  .calc-body-grid {
    width: 100%;
  }

  .calc-support {
    padding: 1rem 0 4rem;
    background: var(--surface-page);
  }
</style>
