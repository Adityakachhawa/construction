---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import CategoryIcon from '../components/ui/CategoryIcon.astro';
import type { MetaProps } from '../utils/seo';
import type { BreadcrumbItem } from '../utils/schema';

interface Props {
  meta: MetaProps;
  schemas?: Record<string, unknown>[];
  breadcrumbs: BreadcrumbItem[];
  h1: string;
  intro?: string;
  categoryColor?: string;
  categoryIcon?: string;
  lastUpdated?: string;
}

const { meta, schemas = [], breadcrumbs, h1, intro, categoryColor = '#ea580c', categoryIcon, lastUpdated } = Astro.props;

const updatedLabel = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
  : null;
---

<BaseLayout meta={meta} schemas={schemas}>
  <!-- Page header -->
  <div class="calc-page-header">
    <div class="calc-container">
      <Breadcrumbs items={breadcrumbs} />
      <div class="header-body">
        {categoryIcon && (
          <div class="header-icon" style={`--accent: ${categoryColor}`}>
            <CategoryIcon name={categoryIcon} size={24} />
          </div>
        )}
        <div class="header-text">
          <div class="header-chips">
            <span class="chip-free">Free</span>
            <span class="chip-units">Imperial &amp; Metric</span>
            {updatedLabel && <span class="chip-updated">Updated {updatedLabel}</span>}
          </div>
          <h1 class="calc-h1">{h1}</h1>
          {intro && <p class="calc-intro">{intro}</p>}
        </div>
      </div>
    </div>
  </div>

  <!-- Calculator body -->
  <div class="calc-body">
    <div class="calc-container calc-body-grid">
      <div class="calc-inputs-col">
        <slot name="calculator" />
      </div>
    </div>
  </div>

  <!-- Supporting content -->
  <div class="calc-support">
    <div class="calc-container-narrow">
      <slot name="diagram" />
      <slot name="explainer" />
      <slot name="faq" />
    </div>
    <div class="calc-container">
      <slot name="related" />
    </div>
    <div class="calc-container-narrow">
      <slot name="content" />
    </div>
  </div>
</BaseLayout>

<style>
  .calc-page-header {
    background: var(--surface-page);
    border-bottom: 1px solid var(--border-default);
    padding: 2rem 0 2.5rem;
  }

  .calc-container {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .calc-container-narrow {
    max-width: 52rem;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .header-body {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .header-icon {
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--accent, #ea580c) 12%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--accent, var(--color-primary));
    margin-top: 4px;
  }

  .header-text { flex: 1; min-width: 0; }

  .header-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-bottom: 0.625rem;
  }

  .chip-free, .chip-units, .chip-updated {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.01em;
  }

  .chip-free {
    background: #dcfce7;
    color: #15803d;
  }

  .chip-units {
    background: var(--color-primary-50);
    color: var(--color-primary);
  }

  .chip-updated {
    background: var(--border-subtle);
    color: var(--color-text-muted);
  }

  .calc-h1 {
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 900;
    color: var(--color-text-primary);
    letter-spacing: -0.04em;
    line-height: 1.1;
  }

  .calc-intro {
    margin-top: 0.625rem;
    font-size: 1.0625rem;
    color: var(--color-text-secondary);
    max-width: 44rem;
    line-height: 1.6;
  }

  .calc-body {
    background: var(--surface-page);
    padding: 2.5rem 0 3rem;
  }

  .calc-body-grid { width: 100%; }

  .calc-support {
    padding: 1rem 0 4rem;
    background: var(--surface-page);
  }
</style>

